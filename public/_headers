/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# On-demand MiSans weights fetched by the mobile client. Immutable + the
# client's own versioned cache keep these ~7.5 MB faces off the wire on
# repeat launches. /fonts/gstatic/* is the google_fonts mirror (a Pages
# Function, content-addressed, so equally immutable).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

# Markdown legal docs fetched and cached by the mobile client (versioned by
# lastUpdated). Short max-age + Pages' automatic ETag let the client revalidate
# cheaply while still opening instantly from its local cache.
/legal/*.md
  Cache-Control: public, max-age=300

/hot-update/*
  Cache-Control: no-cache

# Scale library fetched and cached by the mobile client. The manifest is the
# only mutable part, so it revalidates on every check (same reasoning as
# /hot-update/*). The data files are checksum-pinned by that manifest - a client
# only re-downloads one when its sha256 changed - so a short max-age is safe
# and saves a round trip for the ~270 KB MMPI-2 files on a fresh install.
/scales/manifest.json
  Cache-Control: no-cache

/scales/data/*
  Cache-Control: public, max-age=300

# Apple fetches the AASA through its own CDN and requires JSON; Pages would
# otherwise guess application/octet-stream from the missing extension.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Cache-Control: public, max-age=3600
