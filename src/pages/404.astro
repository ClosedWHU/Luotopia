---
/*
 * Astro emits this as `dist/404.html`, and its mere existence is load-bearing.
 *
 * Pages chooses between "custom 404" and "single-page application" purely on
 * whether the build output contains a top-level `404.html`: with one, a miss is
 * answered by that file at status 404; without one, Pages assumes an SPA and
 * rewrites *every* unmatched path to `/` at 200. This site had no `404.html`,
 * which is why `/typo` — and even `/missing.png` — used to come back as the
 * homepage. There is no dashboard toggle for it and no `wrangler.jsonc` key
 * either: `assets.not_found_handling` belongs to Workers static assets, a
 * different product from Pages. Shipping this file *is* the configuration.
 *
 * `functions/_middleware.ts` is left with only the part the platform cannot do
 * — handing a one-line `text/plain` 404 to clients that never asked for a
 * document, so `curl` does not print 34 KB of markup into a terminal.
 *
 * Consequence of being a built file: `Astro.response.status` below is what makes
 * `astro dev` honest, but `Astro.url.pathname` here is always `/404.html`. The
 * offending path can only come from `location` at runtime — hence the
 * placeholder the script fills in.
 *
 * The body lives in `components/pages/NotFoundPage.astro` and is shared with
 * every `src/pages/[lang]/404.astro`; see the same note in `index.astro`. This
 * file's job is the unprefixed route and nothing else, which is why it keeps the
 * status line and drops everything else: it must go on emitting `dist/404.html`,
 * so it cannot be renamed, moved into `[lang]/`, or given a `getStaticPaths`.
 */
import NotFoundPage from "../components/pages/NotFoundPage.astro";

Astro.response.status = 404;
---

<NotFoundPage />
