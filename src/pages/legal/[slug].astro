---
/*
 * The default locale's legal documents.
 *
 * `dist/legal/<slug>/index.html` and `dist/legal/<slug>.md` are both consumed by
 * the Flutter app (`app_config.dart`'s `termsOfServiceUrl` / `legalDocumentMdUrl`),
 * so these unprefixed paths are a wire contract, not just a URL. They must keep
 * working and keep serving the authoritative Simplified Chinese text.
 */
import LegalDocumentPage from "../../components/pages/LegalDocumentPage.astro";
import { legalDocuments } from "../../config/legal";

export function getStaticPaths() {
  return legalDocuments.map((doc) => ({ params: { slug: doc.slug } }));
}
---

<LegalDocumentPage slug={Astro.params.slug!} />