---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppIcon from "../components/AppIcon.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import ScreenshotCarousel from "../components/ScreenshotCarousel.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import { highlightedFeatures } from "../config/features";

/**
 * Rotating hero adjectives. All two characters on purpose: the rotator is a
 * grid stack sized to its widest child, so equal-length words mean the
 * "· 珞家" tail never shifts as the word changes. Add a longer word and the
 * whole line re-centres on every cycle.
 */
const HERO_WORDS = ["智慧", "开放", "共享", "高效", "便捷"];
---

<BaseLayout title="首页">
  <section class="relative overflow-hidden pt-[120px] pb-24 px-4">
    <div class="lt-hero-wash" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto flex flex-col items-center text-center">

      <div class="lt-hero-rise" style="--lt-reveal-delay: 60ms">
        <AppIcon class="w-[120px] h-[120px]" size={120} plate />
      </div>

      <h1 class="lt-hero-fade lt-hero-title mt-6 text-display-small sm:text-display-medium lg:text-display-large text-on-surface tracking-tight" style="--lt-reveal-delay: 120ms">
        <span class="sr-only">Luotopia </span>
        <span class="lt-rotator" data-lt-rotator>
          {
            HERO_WORDS.map((word, i) => (
              <span class="lt-word" data-active={i === 0 ? "true" : undefined} aria-hidden={i === 0 ? undefined : "true"}>
                {word}
              </span>
            ))
          }
        </span>
        <span class="lt-sep" aria-hidden="true">·</span>
        <span class="lt-hero-accent">珞家</span>
      </h1>

      <p class="lt-hero-fade mt-6 text-title-large sm:text-headline-small font-normal text-on-surface-variant max-w-2xl" style="--lt-reveal-delay: 180ms">
        整合校园服务，构建开放生态。<br class="hidden sm:block" />武汉大学一站式数字校园平台。
      </p>

      <div class="lt-hero-rise w-full max-w-2xl mt-12" style="--lt-reveal-delay: 240ms">
        <DownloadButtons variant="hero" />
        <p class="mt-5 text-body-small text-outline">支持 Android / iOS / macOS / Windows / Linux；HarmonyOS 随部分版本发布</p>
      </div>

      <a href="#features" class="lt-scroll-hint" aria-label="向下滚动" style="--lt-reveal-delay: 420ms">
        <Icon name="keyboard_arrow_down" />
      </a>
    </div>
  </section>

  <section id="features" class="relative py-24 px-4 scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      <h2 class="lt-reveal text-headline-small text-center text-on-surface mb-3">核心功能</h2>
      <p class="lt-reveal text-body-large text-center text-on-surface-variant max-w-xl mx-auto mb-12" style="--lt-reveal-delay: 60ms">
        课表、日程、预约、E 卡、校车、地图、论坛与 AI —— 校园生活所需，尽在一处。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          highlightedFeatures.map((feature, i) => (
            <div class="lt-reveal-lift h-full" style={`--lt-reveal-delay: ${(i % 4) * 70}ms`}>
              <FeatureCard
                icon={feature.icon}
                title={feature.title}
                description={feature.summary}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="lt-reveal text-headline-small text-center text-on-surface mb-3">应用预览</h2>
      <p class="lt-reveal text-body-large text-center text-on-surface-variant max-w-xl mx-auto mb-10" style="--lt-reveal-delay: 60ms">
        真实界面，非渲染图。
      </p>
      <div class="lt-reveal-lift">
        <ScreenshotCarousel />
      </div>
    </div>
  </section>

  <section class="relative py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="lt-reveal-lift glass rounded-group px-6 py-14 sm:px-12 text-center">
        <h2 class="text-headline-small sm:text-headline-medium text-on-surface mb-4">立即体验</h2>
        <p class="text-body-large text-on-surface-variant mb-9 max-w-md mx-auto">免费、开放、纯净，让校园生活更简单。</p>
        <DownloadButtons variant="hero" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* A local wash over the page-wide aurora, so the hero carries more chroma
   * than the body copy below it — the same top-down gradient DeepSeek's hero
   * section layers over its shader, built from our own primary/tertiary tones.
   *
   * Centers are positive viewport fractions on purpose: the hero box is ~1100px
   * tall, so `at 50% -6%` parks the bloom above the fold and the wash reads as
   * nothing at all. */
  .lt-hero-wash {
    position: absolute;
    /* Four sides, not the `inset` shorthand (Chrome 87+): legacy-WebView floor. */
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background:
      radial-gradient(48rem 27rem at 50% 13%, var(--lt-hero-wash-from), var(--lt-hero-wash-to) 74%),
      radial-gradient(34rem 22rem at 12% 34%, hsl(196 62% 76% / 0.42), transparent 70%),
      radial-gradient(34rem 22rem at 88% 26%, hsl(224 56% 80% / 0.42), transparent 70%);
    mask-image: linear-gradient(#000 0%, rgba(0, 0, 0, 0.92) 9%, transparent 100%);
    -webkit-mask-image: linear-gradient(#000 0%, rgba(0, 0, 0, 0.92) 9%, transparent 100%);
  }

  /*
   * Above-the-fold entrance, on CSS animations rather than the observer-driven
   * `.lt-reveal*` system the rest of the page uses.
   *
   * The split is forced by a timing mismatch, not taste. `.lt-reveal` starts at
   * opacity 0, but `.lt-reveal-lift` *cannot* — opacity < 1 turns an element
   * into a backdrop root and kills the glass inside it — so lift elements paint
   * fully visible at first frame, merely offset 28px. The observer that flips
   * `data-revealed` only runs once the deferred module chunk arrives, so on a
   * cold load the icon and buttons sat there "already done" while the title and
   * subtitle waited invisible, then faded in after them. Backwards.
   *
   * Animations start at first paint with no JS in the loop, so the whole hero
   * choreographs top-down (60 → 420ms) deterministically — and identically
   * after a client-side swap, where the new DOM restarts them just as the
   * observer would have. `both` fill holds the hidden state through the delay
   * and the visible state after, which supersedes the class's base styling;
   * nothing here ever sets `data-revealed`, so the two systems stay decoupled.
   *
   * Same glass rule as `.lt-reveal-lift`: the rise variant animates `transform`
   * only. The fade variant is used on pure-text elements (title, subtitle,
   * scroll hint), where an opacity transition is safe.
   */
  @keyframes lt-hero-fade {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lt-hero-rise {
    from {
      transform: translateY(28px);
    }
    to {
      transform: none;
    }
  }

  .lt-hero-fade {
    animation: lt-hero-fade 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) both;
  }

  .lt-hero-rise {
    animation: lt-hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) both;
  }

  /*
   * Rotating hero word.
   *
   * The candidates are stacked in a single grid cell rather than absolutely
   * positioned, so the rotator is always as wide as the widest one and the
   * "· 珞家" tail never shifts mid-cycle. Every candidate being two characters
   * is what makes that invisible; a longer word would re-centre the line.
   *
   * `overflow: hidden` supplies the slot-roll clip. The padding exists only to
   * give the blur somewhere to happen — overflow clips at the *padding* box, so
   * without it a blur(10px) glyph gets sliced flat at its own edge. The
   * matching negative margin cancels the padding's layout footprint, so the
   * flex gap still reads as designed.
   */
  .lt-hero-title {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3em;
    /*
     * The `mt-6` on this element is load-bearing, not cosmetic. The heading
     * used to read "Luotopia", whose Latin cap-height fills ~70% of the em box;
     * it now leads with CJK, which fills ~88%. In the same line box that moves
     * the ink top up by roughly 10px, which collapsed the gap under the icon
     * plate and read as the two touching. Reverting to a Latin first word means
     * this margin can go back down.
     */
  }

  .lt-rotator {
    display: grid;
    /*
     * `clip-path`, not `overflow: hidden`. Both clip identically here, but per
     * spec an element whose `overflow` is not `visible` has its baseline at its
     * *bottom margin edge* instead of its first line's baseline. The h1 is
     * `align-items: baseline`, so that silently lifted the whole rotator by
     * roughly a line-height and drove the word into the logo above it.
     * `clip-path` leaves the baseline alone.
     *
     * The negative inset expands the clipping rectangle beyond the text box so
     * the 8–10px blur can dissipate instead of accumulating against a hard
     * square. It is still bounded: the slot travel is 0.72em, so the departing
     * and entering words remain clipped before they collide with the logo or
     * subtitle, and the smaller horizontal inset keeps them from smearing far
     * into the separator and accent tail.
     */
    clip-path: inset(-0.5em -0.2em);
    padding: 0.18em 0.24em;
    margin: -0.18em -0.24em;
  }

  .lt-rotator > .lt-word {
    grid-area: 1 / 1;
    justify-self: center;
    opacity: 0;
    transform: translateY(0.72em) scale(0.94);
    filter: blur(10px);
    transition:
      opacity 0.5s ease,
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
  }

  .lt-rotator > .lt-word[data-active="true"] {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  /* Must come after the [data-active] rule: both selectors are (0,2,0), and a
   * leaving word carries both attributes for the duration of the swap. */
  .lt-rotator > .lt-word[data-leaving="true"] {
    opacity: 0;
    transform: translateY(-0.72em) scale(0.96);
    filter: blur(8px);
  }

  /* Keeps select-all / copy on the heading from yielding all five candidates
   * concatenated. */
  .lt-rotator > .lt-word:not([data-active="true"]) {
    user-select: none;
    pointer-events: none;
  }

  .lt-sep {
    opacity: 0.42;
  }

  /*
   * Stops run 0% -> 100% rather than the previous 8% -> 96%. Insetting them
   * clamped both ends, so over a box only ~114px wide the outer 16% of each
   * glyph sat on a flat colour and the visible ramp was even shorter than the
   * token range implies.
   */
  .lt-hero-accent {
    background-image: linear-gradient(
      100deg,
      var(--lt-title-gradient-from) 0%,
      var(--lt-title-gradient-via) 46%,
      var(--lt-title-gradient-to) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lt-scroll-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 3.5rem;
    border-radius: 999px;
    color: var(--lt-color-outline);
    text-decoration: none;
    /* The entrance rides alongside the bob rather than via `.lt-hero-fade`:
     * one element, one `animation` shorthand — two rules setting it would
     * cascade down to a single winner. The bob animates `translate`, not
     * `transform`, so the two compositions never fight over the same property
     * (and the entrance's transform transition is no longer overridden). */
    animation:
      lt-hero-fade 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) both,
      lt-bob 2.4s ease-in-out infinite;
  }

  @keyframes lt-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-scroll-hint,
    .lt-hero-fade,
    .lt-hero-rise {
      animation: none;
    }

    /* The script never starts the cycle under reduced motion, so the first
     * candidate stays active and the heading reads as a stable
     * "智慧 · 珞家" — the other four are still stacked in the same cell at
     * opacity 0, which is why no display juggling is needed here. */
    .lt-rotator > .lt-word {
      transition: none;
      filter: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";

  onPageSetup((signal) => {
    const rotator = document.querySelector("[data-lt-rotator]");
    if (!rotator) return;

    const words = Array.from(rotator.querySelectorAll<HTMLElement>(".lt-word"));
    if (words.length <= 1) return;

    // Read live, not snapshotted: an OS reduced-motion flip mid-session has to
    // stop (or restart) the cycle — the same contract the friend-link dialog's
    // close timing keeps. The typeof guard covers engines whose MediaQueryList
    // is not an EventTarget; there the old snapshot behaviour remains.
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const HOLD = 2600;
    /** Must outlast the longest transition in `.lt-word` (0.72s transform). */
    const SWAP = 780;
    const leavingTimers = new Set<number>();
    let index = 0;
    let timer = 0;

    const show = (next: HTMLElement) => {
      const current = words[index];
      if (current === next) return;
      current.removeAttribute("data-active");
      current.setAttribute("data-leaving", "true");
      current.setAttribute("aria-hidden", "true");
      next.setAttribute("data-active", "true");
      next.removeAttribute("aria-hidden");

      // Clear `data-leaving` only after it has finished leaving, otherwise
      // the next cycle would find it mid-transition and snap.
      const timeout = window.setTimeout(() => {
        current.removeAttribute("data-leaving");
        leavingTimers.delete(timeout);
      }, SWAP);
      leavingTimers.add(timeout);
      index = words.indexOf(next);
    };

    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => show(words[(index + 1) % words.length]), HOLD);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    // Single gate for every "should the cycle run" input. A background tab
    // would otherwise pile up intervals and fire every queued swap at once on
    // return; a mid-session reduced-motion flip would otherwise keep rolling.
    const refresh = () => {
      if (document.hidden || motion.matches) stop();
      else start();
    };

    refresh();
    document.addEventListener("visibilitychange", refresh, { signal });
    if (typeof motion.addEventListener === "function") {
      motion.addEventListener("change", refresh, { signal });
    }

    signal.addEventListener("abort", () => {
      stop();
      for (const timeout of leavingTimers) window.clearTimeout(timeout);
      leavingTimers.clear();
    });
  });
</script>
