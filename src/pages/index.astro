---
/*
 * The default locale's home page.
 *
 * The body lives in `components/pages/HomePage.astro` and is shared with every
 * `src/pages/[lang]/index.astro`; this file exists only to claim the unprefixed
 * route. `routing.prefixDefaultLocale: false` is what keeps it unprefixed, so no
 * URL that already exists moves.
 */
import HomePage from "../components/pages/HomePage.astro";
---

<HomePage />
