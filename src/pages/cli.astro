---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
const platforms = [
  { id: "windows", name: "Windows", icon: "desktop_windows" },
  { id: "darwin", name: "macOS", icon: "laptop_mac" },
  { id: "linux", name: "Linux", icon: "computer" },
];
---

<BaseLayout title="Luotopia CLI">
  <PageHeader title="Luotopia CLI" subtitle="在终端中使用 Luotopia，选择你的系统开始下载。" />
  <main class="px-4 pb-20 text-on-surface">
    <div class="max-w-content mx-auto">
    <p id="cli-meta" class="text-body-medium text-outline mb-6" role="status">正在读取最新 CLI 版本…</p>
    <div id="cli-tabs" role="tablist" aria-label="选择 CLI 系统" class="mb-5 inline-flex max-w-full flex-wrap items-center gap-1 rounded-[28px] lt-inset p-1">
      {platforms.map((platform, index) => (
        <button type="button" role="tab" id={`cli-tab-${platform.id}`} aria-controls={`cli-panel-${platform.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-platform={platform.id} class:list={["state-layer inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2 text-label-large", index === 0 ? "lt-inset-raised text-primary" : "text-on-surface-variant"]}>
          <Icon name={platform.icon} class="text-lg" />
          {platform.name}
          <span data-device class="hidden rounded-sm bg-primary-container px-1.5 py-0.5 text-label-small text-on-primary-container">当前设备</span>
        </button>
      ))}
    </div>
    <div id="cli-panels">
      {platforms.map((platform, index) => (
        <section id={`cli-panel-${platform.id}`} role="tabpanel" aria-labelledby={`cli-tab-${platform.id}`} tabindex="0" hidden={index > 0} class="glass rounded-card p-5 sm:p-7">
          <div class="grid gap-7 lg:grid-cols-2 lg:gap-10">
            <div class="min-w-0">
              <div class="flex items-start gap-3.5">
                <span class="lt-icon-chip text-primary text-[22px] shrink-0"><Icon name={platform.icon} /></span>
                <div><h2 class="text-title-medium">{platform.name}</h2><p class="text-body-medium text-on-surface-variant mt-1">独立可执行文件，无需安装图形 App。</p></div>
              </div>
              <div data-downloads={platform.id} class="mt-5" aria-live="polite"><p class="text-body-medium text-outline">正在加载下载文件…</p></div>
            </div>
            <div class="min-w-0">
              <h3 class="flex items-center gap-2 text-title-small mb-3"><Icon name="terminal" class="text-lg text-primary" />开始使用</h3>
              <p class="text-body-medium text-on-surface-variant mb-3">下载后，在文件所在目录打开终端，运行以下命令查看帮助。</p>
              <pre class="lt-inset rounded-control p-4 overflow-x-auto text-body-small" data-lenis-prevent-horizontal><code data-command={platform.id}>正在加载命令…</code></pre>
              <p class="mt-3 text-body-small text-outline">{platform.id === "windows" ? "也可以将文件重命名为 luotopia.exe，并放入 PATH 目录。" : "首次运行前需要赋予执行权限；也可以将文件重命名为 luotopia，并放入 PATH 目录。"}</p>
              {platform.id === "darwin" && <p class="mt-2 text-body-small text-outline">Apple 芯片选择 arm64，Intel 芯片选择 x64。</p>}
            </div>
          </div>
        </section>
      ))}
    </div>
    <p class="mt-5 text-body-small text-outline leading-relaxed">CLI 与图形 App 分别发布版本。安装包可直接从官网下载；源码和 GitHub 页面需要私有仓库访问权限。<a href="https://github.com/ClosedWHU/Luotopia-CLI/releases" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">在 GitHub 查看 CLI Releases</a></p>
    <section class="mt-12" aria-labelledby="cli-changelog-title">
      <h2 id="cli-changelog-title" class="text-headline-small mb-5">更新日志</h2>
      <div id="cli-releases" class="space-y-4" aria-live="polite"><p class="text-body-medium text-outline">正在加载 CLI 更新日志…</p></div>
    </section>
    <noscript><p class="mt-5 text-body-medium">请启用 JavaScript 以获取 CLI 版本和下载文件，或通过上方 GitHub 链接查看发布版本。</p></noscript>
    </div>
  </main>
</BaseLayout>

<style>
  /* Same raised, primary-ring download treatment as the App download panel. */
  :global(.lt-cli-download) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9rem;
    color: var(--lt-color-on-surface);
    border-radius: var(--lt-radius-control);
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow: inset 0 0 0 1px var(--lt-color-primary);
  }
  :global(.lt-cli-notes) { overflow-wrap: anywhere; }
  :global(.lt-cli-history summary::-webkit-details-marker) { display: none; }
</style>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";
  import { escapeHtml as safe, formatReleaseNotes } from "../scripts/release-notes";
  import { normalizeIconSvg } from "../scripts/icon-svg";
  import downloadSvg from "@material-symbols/svg-400/outlined/download.svg?raw";
  import chevronSvg from "@material-symbols/svg-400/outlined/keyboard_arrow_down.svg?raw";

  type CliAsset = { name: string; size: number; url: string };
  type CliRelease = { tag: string; version: string; name: string; htmlUrl: string; body: string; publishedAt: string; prerelease: boolean; assets: CliAsset[] };

  onPageSetup((signal) => {
    const root = document.getElementById("cli-releases");
    if (!root) return;
    const meta = document.getElementById("cli-meta")!;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("#cli-tabs [role=tab]"));
    const ids = ["windows", "darwin", "linux"];
    const ua = navigator.userAgent || "";
    const device = /Android|iPhone|iPad|iPod/i.test(ua) ? null : /Mac/i.test(navigator.platform) ? "darwin" : /Win/i.test(navigator.platform) ? "windows" : /Linux/i.test(navigator.platform) ? "linux" : null;
    const selectTab = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.platform === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle("lt-inset-raised", selected);
        tab.classList.toggle("text-primary", selected);
        tab.classList.toggle("text-on-surface-variant", !selected);
        document.getElementById(`cli-panel-${tab.dataset.platform}`)!.hidden = !selected;
        if (selected && focus) tab.focus();
      });
    };
    const hash = location.hash.slice(1);
    selectTab(ids.includes(hash) ? hash : device || "windows");
    tabs.forEach((tab, index) => {
      if (tab.dataset.platform === device) tab.querySelector("[data-device]")!.classList.remove("hidden");
      tab.addEventListener("click", () => selectTab(tab.dataset.platform!), { signal });
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next].dataset.platform!, true);
      }, { signal });
    });
    const downloadIcon = normalizeIconSvg(downloadSvg, "text-2xl text-primary shrink-0");
    const chevron = normalizeIconSvg(chevronSvg, "text-lg text-outline shrink-0");
    const arch = (asset: CliAsset) => /-arm64(?:\.|$)/.test(asset.name) ? "arm64" : "x64";
    const size = (asset: CliAsset) => `${(asset.size / 1048576).toFixed(1)} MB`;
    const badge = (release: CliRelease) => `<span class="rounded-sm px-2 py-0.5 text-label-medium ${release.prerelease ? "bg-error-container text-on-error-container" : "bg-primary-container text-on-primary-container"}">${release.prerelease ? "预发布" : "正式版"}</span>`;
    const date = (release: CliRelease) => safe(release.publishedAt.slice(0, 10));
    let latest: CliRelease | undefined;
    const choices: Record<string, string> = {};
    const paintDownloads = (platform: string) => {
      const container = document.querySelector<HTMLElement>(`[data-downloads="${platform}"]`)!;
      const command = document.querySelector<HTMLElement>(`[data-command="${platform}"]`)!;
      const files = latest!.assets.filter((asset) => asset.name.indexOf(`luotopia-${platform}-`) === 0 || asset.name.indexOf(`luotopia-cli-${platform}-`) === 0);
      const checksums = latest!.assets.filter((asset) => asset.name.indexOf(`SHA256SUMS-${platform}-`) === 0);
      if (!files.length) {
        container.innerHTML = '<p class="text-body-medium text-outline">此版本暂未提供该系统的下载文件，可切换其他系统或查看历史版本。</p>';
        command.textContent = "此系统暂无可运行的下载文件。";
        return;
      }
      const selected = files.find((file) => arch(file) === choices[platform]) || files.find((file) => arch(file) === (platform === "darwin" ? "arm64" : "x64")) || files[0];
      choices[platform] = arch(selected);
      const arches = files.map(arch).filter((value, index, values) => values.indexOf(value) === index);
      const switcher = arches.length > 1 ? `<div role="group" aria-label="选择处理器架构" class="inline-flex gap-1 lt-inset rounded-full p-1 mb-4">${arches.map((value) => `<button type="button" data-arch="${value}" data-os="${platform}" aria-pressed="${value === arch(selected)}" class="state-layer cursor-pointer rounded-full px-3 py-1.5 text-label-medium ${value === arch(selected) ? "lt-inset-raised text-primary" : "text-on-surface-variant"}">${value}</button>`).join("")}</div>` : "";
      container.innerHTML = `${switcher}<a href="${safe(selected.url)}" title="${safe(selected.name)}" class="lt-cli-download state-layer no-underline" download>${downloadIcon}<span class="min-w-0 flex-1"><span class="block text-title-small">下载 ${arch(selected)}${platform === "windows" ? " · EXE" : " · 二进制文件"}</span><span class="block truncate text-body-small text-on-surface-variant mt-1">${safe(selected.name)} · ${size(selected)}</span></span></a>${checksums.length ? `<details class="mt-4"><summary class="cursor-pointer text-body-small text-on-surface-variant hover:text-primary">SHA-256 校验文件</summary><ul class="mt-2 space-y-2">${checksums.map((file) => `<li><a href="${safe(file.url)}" download class="text-body-small text-primary hover:underline break-all">${safe(file.name)}</a></li>`).join("")}</ul></details>` : ""}`;
      command.textContent = platform === "windows" ? `.\\${selected.name} --help` : `chmod +x ./${selected.name}\n./${selected.name} --help`;
    };
    document.getElementById("cli-panels")!.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-arch]");
      if (!button) return;
      choices[button.dataset.os!] = button.dataset.arch!;
      paintDownloads(button.dataset.os!);
      document.querySelector<HTMLButtonElement>(`[data-os="${button.dataset.os}"][data-arch="${button.dataset.arch}"]`)?.focus();
    }, { signal });
    const load = async () => {
      meta.textContent = "正在读取最新 CLI 版本…";
      root.setAttribute("aria-busy", "true");
      try {
        const response = await fetch("/api/cli/releases", { signal });
        if (!response.ok) throw new Error("unavailable");
        const data = await response.json() as { items: CliRelease[] };
        if (signal.aborted) return;
        latest = data.items[0];
        if (!latest) {
          meta.textContent = "目前没有已发布的 CLI 版本。";
          document.querySelectorAll("[data-downloads], [data-command]").forEach((element) => { element.textContent = "等待首个 CLI 版本发布。"; });
          root.textContent = "发布后将在这里显示更新日志。";
          return;
        }
        meta.innerHTML = `<span class="inline-flex flex-wrap items-center gap-2"><span>最新版本 ${safe(latest.tag)}</span>${badge(latest)}<span>发布于 ${date(latest)}</span></span>`;
        ids.forEach(paintDownloads);
        root.innerHTML = data.items.map((release, index) => `
          <details class="lt-cli-history glass rounded-card" ${index === 0 ? "open" : ""}>
            <summary class="state-layer flex cursor-pointer list-none items-center gap-3 rounded-card p-5 sm:p-6">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2"><h3 class="text-title-medium">${safe(release.name)}</h3>${badge(release)}</div>
                <span class="block text-body-small text-outline mt-1">${date(release)}</span>
              </div>${chevron}
            </summary>
            <div class="px-5 pb-5 sm:px-6 sm:pb-6">
              <div class="lt-cli-notes text-body-medium space-y-2">${formatReleaseNotes(release.body, "该版本未提供更新说明。")}</div>
              ${index > 0 ? `<details class="lt-inset rounded-control p-3 mt-4">
                <summary class="cursor-pointer text-label-large">下载此版本</summary>
                <ul class="mt-3 space-y-2">${release.assets.map((asset) => `<li><a href="${safe(asset.url)}" download class="text-body-small text-primary hover:underline break-all">${safe(asset.name)}</a></li>`).join("")}</ul>
              </details>` : ""}
              <a class="inline-block text-body-small text-primary hover:underline mt-4" href="${safe(release.htmlUrl)}" target="_blank" rel="noopener noreferrer">在 GitHub 查看此版本（需要仓库权限）</a>
            </div>
          </details>`).join("");
      } catch {
        if (signal.aborted) return;
        meta.textContent = "暂时无法读取 CLI 版本。";
        root.innerHTML = '<div class="lt-inset rounded-control p-5 text-body-medium"><p>版本获取失败，请重试；有仓库权限的用户也可通过 GitHub 查看。</p><button type="button" data-retry class="state-layer lt-inset-raised rounded-full px-4 py-2 text-label-large text-primary mt-3 cursor-pointer">重新获取</button></div>';
        document.querySelectorAll("[data-downloads], [data-command]").forEach((element) => { element.textContent = "版本获取失败，请在下方重新获取。"; });
      } finally {
        if (!signal.aborted) root.removeAttribute("aria-busy");
      }
    };
    root.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-retry]")) void load();
    }, { signal });
    void load();
  });
</script>
