/**
 * One service status page per published non-default locale. See `[lang]/index.astro`.
 */
import { PREFIXED_LOCALES } from "../../i18n/locales";
import StatusPage from "../../components/pages/StatusPage.astro";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { lang: locale.path } }));
}
