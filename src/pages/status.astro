---
/*
 * The default locale's service status page.
 *
 * The body lives in `components/pages/StatusPage.astro` and is shared with
 * every `src/pages/[lang]/status.astro`; this file exists only to claim the
 * unprefixed route. `routing.prefixDefaultLocale: false` is what keeps it
 * unprefixed, so no URL that already exists moves.
 */
import StatusPage from "../components/pages/StatusPage.astro";
---

<StatusPage />
