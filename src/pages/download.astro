---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { platforms, testFlightUrl } from "../config/downloads";
---

<BaseLayout title="下载">
  <PageHeader title="下载 Luotopia" subtitle="选择你的平台，获取最新版本" />

  <section class="relative pb-16 px-4">
    <div class="max-w-6xl mx-auto">
      <p id="latest-meta" class="lt-reveal text-body-medium text-outline mb-10">正在从 GitHub Releases 加载…</p>

      <div id="platform-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {platforms.map((p, i) => (
          <div
            class="platform-card lt-reveal-lift lt-lift glass rounded-card p-5 flex flex-col"
            style={`--lt-reveal-delay: ${(i % 4) * 70}ms`}
            data-platform={p.id}
            data-external-url={p.externalUrl ?? ""}
            data-external-label={p.externalLabel ?? ""}
          >
            <span class="lt-icon-chip text-primary text-[22px] mb-3.5"><Icon name={p.icon} /></span>
            <h2 class="text-title-medium text-on-surface">{p.name}</h2>
            <p class="text-body-medium text-on-surface-variant mt-1">{p.desc}</p>
            <div class="mt-4 flex flex-wrap gap-1.5 items-center platform-badges">
              <span class="platform-status inline-block px-2.5 py-0.5 rounded-sm lt-inset text-on-surface-variant text-label-medium">
                {p.externalUrl ? (p.id === "apple" ? "TestFlight 内测" : p.externalLabel) : "加载中…"}
              </span>
            </div>
            <div class:list={["platform-assets", "mt-3", "space-y-1.5", !p.externalUrl && "hidden"]}>
              {p.externalUrl && (
                <a
                  href={p.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 text-body-small text-primary hover:underline no-underline"
                >
                  <Icon name="open_in_new" class="text-base" />
                  <span>{p.externalLabel ?? "外部安装"}</span>
                </a>
              )}
            </div>
            <p class="mt-2 text-body-small text-outline">{p.note}</p>
          </div>
        ))}
      </div>

      <div class="lt-reveal-lift mt-16 rounded-card glass p-6 sm:p-8">
        <h2 class="text-title-medium text-on-surface mb-4">安装说明</h2>
        <div class="space-y-4 text-body-medium text-on-surface-variant">
          <div>
            <h3 class="text-title-small text-on-surface mb-1">Android</h3>
            <p>按 ABI 分发包（与 <code class="text-on-surface">build-release.bat --split-per-abi</code> 一致）：优先选标有「推荐」的 <strong class="text-on-surface">arm64-v8a</strong>（近年金属机）；老设备用 armeabi-v7a。下载 APK 后直接安装；如提示「未知来源」，请在系统设置中允许安装。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">Apple</h3>
            <p><strong class="text-on-surface">iOS / iPadOS / macOS：</strong>统一通过 TestFlight 分发。打开
              <a href={testFlightUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">TestFlight 加入链接</a>
              即可在 iPhone、iPad 或 Apple 芯片 Mac（macOS 13.5+）上申请内测。由于 Apple 政策限制，非越狱设备需通过 TestFlight 安装；TestFlight 构建有效期为 90 天，保持应用更新即可。</p>
            <p class="mt-2 text-body-small text-outline">早期版本的 macOS arm64 DMG 仍可在对应历史 Release 的资产中找到，新版本不再随 Release 发布 DMG。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">Linux</h3>
            <p>每个 Release 按<strong class="text-on-surface">架构</strong>（x64 / arm64）与<strong class="text-on-surface">格式</strong>发布（均为 <code class="text-on-surface">--release</code>，无 debug 符号）：</p>
            <ul class="mt-2 list-disc pl-5 space-y-1">
              <li><strong class="text-on-surface">tar.gz</strong> — 便携目录，推荐通用；标「推荐」的多为 x64/amd64</li>
              <li><strong class="text-on-surface">AppImage</strong> — 单文件运行（需 FUSE 或直接可执行）</li>
              <li><strong class="text-on-surface">deb</strong> — Debian/Ubuntu：<code class="text-on-surface">sudo apt install ./luotopia-*-linux-*.deb</code></li>
              <li><strong class="text-on-surface">flatpak</strong> — 本地 bundle（若 CI 成功生成）：<code class="text-on-surface">flatpak install --user ./luotopia-*-linux-*.flatpak</code></li>
            </ul>
            <pre data-lenis-prevent-horizontal class="mt-2 overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code>tar -xzf luotopia-*-linux-x64.tar.gz &amp;&amp; ./luotopia/luotopia
# 或
chmod +x luotopia-*-linux-x64.AppImage &amp;&amp; ./luotopia-*-linux-x64.AppImage</code></pre>
            <p class="mt-2 text-body-small text-outline">依赖较新 glibc + GTK3。arm64 在 GitHub ARM runner 上原生构建。手动重跑 CI 可选架构（x64/arm64/both）与格式（tar,appimage,deb,flatpak）。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">HarmonyOS</h3>
            <p>HarmonyOS NEXT 工程随客户端维护，但 <code class="text-on-surface">.hap</code> 不随每个 Release 发布。若 Release 资产中包含 <code class="text-on-surface">luotopia-*-harmonyos-arm64-signed.hap</code>，请按照同版本的 <code class="text-on-surface">HARMONYOS-SIDELOAD.txt</code> 侧载安装。</p>
            <p class="mt-2 text-body-small text-outline">受平台能力限制，WebView 密集型校园服务会在 HarmonyOS 上隐藏或降级。</p>
          </div>
        </div>
      </div>

      <div class="lt-reveal-lift mt-8 rounded-card glass p-6 sm:p-8">
        <h2 class="text-title-medium text-on-surface mb-2">高级用户 / 包管理器</h2>
        <p class="text-body-medium text-on-surface-variant mb-4">面向喜欢 CLI 安装、可复现升级的用户。资产随每个 GitHub Release 发布（含 prerelease）。</p>
        <div class="space-y-5 text-body-medium text-on-surface-variant">
          <div>
            <h3 class="text-title-small text-on-surface mb-1">Scoop</h3>
            <p class="mb-2">从对应 Release 的清单直接安装（将 <code class="text-on-surface">&lt;tag&gt;</code> 换成版本，如 <code class="text-on-surface">v1.0.0+2</code>）：</p>
            <pre data-lenis-prevent-horizontal class="overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code>scoop install https://github.com/ClosedWHU/Luotopia/releases/download/&lt;tag&gt;/scoop-luotopia.json</code></pre>
            <p class="mt-2 text-body-small text-outline">清单基于便携 zip；升级可重新 install 新 tag 的 json，或自行维护 bucket。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">AUR（Arch Linux）</h3>
            <p class="mb-2">预构建包会随 Release 自动更新：</p>
            <pre data-lenis-prevent-horizontal class="overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code>yay -S luotopia-bin</code></pre>
            <p class="mt-2 text-body-small text-outline">AUR 包按架构下载对应的 x64 / arm64 便携归档。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">winget</h3>
            <p class="mb-2">官方社区源合并前，可用 Release 里的草稿清单本地验证：</p>
            <pre data-lenis-prevent-horizontal class="overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code># 下载 winget-ClosedWHU.Luotopia*.yaml 后
winget install --manifest .\path\to\manifests\folder</code></pre>
            <p class="mt-2">合并到 <a href="https://github.com/microsoft/winget-pkgs" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">microsoft/winget-pkgs</a> 之后：</p>
            <pre data-lenis-prevent-horizontal class="mt-2 overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code>winget install ClosedWHU.Luotopia</code></pre>
            <p class="mt-2 text-body-small text-outline">当前清单默认指向 zip 便携包；有签名 MSIX 后再可改为 MSIX 安装器以改善 SmartScreen 体验。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">MSIX 旁加载</h3>
            <p>下载 <code class="text-on-surface">*-windows-x64.msix</code> 后双击安装，或：</p>
            <pre data-lenis-prevent-horizontal class="mt-2 overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code>Add-AppxPackage .\luotopia-*-windows-x64.msix</code></pre>
            <p class="mt-2 text-body-small text-outline">未提供 Windows 代码签名证书时为未签名包。可选在仓库配置 <code class="text-on-surface">WINDOWS_PFX_BASE64</code> / <code class="text-on-surface">WINDOWS_PFX_PASSWORD</code> 以在 CI 中签名。传统 WiX MSI 暂不维护。</p>
          </div>
          <div>
            <h3 class="text-title-small text-on-surface mb-1">Linux 包格式速查</h3>
            <pre data-lenis-prevent-horizontal class="overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface"><code># 架构：x64 或 arm64（文件名含 linux-x64 / linux-arm64）
sudo apt install ./luotopia-*-linux-x64.deb
chmod +x ./luotopia-*-linux-x64.AppImage &amp;&amp; ./luotopia-*-linux-x64.AppImage
flatpak install --user ./luotopia-*-linux-x64.flatpak</code></pre>
            <p class="mt-2 text-body-small text-outline">deb 控制字段 Architecture 为 amd64/arm64；Release 文件名用 <code class="text-on-surface">x64</code>/<code class="text-on-surface">arm64</code> 以便官网识别。</p>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center mb-20">
        <p class="text-body-small text-outline">
          你也可以直接访问
          <a href="https://github.com/ClosedWHU/Luotopia/releases" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">GitHub Releases</a>
          查看所有历史版本和发布说明。
        </p>
      </div>

      <!-- `lt-reveal-lift`, not `lt-reveal`: this wrapper holds the dynamically
           injected `.glass` release articles, and an opacity transition would
           make it a backdrop root for 0.7s — every glass card rendering flat,
           then snapping into blur at the end. Transform-only, per the rule in
           global.css. -->
      <div id="changelog" class="lt-reveal-lift">
        <h2 class="text-headline-small text-on-surface mb-2">更新日志</h2>
        <p class="text-body-large text-on-surface-variant mb-8">来自 GitHub Releases 的发布历史</p>

        <div id="changelog-list" class="space-y-6" tabindex="-1">
          <p class="text-body-medium text-outline">加载中…</p>
        </div>

        <div id="changelog-pager" class="mt-8 flex items-center justify-center gap-3 hidden">
          <button type="button" id="changelog-prev" class="state-layer rounded-full px-5 py-2 border border-outline text-primary bg-transparent cursor-pointer font-medium disabled:opacity-40 disabled:cursor-not-allowed">上一页</button>
          <span id="changelog-page-label" class="text-body-small text-outline"></span>
          <button type="button" id="changelog-next" class="state-layer rounded-full px-5 py-2 border border-outline text-primary bg-transparent cursor-pointer font-medium disabled:opacity-40 disabled:cursor-not-allowed">下一页</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";
  import { normalizeIconSvg } from "../scripts/icon-svg";
  import downloadIconRaw from "@material-symbols/svg-400/outlined/download.svg?raw";
  import openInNewIconRaw from "@material-symbols/svg-400/outlined/open_in_new.svg?raw";

  const openInNewIcon = normalizeIconSvg(openInNewIconRaw, "text-base");
  const assetDownloadIcon = normalizeIconSvg(downloadIconRaw, "text-base shrink-0 mt-0.5");
  const changelogDownloadIcon = normalizeIconSvg(downloadIconRaw, "text-sm");

  onPageSetup((signal) => {
    const PER_PAGE = 5;
    let page = 1;
    let hasNext = false;
    let hasPrev = false;

    const latestMeta = document.getElementById("latest-meta");
    const listEl = document.getElementById("changelog-list");
    const pager = document.getElementById("changelog-pager");
    const prevBtn = document.getElementById("changelog-prev");
    const nextBtn = document.getElementById("changelog-next");
    const pageLabel = document.getElementById("changelog-page-label");

    function formatSize(bytes) {
      if (!bytes && bytes !== 0) return "";
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
      return (bytes / (1024 * 1024)).toFixed(1) + " MB";
    }

    /** Split name so UI can truncate base while keeping suffix (e.g. .tar.gz) visible. */
    function splitFilename(name) {
      const n = String(name || "");
      const multi = n.match(/(\.(tar\.gz|tgz))$/i);
      if (multi) {
        return { base: n.slice(0, -multi[1].length), ext: multi[1] };
      }
      const i = n.lastIndexOf(".");
      if (i > 0) return { base: n.slice(0, i), ext: n.slice(i) };
      return { base: n, ext: "" };
    }

    function formatDate(iso) {
      if (!iso) return "";
      try {
        return new Date(iso).toLocaleDateString("zh-CN", { year: "numeric", month: "short", day: "numeric" });
      } catch {
        return iso.slice(0, 10);
      }
    }

    function escapeHtml(s) {
      // `replace(/g)`, not `replaceAll` (Chrome 85+): this bundle must parse
      // and run on WebView kernels back to ~66.
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    /** Inline markdown after HTML escape: **bold**, `code`, [text](url) */
    function formatInline(s) {
      return s
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (_, t, u) => {
          return `<a href="${u}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${t}</a>`;
        })
        .replace(/`([^`]+)`/g, '<code class="px-1 rounded-[4px] lt-inset text-on-surface text-[0.9em]">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-medium text-on-surface">$1</strong>');
    }

    /** Release notes markdown: headings, lists, quotes, hr, paragraphs */
    function formatBody(body) {
      if (!body) return '<p class="text-outline">暂无说明</p>';
      const lines = escapeHtml(body).split(/\r?\n/);
      const html = [];
      let inList = false;
      const closeList = () => {
        if (inList) {
          html.push("</ul>");
          inList = false;
        }
      };
      let inQuote = false;
      let quoteLines = [];
      const closeQuote = () => {
        if (!inQuote) return;
        const paras = [];
        let cur = [];
        for (const l of quoteLines) {
          if (l.trim() === "") {
            if (cur.length) {
              paras.push(cur);
              cur = [];
            }
          } else {
            cur.push(l);
          }
        }
        if (cur.length) paras.push(cur);
        const inner = paras.length
          ? paras
              .map(
                (p) =>
                  `<p class="my-1 text-body-medium text-on-surface-variant">${p
                    .map(formatInline)
                    .join("<br>")}</p>`,
              )
              .join("")
          : '<p class="my-1">&nbsp;</p>';
        html.push(
          `<blockquote class="my-2 border-l-2 border-outline-variant pl-3">${inner}</blockquote>`,
        );
        inQuote = false;
        quoteLines = [];
      };
      for (const raw of lines) {
        const line = raw.replace(/\s+$/, "");
        // `>` is HTML-escaped to `&gt;` before parsing, so match the entity.
        const quote = line.match(/^\s*&gt;\s?(.*)$/);
        if (quote) {
          if (!inQuote) {
            closeList();
            inQuote = true;
            quoteLines = [];
          }
          quoteLines.push(quote[1].replace(/\s+$/, ""));
          continue;
        }
        closeQuote();
        if (line.trim() === "") {
          closeList();
          html.push('<div class="h-2"></div>');
          continue;
        }
        if (/^---+$/.test(line.trim()) || /^\*\*\*+$/.test(line.trim())) {
          closeList();
          html.push('<hr class="my-3 border-outline-variant" />');
          continue;
        }
        const h = line.match(/^(#{1,4})\s+(.+)$/);
        if (h) {
          closeList();
          const level = h[1].length;
          const text = formatInline(h[2]);
          // The release article already spends h3 on the version title, so
          // note headings start at h4 to keep the outline hierarchical.
          if (level === 1) {
            html.push(
              `<h4 class="mt-4 mb-2 text-title-large text-on-surface">${text}</h4>`,
            );
          } else if (level === 2) {
            html.push(
              `<h4 class="mt-4 mb-2 text-title-medium text-on-surface">${text}</h4>`,
            );
          } else {
            html.push(
              `<h5 class="mt-3 mb-1.5 text-title-small text-on-surface">${text}</h5>`,
            );
          }
          continue;
        }
        const item = line.match(/^\s*[-*•]\s+(.+)/);
        if (item) {
          if (!inList) {
            html.push('<ul class="space-y-1.5 my-2 pl-0 list-none">');
            inList = true;
          }
          html.push(
            `<li class="flex gap-2 text-body-medium text-on-surface-variant"><span class="text-primary shrink-0 select-none">•</span><span class="min-w-0">${formatInline(item[1])}</span></li>`,
          );
          continue;
        }
        closeList();
        html.push(
          `<p class="text-body-medium text-on-surface-variant">${formatInline(line)}</p>`,
        );
      }
      closeList();
      closeQuote();
      return html.join("");
    }

    function prereleaseBadge() {
      return `<span class="inline-block px-2 py-0.5 rounded-sm bg-error-container text-on-error-container text-label-medium">测试版</span>`;
    }

    function stableBadge(text) {
      return `<span class="inline-block px-2.5 py-0.5 rounded-sm bg-primary-container text-on-primary-container text-label-medium">${escapeHtml(text)}</span>`;
    }

    function applyExternalLink(card, statusText) {
      const status = card.querySelector(".platform-status");
      const assetsEl = card.querySelector(".platform-assets");
      if (!status || !assetsEl) return;

      const externalUrl = card.getAttribute("data-external-url") || "";
      const externalLabel = card.getAttribute("data-external-label") || "外部安装";
      const id = card.getAttribute("data-platform");

      status.className =
        "platform-status inline-block px-2.5 py-0.5 rounded-sm lt-inset text-on-surface-variant text-label-medium";

      if (externalUrl) {
        status.textContent = id === "apple" ? "TestFlight 内测" : statusText;
        assetsEl.classList.remove("hidden");
        assetsEl.innerHTML = `<a href="${escapeHtml(externalUrl)}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-body-small text-primary hover:underline no-underline">
            ${openInNewIcon}
            <span>${escapeHtml(externalLabel)}</span>
          </a>`;
      } else {
        status.textContent = statusText;
        assetsEl.classList.add("hidden");
        assetsEl.innerHTML = "";
      }
    }

    /**
     * The navigation signal plus a timeout, combined by hand: `AbortSignal.any`
     * is Chrome 116+ and `AbortSignal.timeout` 103+, far above this bundle's
     * ~66 floor. Without a timeout a hung API would keep "加载中…" forever.
     */
    function fetchWithTimeout(url: string, ms: number) {
      const ctrl = new AbortController();
      const timer = window.setTimeout(() => ctrl.abort(), ms);
      const onNavAbort = () => ctrl.abort();
      if (signal.aborted) onNavAbort();
      else signal.addEventListener("abort", onNavAbort, { once: true });
      return fetch(url, { signal: ctrl.signal }).finally(() => {
        window.clearTimeout(timer);
        signal.removeEventListener("abort", onNavAbort);
      });
    }

    async function loadTestFlightVersion() {
      if (signal.aborted) return;

      try {
        // TestFlight builds are not GitHub Release assets. Ask the Pages
        // Function directly so the Apple card shows the actual beta build.
        const r = await fetchWithTimeout("/api/appstore/latest?connect=1", 15000);
        if (!r.ok || signal.aborted) return;

        const info = await r.json();
        if (info?.error || info?.channel !== "testflight" || !info.version) return;

        const card = document.querySelector('.platform-card[data-platform="apple"]');
        const status = card?.querySelector(".platform-status");
        if (status) status.textContent = `TestFlight ${info.version}`;
      } catch { /* Keep the static TestFlight label when Connect is unavailable. */ }
    }

    async function loadLatest() {
      if (signal.aborted) return;
      // Prefer newest including prerelease so testers see pre builds; badge will mark it
      let release = null;
      try {
        const r = await fetchWithTimeout("/api/releases/latest?prerelease=1", 15000);
        if (r.ok) release = await r.json();
      } catch { /* ignore */ }
      if (signal.aborted) return;

      if (!release || release.error) {
        if (latestMeta) latestMeta.textContent = "暂时无法获取最新版本，请前往 GitHub Releases。";
        document.querySelectorAll(".platform-card").forEach((card) => {
          applyExternalLink(card, "暂无数据");
        });
        void loadTestFlightVersion();
        return;
      }

      const verLabel = release.version || release.tag || release.title;
      if (latestMeta) {
        latestMeta.innerHTML =
          `当前最新：<strong class="text-on-surface">${escapeHtml(verLabel)}</strong>` +
          (release.prerelease ? ` ${prereleaseBadge()}` : "") +
          (release.publishedAt ? ` · ${formatDate(release.publishedAt)}` : "") +
          (release.htmlUrl
            ? ` · <a href="${escapeHtml(release.htmlUrl)}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Release 详情</a>`
            : "");
      }

      const byPlatform = {};
      for (const a of release.assets || []) {
        const p = a.platform || "other";
        if (!byPlatform[p]) byPlatform[p] = [];
        byPlatform[p].push(a);
      }

      document.querySelectorAll(".platform-card").forEach((card) => {
        const id = card.getAttribute("data-platform");
        const badges = card.querySelector(".platform-badges");
        const assetsEl = card.querySelector(".platform-assets");
        // The Apple card has no GitHub assets (iOS/iPadOS/macOS all ship via
        // TestFlight), so `assets` stays empty and it keeps the external link.
        const assets = byPlatform[id] || [];

        if (!badges || !assetsEl) return;

        if (assets.length === 0) {
          const fallback = release.prerelease ? `测试版 ${verLabel}` : `最新 ${verLabel}`;
          applyExternalLink(card, fallback);
          return;
        }

        badges.innerHTML = "";
        if (release.prerelease) {
          badges.insertAdjacentHTML("beforeend", prereleaseBadge());
        }
        badges.insertAdjacentHTML("beforeend", stableBadge(verLabel));

        const installers = assets.filter((a) => !a.meta);
        assetsEl.classList.remove("hidden");
        const externalUrl = card.getAttribute("data-external-url") || "";
        const externalLabel = card.getAttribute("data-external-label") || "外部安装";
        const externalLink = externalUrl
          ? `<a href="${escapeHtml(externalUrl)}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-body-small text-primary hover:underline no-underline">
              ${openInNewIcon}
              <span>${escapeHtml(externalLabel)}</span>
            </a>`
          : "";
        assetsEl.innerHTML = externalLink + installers
          .map((a) => {
            const title =
              a.label ||
              [a.archLabel || a.arch, a.formatLabel].filter(Boolean).join(" · ") ||
              a.name;
            const rec = a.recommended
              ? `<span class="shrink-0 px-1.5 py-0.5 rounded-sm bg-primary-container text-on-primary-container text-label-small leading-none">推荐</span>`
              : "";
            const { base, ext } = splitFilename(a.name);
            return `<a href="${escapeHtml(a.url)}" title="${escapeHtml(a.name)}" class="flex items-start gap-1.5 text-body-small text-primary hover:underline no-underline" download>
                ${assetDownloadIcon}
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-1.5">
                    <span class="font-medium text-on-surface">${escapeHtml(title)}</span>
                    ${rec}
                  </span>
                  <span class="flex min-w-0 items-baseline text-outline text-[11px] mt-0.5">
                    <span class="truncate min-w-0">${escapeHtml(base)}</span>
                    <span class="shrink-0">${escapeHtml(ext)}</span>
                    <span class="shrink-0"> · ${formatSize(a.size)}</span>
                  </span>
                </span>
              </a>`;
          })
          .join("");
      });

      void loadTestFlightVersion();
    }

    // Rapid clicks put several loadChangelog calls in flight at once; a stale
    // response landing late would otherwise overwrite the newer page and leave
    // `page` disagreeing with what is on screen. Only the newest request may
    // touch the DOM. (Deliberately not `disabled` during load: disabling the
    // focused pager button drops keyboard focus to <body>.)
    let changelogRequestId = 0;

    async function loadChangelog(p) {
      if (!listEl || signal.aborted) return;
      const requestId = ++changelogRequestId;
      // Replacing innerHTML detaches a focused link and drops focus to <body>;
      // remember it and park focus on the list (tabindex="-1") instead, both
      // while loading and after the new page renders.
      const focusWasInList = listEl.contains(document.activeElement);
      listEl.innerHTML = `<p class="text-body-medium text-outline">加载中…</p>`;
      if (focusWasInList) listEl.focus({ preventScroll: true });
      try {
        const r = await fetchWithTimeout(`/api/releases?page=${p}&per_page=${PER_PAGE}`, 15000);
        if (!r.ok) throw new Error("HTTP " + r.status);
        const data = await r.json();
        if (signal.aborted || requestId !== changelogRequestId) return;
        page = data.page || p;
        hasNext = !!data.hasNext;
        hasPrev = !!data.hasPrev || page > 1;
        const items = data.items || [];

        if (items.length === 0) {
          listEl.innerHTML = `<p class="text-body-medium text-outline">暂无发布记录。请访问 <a href="https://github.com/ClosedWHU/Luotopia/releases" class="text-primary hover:underline" target="_blank" rel="noopener noreferrer">GitHub Releases</a>。</p>`;
        } else {
          listEl.innerHTML = items
            .map((rel) => {
              const ver = rel.version || rel.tag || rel.title;
              const assetList = (rel.assets || []).filter((a) => !a.meta);
              const assets =
                assetList.length > 0
                  ? `<div class="mt-4 flex flex-wrap gap-2">${assetList
                      .map((a) => {
                        const label =
                          a.label ||
                          [a.platform, a.archLabel || a.arch, a.formatLabel]
                            .filter(Boolean)
                            .join(" · ") ||
                          a.name;
                        const rec = a.recommended ? " · 推荐" : "";
                        return `<a href="${escapeHtml(a.url)}" title="${escapeHtml(a.name)}" class="inline-flex items-center gap-1 px-3 py-1 rounded-full lt-inset-raised text-label-medium text-primary no-underline hover:underline" download>
                            ${changelogDownloadIcon}${escapeHtml(label + rec)}
                          </a>`;
                      })
                      .join("")}</div>`
                  : "";
              return `<article class="rounded-card glass p-6">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="text-title-large text-on-surface">${escapeHtml(ver)}</h3>
                  ${rel.prerelease ? prereleaseBadge() : ""}
                  <span class="text-body-small text-outline ml-auto">${formatDate(rel.publishedAt)}</span>
                </div>
                ${rel.title && rel.title !== ver && rel.title !== rel.tag ? `<p class="text-body-small text-outline mb-3">${escapeHtml(rel.title)}</p>` : ""}
                <div class="text-body-medium text-on-surface-variant">${formatBody(rel.body)}</div>
                ${assets}
                ${rel.htmlUrl ? `<p class="mt-4 text-body-small"><a href="${escapeHtml(rel.htmlUrl)}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">在 GitHub 上查看</a></p>` : ""}
              </article>`;
            })
            .join("");
        }
        if (focusWasInList) listEl.focus({ preventScroll: true });

        if (pager && prevBtn && nextBtn && pageLabel) {
          pager.classList.remove("hidden");
          prevBtn.disabled = !hasPrev;
          nextBtn.disabled = !hasNext;
          pageLabel.textContent = `第 ${page} 页`;
        }
      } catch {
        if (signal.aborted || requestId !== changelogRequestId) return;
        listEl.innerHTML = `<p class="text-body-medium text-outline">加载失败（本地开发需部署 Pages Functions，或配置 GITHUB_TOKEN）。请访问 <a href="https://github.com/ClosedWHU/Luotopia/releases" class="text-primary hover:underline" target="_blank" rel="noopener noreferrer">GitHub Releases</a>。</p>`;
        pager?.classList.add("hidden");
      }
    }

    prevBtn?.addEventListener("click", () => {
      if (page > 1) loadChangelog(page - 1);
    }, { signal });
    nextBtn?.addEventListener("click", () => {
      if (hasNext) loadChangelog(page + 1);
    }, { signal });

    loadLatest();
    loadChangelog(1);
  });
</script>
