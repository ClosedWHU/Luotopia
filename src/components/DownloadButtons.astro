---
import Icon from "./Icon.astro";
import { resolveLocale, routeUrl, useTranslations } from "../i18n/ui";

export interface Props {
  variant?: "hero" | "default";
  /**
   * What the pair sits on. Over the aurora the secondary is a `glass-control`
   * pill; inside a glass panel — the home page's closing CTA — that would be a
   * second blur sampling the panel's own fill, the nested-glass case the design
   * rules call meaningless, so it steps down to the inset rung the panel's own
   * rows use. The primary needs no such switch: `filled-glass` carries no
   * backdrop-filter any more.
   */
  surface?: "aurora" | "panel";
}

const { variant = "default", surface = "aurora" } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const size = variant === "hero" ? "px-7 py-3 text-[17px]" : "px-6 py-2.5 text-label-large";
const iconSize = variant === "hero" ? "text-xl" : "text-lg";

/*
 * Both CTAs go through `routeUrl()`, so on a locale that has no translated
 * download page the primary button leads to the Chinese one directly. That is
 * deliberate: the download page is where the conversion happens, and a redirect
 * stub in front of it is a round trip for no benefit. The label stays in the
 * visitor's language either way, which is the part that actually reads as broken
 * if it is wrong.
 */
const downloadHref = routeUrl(locale, "download");
const featuresHref = routeUrl(locale, "features");

/*
 * Two kinds of button, matching the split the app makes in `app_glass.dart`:
 * the filled/accent surface carries a brand tint and a fixed content colour,
 * while secondary surfaces go translucent and let the aurora show through.
 *
 * `filled-glass` (not `bg-primary`) drives the fill so the dialog CTA in
 * FriendLinks renders as the same object — and so dark mode can make it tinted
 * glass instead of a flat pale pill. See the utility in global.css.
 */
const primaryClass = `lt-btn lt-btn-filled filled-glass state-layer inline-flex items-center gap-2 rounded-full no-underline font-medium ${size}`;
const secondaryClass = `lt-btn ${surface === "panel" ? "lt-inset-raised" : "glass-control"} state-layer inline-flex items-center gap-2 rounded-full no-underline font-medium text-on-surface ${size}`;
---

<div class="flex flex-wrap justify-center gap-3">
  <a href={downloadHref} class={primaryClass}>
    <Icon name="download" class={iconSize} />
    {t("cta.download")}
  </a>
  <a href={featuresHref} class={secondaryClass}>
    {t("cta.features")}
  </a>
</div>

<style>
  .lt-btn {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Pointer-gated: on touch, `:hover` sticks after a tap and the button would
   * stay lifted until something else is tapped. */
  @media (hover: hover) {
    .lt-btn-filled:hover {
      transform: translateY(-2px);
      box-shadow: var(--lt-btn-filled-shadow-hover);
    }
  }

  /* Hairline ring, not Tailwind's `border`: a 1px border on a 44px-tall pill
   * reads heavy, and the app's glass uses a 0.6px optical rim. */
  .lt-btn:not(.lt-btn-filled) {
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 6px 18px -10px hsl(215 45% 18% / 0.28);
  }

  @media (hover: hover) {
    .lt-btn:not(.lt-btn-filled):hover {
      transform: translateY(-2px);
      box-shadow:
        inset 0 1px 0 0 var(--lt-glass-rim),
        inset 0 0 0 0.6px var(--lt-glass-edge),
        0 12px 28px -12px hsl(215 45% 18% / 0.34);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-btn,
    .lt-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>
