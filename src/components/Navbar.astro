---
import AppIcon from "./AppIcon.astro";
import Icon from "./Icon.astro";
import { PUBLISHED_LOCALES } from "../i18n/locales";
import {
  pathInLocale,
  localeMeta,
  resolveLocale,
  routeUrl,
  useTranslations,
} from "../i18n/ui";

const locale = resolveLocale(Astro.currentLocale);
const meta = localeMeta(locale);
const t = useTranslations(locale);

/*
 * Route keys, not paths. `routeUrl()` resolves each one against the locale's
 * translated-route table, so on `/en/` the links to pages English does not have
 * point at the Chinese original *directly* rather than at a redirect stub.
 */
const links = [
  { route: "home", label: t("nav.home") },
  { route: "features", label: t("nav.features") },
  { route: "download", label: t("nav.download") },
  { route: "community", label: t("nav.community") },
  { route: "status", label: t("nav.status") },
  { route: "brand", label: t("nav.brand") },
  { route: "legal", label: t("nav.legal") },
] as const;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const base = href.replace(/\/+$/, "") || "/";
  return base === "/" ? path === "/" : path === base || path.startsWith(`${base}/`);
};

/*
 * Where the same page lives in each language, for the switcher.
 *
 * `?lang=` is what tells the edge middleware this navigation is an *explicit*
 * choice: it records the cookie that suppresses `Accept-Language` auto-detection
 * and then 302s to the same URL without the parameter, so the address bar ends up
 * clean and shareable. Detection alone cannot tell "clicked 简体中文" from
 * "followed a link to an untranslated page", and getting that wrong would either
 * bounce the visitor back to English on their next visit or silently flip their
 * preference when they open `/status` from `/en/`.
 *
 * `data-astro-reload` is required for that to work: under Client Router the
 * navigation would be a fetch, whose 302 is followed transparently, and
 * `history.pushState` would then leave `?lang=` in the address bar.
 */
const languageLinks = PUBLISHED_LOCALES.map((target) => {
  const href = pathInLocale(Astro.url.pathname, target.code);
  const separator = href.includes("?") ? "&" : "?";
  return {
    code: target.code,
    label: target.label,
    hreflang: target.hreflang,
    href: `${href}${separator}lang=${target.code}`,
    current: target.code === locale,
  };
});

/*
 * The persisted element's name carries the locale.
 *
 * `transition:persist` keeps this navbar's DOM across client-side navigations, so
 * a navigation that changes language (`/en/` → `/download`, which is Chinese)
 * would otherwise leave the *old* language's labels on screen — the swap never
 * touches a persisted element. Keying the name by locale makes a language change
 * a different persist identity, so Astro renders the new bar fresh while
 * same-locale navigations still get the cheap persist.
 */
const persistName = `lt-navbar-${locale}`;
---

<!-- Geometry (top/left/right insets, radius, glass) lives entirely in the
     scoped `.lt-navbar` rule below; no positioning utilities here so markup
     and CSS can never disagree about where the bar sits. -->
<nav id="lt-navbar" class="lt-navbar fixed z-50" transition:persist={persistName}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href={routeUrl(locale, "home")} class="flex items-center gap-2 text-title-large font-bold text-on-surface no-underline state-layer rounded-control px-2 py-1">
          <!-- Decorative: the wordmark text beside it is the link's accessible
               name. An alt here would make a screen reader say "Luotopia
               Luotopia". -->
          <AppIcon class="w-8 h-8" size={32} plate alt="" />
          Luotopia
    </a>

    <div class="hidden md:flex items-center gap-0.5">
      {
        links.map((link) => (
          <a
            href={routeUrl(locale, link.route)}
            aria-current={isActive(routeUrl(locale, link.route)) ? "page" : undefined}
            class="lt-navlink state-layer rounded-control px-3.5 py-2 text-body-large text-on-surface-variant no-underline transition-colors"
          >
            {link.label}
          </a>
        ))
      }

      <!--
        `<details>`, not a JS popover: the disclosure is native, so the switcher
        still works with scripting off — the same contract the rest of the site
        keeps. The script below only adds what `<details>` cannot do itself
        (close on outside click, on Escape, and before a client navigation).

        Opaque surface rather than glass. The navbar is already a backdrop root,
        so a translucent panel hanging off it would sample the bar's own fill and
        read as flat; `docs/development.md` calls this out for overlays.
      -->
      <details class="lt-lang" data-lang-menu>
        <summary
          class="lt-lang-summary state-layer rounded-control px-2.5 py-2 ml-1 text-body-large text-on-surface-variant cursor-pointer list-none"
          aria-label={t("lang.switcher.label")}
          title={t("lang.switcher.label")}
        >
          <Icon name="language" class="text-lg" />
          <span class="lt-lang-current">{meta.label}</span>
        </summary>
        <div class="lt-lang-panel rounded-nested" role="group" aria-label={t("lang.switcher.label")}>
          {
            languageLinks.map((link) => (
              <a
                class="lt-lang-option state-layer text-body-large no-underline"
                href={link.href}
                hreflang={link.hreflang}
                lang={link.code}
                aria-current={link.current ? "true" : undefined}
                data-astro-reload
                data-astro-prefetch={false}
              >
                {link.label}
                {link.current && <span class="lt-lang-tick" aria-hidden="true" />}
              </a>
            ))
          }
        </div>
      </details>

      <button id="theme-toggle" class="state-layer rounded-control p-2 ml-1 text-on-surface-variant transition-colors cursor-pointer" aria-label={t("nav.themeToggle.aria")} aria-pressed="false">
        <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42"/></svg>
      </button>
    </div>

    <button id="mobile-menu-btn" class="lt-burger md:hidden state-layer rounded-control p-2 text-on-surface-variant cursor-pointer" aria-label={t("nav.menu")} aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="lt-burger-l" d="M3 6h18" />
        <path class="lt-burger-m" d="M3 12h18" />
        <path class="lt-burger-b" d="M3 18h18" />
      </svg>
    </button>
  </div>
</nav>

<!--
  A sibling of the nav, not a child of it, for two reasons that are easy to miss:

  1. Layout. The collapse below is clip-path + opacity + visibility, and all
     three are paint-only — a closed sheet kept reserving its full ~270px inside
     the fixed nav, so the nav's border box (background, blur, border-bottom,
     shadow) hung a third of the way down the viewport whether or not the menu
     was open. Out of flow, the nav is exactly the bar again.

  2. Backdrop root. The nav carries `backdrop-filter`, which makes it the
     containing block for fixed/absolute descendants *and* the backdrop root
     their own filters sample from. It only paints that backdrop inside its own
     4rem box, so a sheet hanging below it would have had nothing to refract and
     would have rendered as a flat translucent tint.

  Geometry comes from the scoped `.lt-mobile-menu` rule, same as the bar's:
  both float 12px in from the viewport edges, and the sheet's top (88px)
  clears the bar's rounded bottom (12 + 64 + 1px border) by the same 12px
  gap, so the pair reads as one floating composition rather than one
  surface bleeding into the next.

  Full viewport height, not content height: while the sheet is open Lenis is
  stopped, so with a content-sized sheet the strip of page below it sat in the
  worst possible state — clickable, but not scrollable. The glass now runs to
  the bottom edge and swallows those clicks; the clip-path collapse hides the
  tall sheet just the same when closed.
-->
<div
  id="mobile-menu"
  class="lt-mobile-menu fixed z-40 overflow-y-auto md:hidden"
  data-open="false"
  transition:persist={`lt-mobile-menu-${locale}`}
>
  <div class="px-4 py-3 flex flex-col gap-0.5">
    {
      links.map((link) => (
        <a
          href={routeUrl(locale, link.route)}
          aria-current={isActive(routeUrl(locale, link.route)) ? "page" : undefined}
            class="lt-navlink state-layer rounded-control px-3 py-2.5 text-body-large text-on-surface-variant no-underline"
        >
          {link.label}
        </a>
      ))
    }

    <!--
      Sits at position 8 in the sheet, which matters: the entrance stagger is
      defined per `nth-child(1)`…`nth-child(7)` on `.lt-navlink`, so this block
      and the theme button below it get no delay and cannot shift the seven
      links' timing. A flat grid rather than the desktop's `<details>` — the
      sheet is already a vertical list, and nesting a disclosure inside it would
      put a collapsible region inside a collapsible region.
    -->
    <div class="lt-lang-mobile mt-2 pt-3 border-t border-glass-divider">
      <p class="lt-navlabel px-3 pb-1.5 text-label-medium text-outline">{t("lang.switcher.label")}</p>
      <div class="grid grid-cols-2 gap-0.5">
        {
          languageLinks.map((link) => (
            <a
              class="lt-lang-chip state-layer rounded-control px-3 py-2 text-body-medium text-on-surface-variant no-underline"
              href={link.href}
              hreflang={link.hreflang}
              lang={link.code}
              aria-current={link.current ? "true" : undefined}
              data-astro-reload
              data-astro-prefetch={false}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <button id="theme-toggle-mobile" class="lt-navlink state-layer rounded-control px-3 py-2.5 text-body-large text-on-surface-variant cursor-pointer text-left bg-transparent border-none" aria-label={t("nav.themeToggle.aria")} aria-pressed="false">
      {t("nav.themeToggle.label")}
    </button>
  </div>
</div>

<style>
  .lt-navbar {
    top: 12px;
    left: 12px;
    right: 12px;
    max-width: 1152px;
    margin-inline: auto;
    border-radius: 24px;
    border: 1px solid var(--lt-glass-edge);
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-shadow-glass);
    backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    -webkit-backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    transition:
      background-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      -webkit-backdrop-filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
   * `data-menu-open` shares the scrolled treatment on purpose. At rest the bar
   * is transparent, so an open sheet was compositing its own 0.8 tint over
   * nothing but the hero — the page showed straight through both layers and the
   * menu read as under-frosted. Forcing the bar's glass whenever the sheet is
   * open stacks the two tints (~96% opaque) and the pair reads as one object.
   */
  .lt-navbar[data-scrolled="true"],
  .lt-navbar[data-menu-open="true"] {
    /* Only the fill and the elevation actually differ from the resting bar.
     * The border color and backdrop-filter this rule used to restate were
     * byte-identical to the base declarations — dead weight. (The base
     * `transition` still lists backdrop-filter, and that entry is not dead:
     * it carries the saturate token change across a theme flip.) */
    background-color: var(--lt-glass-navbar);
    box-shadow: var(--lt-shadow-glass-raised);
  }

  :global(#lt-navbar .lt-app-plate) {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .lt-navlink {
    color: var(--lt-color-on-surface-variant);
  }

  /* Pointer-gated: on touch, `:hover` would stick to the last tapped link
   * until something else is tapped — a permanent wrong "active" tint. */
  @media (hover: hover) {
    .lt-navlink:hover {
      color: var(--lt-color-primary);
    }
  }

  .lt-navlink[aria-current="page"] {
    color: var(--lt-color-primary);
    font-weight: 500;
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-glass-optics), inset 0 0 0 1px var(--lt-glass-edge);
  }

  /*
   * Language switcher.
   *
   * The panel is opaque (`--lt-color-surface`), not glass. Two reasons, both from
   * the glass rules in `docs/development.md`: the navbar is already a backdrop
   * root, so a translucent child samples the bar's own fill and reads as flat
   * rather than as depth; and a floating overlay that fades in is exactly the
   * case the docs say should use an opaque surface. It gets the raised shadow so
   * it still separates from the bar it hangs off.
   */
  .lt-lang {
    position: relative;
  }

  .lt-lang-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--lt-color-on-surface-variant);
    /* The native disclosure triangle, in both of its spellings. */
    list-style: none;
  }

  .lt-lang-summary::-webkit-details-marker {
    display: none;
  }

  .lt-lang-summary:hover {
    color: var(--lt-color-primary);
  }

  /* Endonyms can be long (the Vietnamese one is two words); the summary must not push the theme
   * toggle off the bar at the narrow end of the desktop breakpoint. */
  .lt-lang-current {
    max-width: 7.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lt-lang-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 60;
    min-width: 11rem;
    padding: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    background-color: var(--lt-color-surface);
    border: 1px solid var(--lt-glass-edge);
    box-shadow: var(--lt-shadow-glass-raised);
  }

  .lt-lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    color: var(--lt-color-on-surface-variant);
    transition: color 0.2s ease;
  }

  .lt-lang-option[aria-current="true"] {
    color: var(--lt-color-primary);
    font-weight: 500;
  }

  /*
   * A dot rather than a checkmark: the options are already ordered with the
   * current one marked by colour and weight, and an 8px mark is enough to make
   * the selection findable by shape for anyone the colour does not reach.
   */
  .lt-lang-tick {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background-color: currentColor;
    flex: none;
  }

  .lt-navlabel {
    letter-spacing: 0.04em;
  }

  .lt-lang-chip {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--lt-color-on-surface-variant);
    transition: color 0.2s ease;
  }

  .lt-lang-chip[aria-current="true"] {
    color: var(--lt-color-primary);
    font-weight: 500;
    background-color: var(--lt-glass-control);
    box-shadow: inset 0 0 0 1px var(--lt-glass-edge);
  }

  .lt-navbar :is(a, button):focus-visible,
  .lt-mobile-menu :is(a, button):focus-visible {
    outline: 2px solid var(--lt-color-primary);
    outline-offset: 3px;
  }

  /*
   * Same glass tokens as the bar, so the two read as one continuous surface
   * across the seam. It has to declare them itself now that it sits outside the
   * nav — see the markup comment for why it moved.
   *
   * Collapse is clip-path + opacity + transform. It replaced, in order:
   *
   * - `hidden`, which is `display: none` and therefore not animatable at all —
   *   the sheet snapped open in a single frame.
   * - `grid-template-rows: 0fr -> 1fr`, which does animate but is a *layout*
   *   animation: every frame re-laid-out the bar and changed the area the
   *   backdrop-filter had to sample. Paired with a hard ease-out that is already
   *   ~87% of the way there at the halfway mark, the back half of the duration
   *   crawled through the final few pixels and then `visibility` snapped — the
   *   hitch at the tail of the close.
   *
   * clip-path leaves the element's box alone, so nothing re-lays-out and the
   * compositor can carry it. The close also gets a shorter, symmetric curve so
   * it finishes decisively, and `opacity` runs faster than the clip: the links
   * are already gone by the time the wipe reaches them, so there is no sliver
   * left to blink out when `visibility` flips.
   *
   * The corollary is that none of these three take the sheet out of layout, so
   * the element itself has to be out of flow — otherwise the closed sheet's
   * reserved height shows up as a permanent empty panel behind the bar.
   *
   * `visibility` (not `display`) is what keeps the links out of the tab order
   * while closed, and unlike `display: none` it does not fight Tailwind's
   * layered `md:hidden` on desktop.
   */
  .lt-mobile-menu {
    top: 88px;
    left: 12px;
    right: 12px;
    height: calc(100vh - 100px);
    height: calc(100dvh - 100px);
    max-height: calc(100vh - 100px);
    border-radius: 24px;
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-shadow-glass);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transform: translateY(-8px);
    background-color: var(--lt-glass-navbar);
    backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    -webkit-backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    transition:
      clip-path 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease,
      visibility 0s linear 0.32s;
  }

  .lt-mobile-menu[data-open="true"] {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: none;
    transition:
      clip-path 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.22s ease,
      visibility 0s;
  }

  /* Items trail the sheet by a few frames each, so opening reads as one gesture
   * rather than a block of links materialising.
   *
   * The stagger is a custom property consumed by the opacity/transform entries
   * only — deliberately *not* a blanket `transition-delay`. The delay would
   * also sit on the `color` transition, and then a theme flip with the sheet
   * open recoloured the links one by one down the list (each waiting out its
   * opening stagger), with the theme button — the last child — lagging worst. */
  .lt-mobile-menu .lt-navlink {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.26s ease var(--lt-nav-stagger, 0s),
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-nav-stagger, 0s),
      color 0.2s ease;
  }

  .lt-mobile-menu[data-open="true"] .lt-navlink {
    opacity: 1;
    transform: none;
  }

  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(1) { --lt-nav-stagger: 0.07s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(2) { --lt-nav-stagger: 0.11s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(3) { --lt-nav-stagger: 0.15s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(4) { --lt-nav-stagger: 0.19s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(5) { --lt-nav-stagger: 0.23s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(6) { --lt-nav-stagger: 0.27s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(7) { --lt-nav-stagger: 0.31s; }

  /*
   * Burger -> X. Each bar rotates about its own midpoint and then slides to the
   * shared centre line, so the two strokes cross exactly at (12,12); rotating
   * about the viewBox centre instead would throw the diagonals off-axis.
   */
  .lt-burger path {
    transform-box: view-box;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.18s ease;
  }

  .lt-burger-l { transform-origin: 12px 6px; }
  .lt-burger-m { transform-origin: 12px 12px; }
  .lt-burger-b { transform-origin: 12px 18px; }

  .lt-burger[aria-expanded="true"] .lt-burger-l { transform: translateY(6px) rotate(45deg); }
  .lt-burger[aria-expanded="true"] .lt-burger-m { opacity: 0; transform: scaleX(0.3); }
  .lt-burger[aria-expanded="true"] .lt-burger-b { transform: translateY(-6px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .lt-navbar,
    .lt-mobile-menu,
    .lt-mobile-menu .lt-navlink,
    .lt-lang-option,
    .lt-lang-chip,
    .lt-burger path {
      transition: none;
    }

    .lt-mobile-menu .lt-navlink {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const navbar = document.getElementById("lt-navbar");
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
  const isActivePath = (href: string, path: string) => {
    const base = normalizePath(new URL(href, location.href).pathname);
    return base === "/" ? path === "/" : path === base || path.startsWith(`${base}/`);
  };

  function syncActiveLinks() {
    const path = normalizePath(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>("a.lt-navlink[href]").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;
      if (isActivePath(href, path)) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  const themeToggles = [
    document.getElementById("theme-toggle"),
    document.getElementById("theme-toggle-mobile"),
  ];

  // `aria-pressed` mirrors the resolved theme so assistive tech hears the
  // state, not just the action. Seeded at module execution — the <head>
  // inline resolver has already run by then — and on every flip.
  const syncThemePressed = () => {
    const dark = document.documentElement.classList.contains("dark");
    for (const btn of themeToggles) btn?.setAttribute("aria-pressed", String(dark));
  };

  const syncTheme = () => {
    const html = document.documentElement;
    const dark = html.classList.toggle("dark");
    // Storage can throw in the same restricted WebViews / private modes the
    // head script defends against; a click handler is the wrong place to crash.
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch (e) {}
    syncThemePressed();
  };
  themeToggles[0]?.addEventListener("click", syncTheme);
  themeToggles[1]?.addEventListener("click", syncTheme);
  syncThemePressed();

  const isOpen = () => mobileMenu?.dataset.open === "true";
  const setOpen = (open: boolean) => {
    if (!mobileMenu || !menuBtn) return;
    mobileMenu.dataset.open = String(open);
    menuBtn.setAttribute("aria-expanded", String(open));
    // Drives the bar's glass as well as the sheet's — see data-menu-open above.
    navbar?.setAttribute("data-menu-open", String(open));
    // Lenis owns the scroll position, so `body { overflow: hidden }` alone
    // would not stop the page drifting behind an open sheet.
    const lenis = (window as unknown as { ltLenis?: { stop(): void; start(): void } }).ltLenis;
    if (open) lenis?.stop();
    else lenis?.start();
  };

  const closeMenuForNavigation = () => {
    if (!isOpen()) return;
    // The sheet persists across client navigations. If focus is left on one of
    // its links, Astro would restore focus to a control that is now hidden.
    const active = document.activeElement;
    if (active instanceof HTMLElement && mobileMenu?.contains(active)) active.blur();
    setOpen(false);
  };

  /*
   * `<details>` opens and closes natively, which is what keeps the switcher
   * usable with scripting off. Everything below only adds the three things the
   * element cannot do for itself: close when the pointer goes elsewhere, close on
   * Escape, and close before a client-side navigation (the element persists, so
   * an open panel would otherwise survive onto the next page).
   */
  const langMenu = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");
  const closeLangMenu = () => {
    if (langMenu && langMenu.open) langMenu.open = false;
  };

  if (langMenu) {
    document.addEventListener("click", (event) => {
      if (!langMenu.open) return;
      const target = event.target;
      if (target instanceof Node && langMenu.contains(target)) return;
      closeLangMenu();
    });
  }

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => setOpen(!isOpen()));
    mobileMenu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    // Crossing into the desktop breakpoint hides the trigger, so the sheet would
    // otherwise stay open with nothing on screen to close it.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }

  // Outside the guard above: Escape should dismiss the language panel even on a
  // page where the mobile sheet's trigger never rendered.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (isOpen()) setOpen(false);
    closeLangMenu();
  });

  const threshold = 12;
  // Write the attribute only when the state actually flips. Under Lenis the
  // scroll event fires every frame; an unconditional setAttribute pushed a
  // mutation (and a potential style-invalidation check) through the navbar on
  // each one — right when the bar is also transitioning its backdrop blur.
  let lastScrolled: boolean | null = null;
  const syncScrolled = () => {
    if (!navbar) return;
    const scrolled = window.scrollY > threshold;
    if (scrolled === lastScrolled) return;
    lastScrolled = scrolled;
    navbar.setAttribute("data-scrolled", String(scrolled));
  };
  if (navbar) {
    syncScrolled();
    window.addEventListener("scroll", syncScrolled, { passive: true });
  }

  // The navbar and sheet persist across client navigations, so their listeners
  // are bound once. Their route-dependent state still has to be resynchronized,
  // and an open sheet must not survive navigation.
  document.addEventListener("astro:before-preparation", () => {
    closeMenuForNavigation();
    closeLangMenu();
  });

  document.addEventListener("astro:page-load", () => {
    closeMenuForNavigation();
    syncActiveLinks();
    // Force one unconditional write: cheap insurance in case the persisted
    // element and the memo ever disagree (e.g. a failed persist).
    lastScrolled = null;
    syncScrolled();
  });
</script>
