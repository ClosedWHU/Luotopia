---
import AppIcon from "./AppIcon.astro";
import Icon from "./Icon.astro";
import { PUBLISHED_LOCALES } from "../i18n/locales";
import {
  pathInLocale,
  localeMeta,
  resolveLocale,
  routeUrl,
  useTranslations,
} from "../i18n/ui";

const locale = resolveLocale(Astro.currentLocale);
const meta = localeMeta(locale);
const t = useTranslations(locale);

/*
 * Route keys, not paths. `routeUrl()` resolves each one against the locale's
 * translated-route table, so on `/en/` the links to pages English does not have
 * point at the Chinese original *directly* rather than at a redirect stub.
 */
const links = [
  { route: "home", label: t("nav.home") },
  { route: "features", label: t("nav.features") },
  { route: "download", label: t("nav.download") },
  { route: "community", label: t("nav.community") },
  { route: "status", label: t("nav.status") },
  // The docs site (merged from Luotopia-Docs, served under /docs) is zh-Hans only,
  // so unlike every other entry it has no per-locale URL — one href for all.
  // Label is the short nav.docs ("文档"), not the footer's "文档中心": eight
  // items leave no room for the longer form at the breakpoint floor.
  { href: "/docs/", label: t("nav.docs") },
  { route: "brand", label: t("nav.brand") },
  { route: "legal", label: t("nav.legal") },
] as const;

const linkHref = (link: (typeof links)[number]) =>
  "href" in link ? link.href : routeUrl(locale, link.route);

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
/*
 * The locale root matches exactly, never as a prefix.
 *
 * Every page of a prefixed locale lives under its root, so prefix-matching `/en`
 * marks Home active on `/en/features`, `/en/status` and the rest — Home was
 * pinned on for the whole visit in all nine non-default languages. The
 * `base === "/"` test this replaces expressed the same idea but only caught the
 * default locale, whose root happens to be `/`. Deeper tabs keep the prefix
 * match: 法律 has to stay lit on `/legal/terms`.
 */
const localeRoot = routeUrl(locale, "home").replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const base = href.replace(/\/+$/, "") || "/";
  return base === localeRoot
    ? path === base
    : path === base || path.startsWith(`${base}/`);
};

/*
 * Where the same page lives in each language, for the switcher.
 *
 * The href is the destination itself, with no `?lang=` and therefore no redirect
 * in the click path. It used to carry `?lang=` so the edge middleware could record
 * the choice and 302 to the clean URL, on the theory that the route had to be
 * opted out of Client Router for that to work — but the opt-out attribute that
 * theory relied on, `data-astro-reload`, does not exist in Astro 7 (it is absent
 * from the whole package), so every switcher click went through Client Router's
 * fetch-and-swap path with a 302 in the middle. Linking straight at the target
 * removes the redirect, and the route survives because the href *is* the route.
 *
 * The preference cookie is written on click instead — see the script below. The
 * middleware still honours `?lang=`, which is what the app uses on the deep-link
 * host and what a no-JS or scripted caller gets; it is just no longer on the
 * switcher's critical path.
 *
 * `data-astro-prefetch={false}` does work: Astro's `elMatchesStrategy` returns
 * false for the literal string "false", which matters here because `prefetchAll`
 * is on and prefetching ten language copies of every page on hover is wasteful.
 */
const languageLinks = PUBLISHED_LOCALES.map((target) => ({
  code: target.code,
  label: target.label,
  hreflang: target.hreflang,
  href: pathInLocale(Astro.url.pathname, target.code),
  current: target.code === locale,
}));

/*
 * The persisted element's name carries the locale.
 *
 * `transition:persist` keeps this navbar's DOM across client-side navigations, so
 * a navigation that changes language (`/en/` → `/download`, which is Chinese)
 * would otherwise leave the *old* language's labels on screen — the swap never
 * touches a persisted element. Keying the name by locale makes a language change
 * a different persist identity, so Astro renders the new bar fresh while
 * same-locale navigations still get the cheap persist.
 */
const persistName = `lt-navbar-${locale}`;
---

<!-- Geometry (top/left/right insets, radius, glass) lives entirely in the
     scoped `.lt-navbar` rule below; no positioning utilities here so markup
     and CSS can never disagree about where the bar sits. -->
<nav id="lt-navbar" class="lt-navbar fixed z-50" aria-label={t("nav.landmark")} transition:persist={persistName}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href={routeUrl(locale, "home")} class="flex items-center gap-2 text-title-large font-bold text-on-surface no-underline state-layer rounded-control px-2 py-1">
          <!-- Decorative: the wordmark text beside it is the link's accessible
               name. An alt here would make a screen reader say "Luotopia
               Luotopia". -->
          <AppIcon class="w-8 h-8" size={32} plate alt="" />
          Luotopia
    </a>

    <div class="hidden lg:flex items-center gap-0.5">
      {
        links.map((link) => (
          <a
            href={linkHref(link)}
            aria-current={isActive(linkHref(link)) ? "page" : undefined}
            class="lt-navlink state-layer rounded-control px-3.5 py-2 text-body-large text-on-surface-variant no-underline transition-colors"
          >
            {link.label}
          </a>
        ))
      }

      <!--
        `<details>`, not a JS popover: the disclosure is native, so the switcher
        still works with scripting off — the same contract the rest of the site
        keeps. The script below only adds what `<details>` cannot do itself
        (close on outside click, on Escape, and before a client navigation).

        Opaque surface rather than glass. The navbar is already a backdrop root,
        so a translucent panel hanging off it would sample the bar's own fill and
        read as flat; `docs/development.md` calls this out for overlays.
      -->
      <details class="lt-lang" data-lang-menu>
        <summary
          class="lt-lang-summary state-layer rounded-control px-2.5 py-2 ml-1 text-body-large text-on-surface-variant cursor-pointer list-none"
          aria-label={t("lang.switcher.label")}
          title={t("lang.switcher.summary", { label: meta.label })}
        >
          <Icon name="language" class="text-lg" />
          <span class="lt-lang-current hidden lg:inline">{meta.label}</span>
        </summary>
        <div class="lt-lang-panel rounded-nested" role="group" aria-label={t("lang.switcher.label")}>
          <div class="lt-lang-scroll lt-scroll-y" data-lenis-prevent>
            {
              languageLinks.map((link) => (
                <a
                  class="lt-lang-option state-layer text-body-large no-underline"
                  href={link.href}
                  hreflang={link.hreflang}
                  lang={link.code}
                  aria-current={link.current ? "true" : undefined}
                  data-lt-lang={link.code}
                  data-astro-prefetch={false}
                >
                  {link.label}
                  {link.current && <span class="lt-lang-tick" aria-hidden="true" />}
                </a>
              ))
            }
          </div>
        </div>
      </details>

      <button id="theme-toggle" class="state-layer rounded-control p-2 ml-1 text-on-surface-variant transition-colors cursor-pointer" aria-label={t("nav.themeToggle.aria")} aria-pressed="false">
        <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42"/></svg>
      </button>
    </div>

          <button id="mobile-menu-btn" class="lt-burger lg:hidden state-layer rounded-control p-2 text-on-surface-variant cursor-pointer" aria-label={t("nav.menu")} aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path class="lt-burger-l" d="M3 6h18" />
        <path class="lt-burger-m" d="M3 12h18" />
        <path class="lt-burger-b" d="M3 18h18" />
      </svg>
    </button>
  </div>
</nav>

<!--
  A sibling of the nav, not a child of it, for two reasons that are easy to miss:

  1. Layout. The collapse below is clip-path + opacity + visibility, and all
     three are paint-only — a closed sheet kept reserving its full ~270px inside
     the fixed nav, so the nav's border box (background, blur, border-bottom,
     shadow) hung a third of the way down the viewport whether or not the menu
     was open. Out of flow, the nav is exactly the bar again.

  2. Backdrop root. The nav carries `backdrop-filter`, which makes it the
     containing block for fixed/absolute descendants *and* the backdrop root
     their own filters sample from. It only paints that backdrop inside its own
     4rem box, so a sheet hanging below it would have had nothing to refract and
     would have rendered as a flat translucent tint.

  Geometry comes from the scoped `.lt-mobile-menu` rule, same as the bar's:
  both float 12px in from the viewport edges, and the sheet's top (88px)
  clears the bar's rounded bottom (12 + 64 + 1px border) by the same 12px
  gap, so the pair reads as one floating composition rather than one
  surface bleeding into the next.

  Full viewport height, not content height: while the sheet is open Lenis is
  stopped, so with a content-sized sheet the strip of page below it sat in the
  worst possible state — clickable, but not scrollable. The glass now runs to
  the bottom edge and swallows those clicks; the clip-path collapse hides the
  tall sheet just the same when closed.
-->
<div
  id="mobile-menu"
    class="lt-mobile-menu fixed z-40 lg:hidden"
  data-open="false"
  transition:persist={`lt-mobile-menu-${locale}`}
>
  <!--
    The sheet clips, this child scrolls — see the same note on `.lt-lang-panel`.
    A 24px radius on a scroll container does not round its own scrollbar, so
    without the wrapper the bar ran the full straight height of the border box and
    its ends sat outside the rounded silhouette. Everything geometric and glassy
    stays on the outer element: it is the backdrop root, the `clip-path` collapse
    target and the persisted node, and moving any of those inward would change
    what the animation and the blur sample.
  -->
  <div class="lt-mobile-menu-scroll lt-scroll-y" data-lenis-prevent>
    <div class="px-4 py-3 flex flex-col gap-0.5">
      {
        links.map((link) => (
          <a
            href={linkHref(link)}
            aria-current={isActive(linkHref(link)) ? "page" : undefined}
              class="lt-navlink state-layer rounded-control px-3 py-2.5 text-body-large text-on-surface-variant no-underline"
          >
            {link.label}
          </a>
        ))
      }

      <!--
        Sits at position 9 in the sheet, which matters: the entrance stagger is
        defined per `nth-child(1)`…`nth-child(8)` on `.lt-navlink`, so this block
        and the theme button below it get no delay and cannot shift the eight
        links' timing. A flat grid rather than the desktop's `<details>` — the
        sheet is already a vertical list, and nesting a disclosure inside it would
        put a collapsible region inside a collapsible region.
      -->
      <div class="lt-lang-mobile mt-2 pt-3 border-t border-glass-divider">
        <p class="lt-navlabel px-3 pb-1.5 text-label-medium text-outline">{t("lang.switcher.label")}</p>
        <div class="grid grid-cols-2 gap-0.5">
          {
            languageLinks.map((link) => (
              <a
                class="lt-lang-chip state-layer rounded-control px-3 py-2 text-body-medium text-on-surface-variant no-underline"
                href={link.href}
                hreflang={link.hreflang}
                lang={link.code}
                aria-current={link.current ? "true" : undefined}
                data-lt-lang={link.code}
                data-astro-prefetch={false}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <button id="theme-toggle-mobile" class="lt-navlink state-layer rounded-control px-3 py-2.5 text-body-large text-on-surface-variant cursor-pointer text-left bg-transparent border-none" aria-label={t("nav.themeToggle.aria")} aria-pressed="false">
        {t("nav.themeToggle.label")}
      </button>
    </div>
  </div>
</div>

<style>
  .lt-navbar {
    top: 12px;
    left: 12px;
    right: 12px;
    max-width: 1152px;
    margin-inline: auto;
    border-radius: 24px;
    border: 1px solid var(--lt-glass-edge);
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-shadow-glass);
    backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    -webkit-backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    transition:
      background-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      -webkit-backdrop-filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
   * `data-menu-open` shares the scrolled treatment on purpose. At rest the bar
   * is transparent, so an open sheet was compositing its own 0.8 tint over
   * nothing but the hero — the page showed straight through both layers and the
   * menu read as under-frosted. Forcing the bar's glass whenever the sheet is
   * open stacks the two tints (~96% opaque) and the pair reads as one object.
   */
  .lt-navbar[data-scrolled="true"],
  .lt-navbar[data-menu-open="true"] {
    /* Only the fill and the elevation actually differ from the resting bar.
     * The border color and backdrop-filter this rule used to restate were
     * byte-identical to the base declarations — dead weight. (The base
     * `transition` still lists backdrop-filter, and that entry is not dead:
     * it carries the saturate token change across a theme flip.) */
    background-color: var(--lt-glass-navbar);
    box-shadow: var(--lt-shadow-glass-raised);
  }

  :global(#lt-navbar .lt-app-plate) {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .lt-navlink {
    color: var(--lt-color-on-surface-variant);
  }

  /* Pointer-gated: on touch, `:hover` would stick to the last tapped link
   * until something else is tapped — a permanent wrong "active" tint. */
  @media (hover: hover) {
    .lt-navlink:hover {
      color: var(--lt-color-primary);
    }
  }

  .lt-navlink[aria-current="page"] {
    color: var(--lt-color-primary);
    font-weight: 500;
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-glass-optics), inset 0 0 0 1px var(--lt-glass-edge);
  }

  /*
   * Language switcher.
   *
   * The panel is opaque (`--lt-color-surface`), not glass. Two reasons, both from
   * the glass rules in `docs/development.md`: the navbar is already a backdrop
   * root, so a translucent child samples the bar's own fill and reads as flat
   * rather than as depth; and a floating overlay that fades in is exactly the
   * case the docs say should use an opaque surface. It gets the raised shadow so
   * it still separates from the bar it hangs off.
   */
  .lt-lang {
    position: relative;
  }

  .lt-lang-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--lt-color-on-surface-variant);
    /* The native disclosure triangle, in both of its spellings. */
    list-style: none;
  }

  .lt-lang-summary::-webkit-details-marker {
    display: none;
  }

  .lt-lang-summary:hover {
    color: var(--lt-color-primary);
  }

  /*
   * The current language's endonym, hidden below `lg`.
   *
   * The bar at its desktop floor (`lg`, 1024px — raised from `md` when the
   * docs entry made eight links; below the floor the burger sheet takes over)
   * has to fit the brand, eight nav links, this switcher and the theme toggle
   * inside `max-w-6xl` minus padding, and the link row does not wrap — it
   * overflows, which at 768–1023px used to stand the labels on their ends
   * instead of collapsing to the sheet. English already totals ~50 characters
   * across the eight links; French and Vietnamese run longer. Dropping the
   * label to just the
   * globe below `lg` buys back ~80px exactly where the budget is tightest, and
   * costs nothing at desktop widths where there is room.
   *
   * The state is not lost when the label is: `title` carries
   * `lang.switcher.summary` ("Language: 简体中文"), and the panel names every
   * option. Icon-only is also the accessible shape here — `aria-label` still
   * describes the control.
   *
   * Endonyms can be long (the Vietnamese one is two words), hence the ellipsis.
   */
  .lt-lang-current {
    max-width: 7.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
   * Two elements, not one: the panel clips, the child scrolls.
   *
   * `border-radius` on a scroll container rounds its own background but not its
   * scrollbar — the bar is painted square across the full height of the border
   * box, so at either end of the travel it sits outside the rounded silhouette
   * instead of being cut by it. Only a *clipping ancestor* removes it, because
   * then the bar is ordinary descendant painting inside the ancestor's rounded
   * clip region. `overflow: hidden` + radius on the outer, `overflow-y: auto` on
   * the inner, is the guaranteed-cross-browser shape; a `clip-path` or a
   * `::-webkit-scrollbar-track` margin would be Blink-only guesses.
   *
   * `FriendLinks.astro`'s dialog already does exactly this (`.lt-dialog-card`
   * clips, `.lt-dialog-body` scrolls), so this is the house pattern rather than a
   * new one.
   */
  .lt-lang-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 60;
    min-width: 11rem;
    overflow: hidden;
    background-color: var(--lt-color-surface);
    border: 1px solid var(--lt-glass-edge);
    box-shadow: var(--lt-shadow-glass-raised);
  }

  .lt-lang-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.375rem;
    /*
     * Ten endonyms are ~430px of column hanging off a 64px bar, so a short
     * window puts the last few languages below the fold with no way to reach
     * them: the panel is absolutely positioned inside a fixed bar, and nothing
     * else on the page scrolls it. Capped against the viewport rather than left
     * to overflow it, on the same formula the sheet uses. The cap sits on the
     * scroller so the panel shrink-wraps it and its rounded clip follows.
     */
    max-height: calc(100vh - 100px);
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
  }

  .lt-lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    color: var(--lt-color-on-surface-variant);
    transition: color 0.2s ease;
  }

  .lt-lang-option[aria-current="true"] {
    color: var(--lt-color-primary);
    font-weight: 500;
  }

  /*
   * A dot rather than a checkmark: the options are already ordered with the
   * current one marked by colour and weight, and an 8px mark is enough to make
   * the selection findable by shape for anyone the colour does not reach.
   */
  .lt-lang-tick {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background-color: currentColor;
    flex: none;
  }

  .lt-navlabel {
    letter-spacing: 0.04em;
  }

  .lt-lang-chip {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--lt-color-on-surface-variant);
    transition: color 0.2s ease;
  }

  .lt-lang-chip[aria-current="true"] {
    color: var(--lt-color-primary);
    font-weight: 500;
    background-color: var(--lt-glass-control);
    box-shadow: inset 0 0 0 1px var(--lt-glass-edge);
  }

  .lt-navbar :is(a, button):focus-visible,
  .lt-mobile-menu :is(a, button):focus-visible {
    outline: 2px solid var(--lt-color-primary);
    outline-offset: 3px;
  }

  /*
   * Same glass tokens as the bar, so the two read as one continuous surface
   * across the seam. It has to declare them itself now that it sits outside the
   * nav — see the markup comment for why it moved.
   *
   * Collapse is clip-path + opacity + transform. It replaced, in order:
   *
   * - `hidden`, which is `display: none` and therefore not animatable at all —
   *   the sheet snapped open in a single frame.
   * - `grid-template-rows: 0fr -> 1fr`, which does animate but is a *layout*
   *   animation: every frame re-laid-out the bar and changed the area the
   *   backdrop-filter had to sample. Paired with a hard ease-out that is already
   *   ~87% of the way there at the halfway mark, the back half of the duration
   *   crawled through the final few pixels and then `visibility` snapped — the
   *   hitch at the tail of the close.
   *
   * clip-path leaves the element's box alone, so nothing re-lays-out and the
   * compositor can carry it. The close also gets a shorter, symmetric curve so
   * it finishes decisively, and `opacity` runs faster than the clip: the links
   * are already gone by the time the wipe reaches them, so there is no sliver
   * left to blink out when `visibility` flips.
   *
   * The corollary is that none of these three take the sheet out of layout, so
   * the element itself has to be out of flow — otherwise the closed sheet's
   * reserved height shows up as a permanent empty panel behind the bar.
   *
   * `visibility` (not `display`) is what keeps the links out of the tab order
   * while closed, and unlike `display: none` it does not fight Tailwind's
   * layered `lg:hidden` on desktop.
   */
  .lt-mobile-menu {
    top: 88px;
    left: 12px;
    right: 12px;
    height: calc(100vh - 100px);
    height: calc(100dvh - 100px);
    max-height: calc(100vh - 100px);
    border-radius: 24px;
    /*
     * Clips the child scroller's scrollbar to the 24px corners — the whole
     * reason the scroll moved inward. `hidden` rather than the `overflow-y: auto`
     * this element used to carry: the sheet itself must never scroll, or its bar
     * would be back outside the clip.
     */
    overflow: hidden;
    background-image: var(--lt-glass-sheen);
    box-shadow: var(--lt-shadow-glass);
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transform: translateY(-8px);
    background-color: var(--lt-glass-navbar);
    backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    -webkit-backdrop-filter: blur(var(--lt-glass-blur-navbar)) saturate(var(--lt-glass-saturate));
    transition:
      clip-path 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.32s;
  }

  /*
   * The actual scroller. Full height of the sheet, so the travel range is the
   * panel's own and the thumb reaches both rounded ends — and is cut by them.
   * `overscroll-behavior: contain` keeps a flick at either end from chaining to
   * the document behind the glass, which is the same reason the dialog body has
   * it. Lenis is stopped while the sheet is open, so this scrolls natively.
   *
   * The fade lives here, not on the sheet: the sheet is a `backdrop-filter`
   * surface, and an element below `opacity: 1` is a backdrop root, so fading the
   * sheet spent the whole open transition sampling nothing and rendering flat.
   * Fading the scroller does the same anti-sliver job the comment above assigns
   * to `opacity` — the links are gone before the wipe reaches them — on an
   * element with no blur to lose.
   */
  .lt-mobile-menu-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lt-mobile-menu[data-open="true"] {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transform: none;
    transition:
      clip-path 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  .lt-mobile-menu[data-open="true"] .lt-mobile-menu-scroll {
    opacity: 1;
    transition: opacity 0.22s ease;
  }

  /* Items trail the sheet by a few frames each, so opening reads as one gesture
   * rather than a block of links materialising.
   *
   * The stagger is a custom property consumed by the opacity/transform entries
   * only — deliberately *not* a blanket `transition-delay`. The delay would
   * also sit on the `color` transition, and then a theme flip with the sheet
   * open recoloured the links one by one down the list (each waiting out its
   * opening stagger), with the theme button — the last child — lagging worst. */
  .lt-mobile-menu .lt-navlink {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.26s ease var(--lt-nav-stagger, 0s),
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-nav-stagger, 0s),
      color 0.2s ease;
  }

  .lt-mobile-menu[data-open="true"] .lt-navlink {
    opacity: 1;
    transform: none;
  }

  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(1) { --lt-nav-stagger: 0.07s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(2) { --lt-nav-stagger: 0.11s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(3) { --lt-nav-stagger: 0.15s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(4) { --lt-nav-stagger: 0.19s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(5) { --lt-nav-stagger: 0.23s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(6) { --lt-nav-stagger: 0.27s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(7) { --lt-nav-stagger: 0.31s; }
  .lt-mobile-menu[data-open="true"] .lt-navlink:nth-child(8) { --lt-nav-stagger: 0.35s; }

  /*
   * Burger -> X. Each bar rotates about its own midpoint and then slides to the
   * shared centre line, so the two strokes cross exactly at (12,12); rotating
   * about the viewBox centre instead would throw the diagonals off-axis.
   */
  .lt-burger path {
    transform-box: view-box;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.18s ease;
  }

  .lt-burger-l { transform-origin: 12px 6px; }
  .lt-burger-m { transform-origin: 12px 12px; }
  .lt-burger-b { transform-origin: 12px 18px; }

  .lt-burger[aria-expanded="true"] .lt-burger-l { transform: translateY(6px) rotate(45deg); }
  .lt-burger[aria-expanded="true"] .lt-burger-m { opacity: 0; transform: scaleX(0.3); }
  .lt-burger[aria-expanded="true"] .lt-burger-b { transform: translateY(-6px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .lt-navbar,
    .lt-mobile-menu,
    .lt-mobile-menu .lt-navlink,
    .lt-lang-option,
    .lt-lang-chip,
    .lt-burger path {
      transition: none;
    }

    .lt-mobile-menu .lt-navlink {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { onBeforeNavigation, onPageSetup } from "../scripts/page-lifecycle";

  /** The cookie `functions/_middleware.ts` reads to stand down auto-detection. */
  const LANG_COOKIE = "luotopia_lang";

  /**
   * Record an explicit language choice.
   *
   * Done here rather than by the middleware, because the switcher links straight
   * at its destination: there is no `?lang=` round trip to hang a `Set-Cookie` on,
   * and adding one back would put a 302 in the middle of a Client Router
   * navigation. The middleware still handles `?lang=` for the app's deep links and
   * for callers without JS; this is the browser path.
   *
   * `Secure` is conditional: a Secure cookie is rejected outright on a plain-http
   * origin, which is what `wrangler pages dev` serves, and losing the preference
   * locally would make this look broken during development. Best-effort either
   * way — cookie writes can throw in the same restricted WebViews and private
   * modes the `<head>` scripts defend against, and a lost preference must not cost
   * the navigation.
   */
  function recordLanguageChoice(code: string) {
    if (!code) return;
    const secure = location.protocol === "https:" ? "; Secure" : "";
    try {
      document.cookie = `${LANG_COOKIE}=${code}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`;
    } catch (e) {}
  }

  type BeforeSwapEvent = Event & { newDocument?: Document };

  /*
   * The bar persists across same-locale navigations, and a persisted element is
   * not part of the swap — so everything the server rendered inside it stays
   * frozen on whichever page first put the bar on screen. For the switcher that
   * is load-bearing: from `/en/features/`, walking to `/en/download/` and then
   * picking 日本語 used to land on `/ja/features/`, because the hrefs still
   * described the features page. It is also why the defect reads as "switching
   * language always goes home" — a visit that starts at `/` pins every later
   * switch in that locale to `/<lang>/`, whatever page the visitor has reached
   * since.
   *
   * The hrefs are copied from the incoming document rather than recomputed here,
   * so the answer stays the server's: `pathInLocale` falls back to the default
   * locale's URL for a route the target language has not translated, and a
   * client-side second copy of `TRANSLATED_ROUTES` would eventually disagree
   * with it. It also keeps this chunk free of the locale table's endonyms.
   *
   * The nav links' `aria-current` is page-dependent in the same way and is copied
   * for the same reason. It used to be recomputed here by a second implementation
   * of the server's matching rule, and the two disagreed: the client copy tested
   * `base === "/"` to mean "this is Home, match it exactly", which is only true in
   * the default locale. In the other nine, Home's base is `/en`, `/ja`, ... — a
   * prefix of every page in that language — so Home stayed lit for the whole
   * visit. One rule, in one place, is the fix; copying is what keeps it that way.
   *
   * Bound once at module scope and querying live on both sides, for the reason
   * `onBeforeNavigation` below does — this has to survive the persist-identity
   * change a cross-locale navigation causes.
   */
  document.addEventListener("astro:before-swap", (event) => {
    const incoming = (event as BeforeSwapEvent).newDocument;
    if (!incoming) return;
    // A page with no navbar of its own (the /open/ launch page) has nothing to
    // copy from, and must not have the bar it is about to persist blanked.
    if (!incoming.getElementById("lt-navbar")) return;

    const rendered = new Map<string, string>();
    incoming.querySelectorAll<HTMLAnchorElement>("a[data-lt-lang][href]").forEach((link) => {
      const code = link.getAttribute("data-lt-lang");
      const href = link.getAttribute("href");
      if (code && href && !rendered.has(code)) rendered.set(code, href);
    });
    document.querySelectorAll<HTMLAnchorElement>("a[data-lt-lang]").forEach((link) => {
      const code = link.getAttribute("data-lt-lang");
      const href = code ? rendered.get(code) : undefined;
      if (href) link.setAttribute("href", href);
    });

    // Nav links are locale-absolute and identical in the desktop bar and the
    // mobile sheet, so the href keys both copies at once. A cross-locale swap
    // matches nothing and clears the bar that is about to be discarded anyway.
    const active = new Set<string>();
    incoming
      .querySelectorAll<HTMLAnchorElement>("a.lt-navlink[href][aria-current]")
      .forEach((link) => {
        const href = link.getAttribute("href");
        if (href) active.add(href);
      });
    document.querySelectorAll<HTMLAnchorElement>("a.lt-navlink[href]").forEach((link) => {
      const href = link.getAttribute("href") ?? "";
      if (active.has(href)) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  });

  /*
   * Transient UI has to close when a navigation is *requested*, before the fetch
   * starts. `onBeforeNavigation` binds once and never rebinds, so it queries live
   * instead of capturing elements.
   */
  onBeforeNavigation(() => {
    const sheet = document.getElementById("mobile-menu");
    if (sheet?.dataset.open === "true") {
      // If focus is left on one of the sheet's links, Astro would restore focus to
      // a control that is about to be hidden.
      const active = document.activeElement;
      if (active instanceof HTMLElement && sheet.contains(active)) active.blur();
    }
    setSheetOpen(false);
    const panel = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");
    if (panel && panel.open) panel.open = false;
  });

  /** Shared with the handler above, so it has to live at module scope. */
  function setSheetOpen(open: boolean) {
    const sheet = document.getElementById("mobile-menu");
    const btn = document.getElementById("mobile-menu-btn");
    const bar = document.getElementById("lt-navbar");
    if (!sheet || !btn) return;
    sheet.dataset.open = String(open);
    btn.setAttribute("aria-expanded", String(open));
    // Drives the bar's glass as well as the sheet's — see data-menu-open above.
    bar?.setAttribute("data-menu-open", String(open));
    // Lenis owns the scroll position, so `body { overflow: hidden }` alone would
    // not stop the page drifting behind an open sheet.
    const lenis = (window as unknown as { ltLenis?: { stop(): void; start(): void } }).ltLenis;
    if (open) lenis?.stop();
    else lenis?.start();

    /*
     * Focus follows the sheet. The sheet covers the page at ~96% opacity, so
     * leaving focus where it was lets Tab walk into links the visitor cannot
     * see, and closing while focus sat inside used to drop it to <body> — the
     * keyboard user's next Tab restarts at the top of the document.
     * `onBeforeNavigation` blurs before calling this with `false`, so the
     * navigation path still ends unfocused on purpose.
     */
    if (open) {
      const first = sheet.querySelector<HTMLElement>("a[href], button:not([disabled])");
      if (first) first.focus({ preventScroll: true });
    } else {
      const active = document.activeElement;
      if (active instanceof HTMLElement && sheet.contains(active)) {
        btn.focus({ preventScroll: true });
      }
    }
  }

  /*
   * Everything below re-runs on every navigation.
   *
   * It used to bind once at module scope, on the assumption that the navbar and
   * the sheet persist across client navigations. That holds only while the locale
   * does not change: the persist name is keyed by locale, so switching language
   * hands Astro a different persist identity and it renders a fresh bar — while
   * Astro's script deduplication means this module is *not* re-executed. Every
   * reference captured at module scope then pointed at a detached node, and after
   * a single language switch the theme toggle, the burger and the language panel
   * all silently stopped working.
   *
   * `onPageSetup()` is the documented fix (see docs/development.md): it re-runs
   * after every swap and its AbortSignal unbinds the previous set first. Re-querying
   * is also correct for the same-locale case, where the elements do persist — it
   * just returns the same nodes.
   */
  onPageSetup((signal) => {
    const navbar = document.getElementById("lt-navbar");
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const langMenu = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");

    const themeToggles = [
      document.getElementById("theme-toggle"),
      document.getElementById("theme-toggle-mobile"),
    ];

    // `aria-pressed` mirrors the resolved theme so assistive tech hears the state,
    // not just the action. The <head> inline resolver has already run by now.
    const syncThemePressed = () => {
      const dark = document.documentElement.classList.contains("dark");
      for (const btn of themeToggles) btn?.setAttribute("aria-pressed", String(dark));
    };

    const syncTheme = () => {
      const html = document.documentElement;
      const dark = html.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch (e) {}
      syncThemePressed();
    };
    for (const btn of themeToggles) btn?.addEventListener("click", syncTheme, { signal });
    syncThemePressed();

    /*
     * The language choice is recorded on a delegated listener rather than per
     * link, so the ten options in each of the two switchers cost one binding.
     * Capture phase, so the cookie is written before Client Router starts the
     * navigation it triggers off the same click.
     */
    document.addEventListener(
      "click",
      (event) => {
        const link = (event.target as HTMLElement | null)?.closest?.("[data-lt-lang]");
        const code = link?.getAttribute("data-lt-lang");
        if (code) recordLanguageChoice(code);
      },
      { signal, capture: true },
    );

    /*
     * `<details>` opens and closes natively, which is what keeps the switcher
     * usable with scripting off. This only adds what the element cannot do itself:
     * close when the pointer goes elsewhere.
     */
    if (langMenu) {
      document.addEventListener(
        "click",
        (event) => {
          if (!langMenu.open) return;
          const target = event.target;
          if (target instanceof Node && langMenu.contains(target)) return;
          langMenu.open = false;
        },
        { signal },
      );
    }

    const isOpen = () => mobileMenu?.dataset.open === "true";

    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", () => setSheetOpen(!isOpen()), { signal });
      mobileMenu.addEventListener(
        "click",
        (e) => {
          if ((e.target as HTMLElement).closest("a")) setSheetOpen(false);
        },
        { signal },
      );

      /*
       * Tab trap. `inert` on the background would be the one-line answer but is
       * Chrome 102+, above this site's floor, so the cycle is wrapped by hand:
       * forward off the sheet's last item returns to the burger, shift-tab off
       * the burger returns to the sheet's last item. Everything between those
       * two ends is plain DOM order.
       */
      const SHEET_FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
      mobileMenu.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Tab" || e.shiftKey || !isOpen()) return;
          const items = mobileMenu.querySelectorAll(SHEET_FOCUSABLE);
          if (items.length === 0) return;
          if (document.activeElement === items[items.length - 1]) {
            e.preventDefault();
            menuBtn.focus({ preventScroll: true });
          }
        },
        { signal },
      );
      menuBtn.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Tab" || !e.shiftKey || !isOpen()) return;
          const items = mobileMenu.querySelectorAll(SHEET_FOCUSABLE);
          if (items.length === 0) return;
          e.preventDefault();
          (items[items.length - 1] as HTMLElement).focus({ preventScroll: true });
        },
        { signal },
      );
      // Crossing into the desktop breakpoint hides the trigger, so the sheet would
      // otherwise stay open with nothing on screen to close it.
      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (e) => { if (e.matches && isOpen()) setSheetOpen(false); }, { signal });
    }

    // Escape dismisses both, and lives outside the guard above so the language
    // panel can be closed even where the sheet's trigger never rendered.
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return;
        if (isOpen()) setSheetOpen(false);
        if (langMenu && langMenu.open) langMenu.open = false;
      },
      { signal },
    );

    const threshold = 12;
    // Write the attribute only when the state actually flips. Under Lenis the
    // scroll event fires every frame; an unconditional setAttribute pushed a
    // mutation (and a potential style-invalidation check) through the navbar on
    // each one — right when the bar is also transitioning its backdrop blur.
    // Reset per setup: a persisted bar and a fresh one must both start honest.
    let lastScrolled: boolean | null = null;
    const syncScrolled = () => {
      if (!navbar) return;
      const scrolled = window.scrollY > threshold;
      if (scrolled === lastScrolled) return;
      lastScrolled = scrolled;
      navbar.setAttribute("data-scrolled", String(scrolled));
    };
    if (navbar) {
      syncScrolled();
      window.addEventListener("scroll", syncScrolled, { signal, passive: true });
    }
  });
</script>
