---
import Icon from "./Icon.astro";
import type { FeatureStatus } from "../config/features";
import { resolveLocale, useTranslations, type TranslationKey } from "../i18n/ui";

export interface Props {
  icon: string;
  title: string;
  description: string;
  status?: FeatureStatus;
}

const { icon, title, description, status } = Astro.props;

/**
 * An explicit map rather than a `features.status.${status}` template, so the
 * `satisfies` below fails the build if a fourth status is ever added to
 * `FeatureStatus` without a label. Building the key by concatenation would
 * typecheck today and silently render the raw key tomorrow.
 */
const STATUS_KEYS = {
  upcoming: "features.status.upcoming",
  development: "features.status.development",
} as const satisfies Record<Exclude<FeatureStatus, "released">, TranslationKey>;

/*
 * The badge label comes from the dictionary rather than from a constant in
 * `config/features.ts`: it is chrome around the data, not part of it, and it has
 * to agree with the language the rest of the card is rendered in. `status` itself
 * stays a data concern — which features are unreleased is not translatable.
 */
const t = useTranslations(resolveLocale(Astro.currentLocale));
const badge = status && status !== "released" ? t(STATUS_KEYS[status]) : undefined;
const badgeClass =
  status === "development"
    ? "lt-inset text-on-surface-variant"
    : "bg-tertiary-container text-on-tertiary-container";
---

<div class="lt-lift state-layer glass rounded-card p-5 h-full flex flex-col">
  <div class="flex items-start justify-between gap-3 mb-3.5">
    <span class="lt-icon-chip text-primary text-[22px]"><Icon name={icon} /></span>
    {badge && (
      <span class={`shrink-0 inline-block px-2 py-0.5 rounded-sm text-label-medium ${badgeClass}`}>
        {badge}
      </span>
    )}
  </div>
  <h3 class="text-title-medium text-on-surface mb-1.5">{title}</h3>
  <p class="text-body-medium text-on-surface-variant leading-relaxed">{description}</p>
</div>
