---
import { friendLinkCatalog, categoryLabels } from "../config/friendLinks";
import Icon from "./Icon.astro";

const items = friendLinkCatalog.items;
const grouped = new Map<string, typeof items>();
for (const item of items) {
  const cat = item.category || "other";
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(item);
}
const catOrder = ["feedback", "clubOrg", "partnerApp", "other"];
---

{
  catOrder.map((cat) => {
    const group = grouped.get(cat);
    if (!group) return null;
    return (
      <div class="mb-8 last:mb-0">
        <h3 class="text-title-small text-outline mb-4">{categoryLabels[cat] || cat}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {group.map((link) => {
            if (link.action.type === "dialog") {
              return (
                <button
                  type="button"
                  data-friend-link-dialog={link.id}
                  class="lt-flink state-layer flex items-center gap-3 p-3 rounded-nested cursor-pointer border-none w-full text-left"
                >
                  {link.image && (
                    <img src={link.image.url} alt="" class="w-10 h-10 rounded-full object-cover shrink-0" loading="lazy" width="40" height="40" />
                  )}
                  <div class="min-w-0 flex-1">
                    <span class="block text-title-small text-on-surface truncate">{link.title}</span>
                    <span class="block text-body-small text-on-surface-variant line-clamp-2 mt-0.5">{link.subtitle}</span>
                  </div>
                  <Icon name="chevron_right" class="text-outline text-xl shrink-0" />
                </button>
              );
            }
            if (link.action.type === "openUrl" && link.action.url) {
              return (
                <a
                  href={link.action.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="lt-flink state-layer flex items-center gap-3 p-3 rounded-nested no-underline"
                >
                  {link.image && (
                    <img src={link.image.url} alt="" class="w-10 h-10 rounded-full object-cover shrink-0" loading="lazy" width="40" height="40" />
                  )}
                  <div class="min-w-0 flex-1">
                    <span class="block text-title-small text-on-surface truncate">{link.title}</span>
                    <span class="block text-body-small text-on-surface-variant line-clamp-2 mt-0.5">{link.subtitle}</span>
                  </div>
                  <Icon name="open_in_new" class="text-outline text-xl shrink-0" />
                </a>
              );
            }
            return (
              <div class="lt-flink lt-flink-off flex items-center gap-3 p-3 rounded-nested">
                {link.image && (
                  <img src={link.image.url} alt="" class="w-10 h-10 rounded-full object-cover shrink-0" loading="lazy" width="40" height="40" />
                )}
                <div class="min-w-0 flex-1">
                  <span class="block text-title-small text-on-surface truncate">{link.title}</span>
                  <span class="block text-body-small text-on-surface-variant line-clamp-2 mt-0.5">{link.subtitle}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    );
  })
}

<dialog
  id="friend-link-dialog"
  class="lt-dialog"
  aria-labelledby="friend-link-dialog-title"
>
  <div class="lt-dialog-card w-full max-w-sm rounded-group">
    <h3
      id="friend-link-dialog-title"
      class="lt-dialog-title text-title-large text-on-surface select-text"
    ></h3>

    <div id="friend-link-dialog-scroll" class="lt-dialog-body" data-lenis-prevent>
      <div id="friend-link-dialog-image-wrap" class="lt-dialog-image-wrap" hidden>
        <img
          id="friend-link-dialog-image"
          alt=""
          width="220"
          height="220"
          class="mx-auto w-[min(220px,100%)] aspect-square rounded-nested object-contain bg-glass-subtle"
        />
      </div>
      <p
        id="friend-link-dialog-body"
        class="lt-dialog-text text-body-medium text-on-surface-variant whitespace-pre-line break-words select-text"
      ></p>
    </div>

    <div class="lt-dialog-actions">
      <a
        id="friend-link-dialog-action"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        hidden
        class="lt-dialog-cta filled-glass state-layer inline-flex items-center rounded-full px-5 py-2.5 no-underline text-label-large"
      ></a>
      <button
        type="button"
        id="friend-link-dialog-close"
        class="lt-dialog-close state-layer inline-flex items-center rounded-full px-5 py-2.5 bg-transparent text-primary border-none cursor-pointer text-label-large"
      >
        关闭
      </button>
    </div>
  </div>
</dialog>

<style>
  /*
   * Nested glass. These rows already sit on a `glass` panel, so they take a
   * translucent fill with no `backdrop-filter` of their own — the parent
   * blurred the aurora once, and blurring an already-blurred backdrop again
   * only buys a compositor layer.
   */
  .lt-flink {
    background-color: var(--lt-glass-subtle);
    box-shadow: inset 0 0 0 0.6px var(--lt-glass-edge);
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Pointer-gated: hover styles stick after taps on touch devices. */
  @media (hover: hover) {
    .lt-flink:hover {
      background-color: var(--lt-glass-control);
      box-shadow:
        inset 0 1px 0 0 var(--lt-glass-rim),
        inset 0 0 0 0.6px var(--lt-glass-edge);
      transform: translateY(-1px);
    }
  }

  /* Deliberately not `opacity`: a translucent element that is also a backdrop
   * root would stop sampling the panel behind it. */
  .lt-flink-off {
    --lt-glass-subtle: transparent;
    color: var(--lt-color-outline);
  }

  .lt-flink-off * {
    opacity: 0.65;
  }

  /*
   * Native top-layer modal.
   *
   * The previous fixed root lived inside the friend-links glass card. That card
   * has `backdrop-filter`, and `.lt-reveal-lift` can also carry a transform, so
   * it was simultaneously the containing block and the backdrop root: the
   * "full-screen" scrim was trapped around the rounded card and its blur could
   * only sample that card. `showModal()` puts this dialog in the top layer,
   * outside every page containing block, so `::backdrop` is truly viewport-wide
   * and samples the whole page.
   */
  .lt-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: hidden;
  }

  .lt-dialog[open] {
    display: grid;
    place-items: center;
  }

  .lt-dialog:not([open]) {
    display: none;
  }

  .lt-dialog::backdrop {
    background-color: var(--lt-modal-scrim);
    backdrop-filter: blur(var(--lt-modal-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--lt-modal-blur)) saturate(140%);
  }

  .lt-dialog-card {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    overflow: hidden;
    background-color: var(--lt-modal-surface);
    box-shadow: var(--lt-modal-shadow);
    color: var(--lt-color-on-surface);
  }

  .lt-dialog-title {
    flex: 0 0 auto;
    margin: 0;
    padding: 1.5rem 1.5rem 0;
  }

  .lt-dialog-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 1.5rem;
  }

  .lt-dialog-image-wrap {
    margin-top: 1.25rem;
  }

  .lt-dialog-text {
    margin: 1rem 0 0;
  }

  .lt-dialog-body > :last-child {
    margin-bottom: 1.25rem;
  }

  .lt-dialog-actions {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    padding: 1.5rem;
  }

  .lt-dialog-actions > * {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 40rem) {
    .lt-dialog-actions {
      flex-direction: row;
      justify-content: flex-end;
    }

    .lt-dialog-actions > * {
      width: auto;
    }
  }

  .lt-dialog[open]::backdrop {
    animation: lt-modal-backdrop-in 240ms ease both;
  }

  .lt-dialog[open] .lt-dialog-card {
    animation: lt-modal-card-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .lt-dialog[open][data-closing="true"]::backdrop {
    animation: lt-modal-backdrop-out 180ms ease both;
  }

  .lt-dialog[open][data-closing="true"] .lt-dialog-card {
    animation: lt-modal-card-out 180ms cubic-bezier(0.4, 0, 1, 1) both;
  }

  @keyframes lt-modal-backdrop-in {
    from {
      opacity: 0;
    }
  }

  @keyframes lt-modal-backdrop-out {
    to {
      opacity: 0;
    }
  }

  /* The card entrance animates `transform` only. An opacity fade here made the
   * whole card — including the `filled-glass` CTA inside it — a backdrop root
   * for the length of the animation: the button's blur sampled nothing,
   * rendered flat, then snapped into refraction on the final frame. The fade
   * belongs to the scrim alone; the card rides in on the motion. The *exit*
   * keeps its opacity because the card is about to be removed — a mid-flight
   * flatten has nowhere to be noticed. */
  @keyframes lt-modal-card-in {
    from {
      transform: translateY(12px) scale(0.97);
    }
  }

  @keyframes lt-modal-card-out {
    to {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
    }
  }

  /*
   * Fill, tint, blur and rim come from the shared `filled-glass` utility so this
   * reads as the same button as the hero CTA — including in dark mode, where
   * that means translucent primary90 over the dialog's own glass rather than a
   * flat pale pill. Only the hover lift is local, and it is smaller than the
   * hero's because this one sits inside an already-raised panel.
   */
  .lt-dialog-cta {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .lt-dialog-cta:hover {
      transform: translateY(-1px);
      box-shadow: var(--lt-btn-filled-shadow-hover);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-flink {
      transition: none;
    }

    /* The lift is a position change, which reduced motion covers too —
     * `transition: none` alone would leave an instant jump on hover. */
    .lt-flink:hover {
      transform: none;
    }

    .lt-dialog[open]::backdrop,
    .lt-dialog[open] .lt-dialog-card,
    .lt-dialog[open][data-closing="true"]::backdrop,
    .lt-dialog[open][data-closing="true"] .lt-dialog-card {
      animation: none;
    }

    .lt-dialog-cta,
    .lt-dialog-cta:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { friendLinkCatalog } from "../config/friendLinks";
  import { onBeforeNavigation } from "../scripts/page-lifecycle";

  interface DialogContent {
    title: string;
    body: string;
    image: string | null;
    button: { label: string; url: string } | null;
  }

  const dialogData = Object.fromEntries(
    friendLinkCatalog.items.flatMap((item) => {
      const action = item.action;
      if (action.type !== "dialog") return [];
      return [
        [
          item.id,
          {
            title: action.title ?? item.title,
            body: action.body ?? "",
            image: action.image?.url ?? null,
            button: action.button ? { label: action.button.label, url: action.button.url } : null,
          },
        ],
      ];
    }),
  ) as Record<string, DialogContent>;

  // Read at close time, not at module load. The CSS side (`animation: none`)
  // reacts live to an OS setting change; a stale JS snapshot would keep waiting
  // out a 200ms exit animation the stylesheet no longer renders — the dialog
  // freezing for a beat, then blinking out.
  const closeDuration = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 200;
  let currentDialog: HTMLDialogElement | null = null;
  let closeTimer = 0;
  let scrollLocked = false;
  let downOnScrim = false;

  function lenis() {
    return (window as unknown as { ltLenis?: { start(): void; stop(): void } }).ltLenis;
  }

  function lockScroll() {
    if (scrollLocked) return;
    scrollLocked = true;
    // Lenis owns the scroll position, so `overflow: hidden` alone would still
    // let the page drift behind the modal. `scrollbar-gutter: stable` keeps the
    // lock from shifting layout.
    const smoothScroll = lenis();
    if (smoothScroll) smoothScroll.stop();
    else document.documentElement.style.overflow = "hidden";
  }

  function unlockScroll() {
    if (!scrollLocked) return;
    scrollLocked = false;
    const smoothScroll = lenis();
    if (smoothScroll) smoothScroll.start();
    else document.documentElement.style.overflow = "";
  }

  function onClose() {
    clearTimeout(closeTimer);
    const dialog = currentDialog;
    currentDialog = null;
    if (dialog) {
      dialog.removeEventListener("cancel", onCancel);
      dialog.removeEventListener("close", onClose);
      delete dialog.dataset.closing;
    }
    unlockScroll();
  }

  function requestClose() {
    const dialog = currentDialog;
    if (!dialog?.open || dialog.dataset.closing === "true") return;
    const wait = closeDuration();
    if (!wait) {
      dialog.close();
      return;
    }
    dialog.dataset.closing = "true";
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => dialog.close(), wait);
  }

  function onCancel(event: Event) {
    event.preventDefault();
    requestClose();
  }

  function onDialogPointerDown(event: PointerEvent) {
    downOnScrim = event.target === currentDialog;
  }

  function onDialogClick(event: MouseEvent) {
    // Only close when the *press* also started on the scrim. The dialog body is
    // `select-text`; without this, starting a selection inside the card and
    // releasing over the scrim fires a click on the dialog and dismisses it
    // mid-selection.
    if (downOnScrim && event.target === currentDialog) requestClose();
    downOnScrim = false;
  }

  function teardownDialog() {
    clearTimeout(closeTimer);
    const dialog = currentDialog;
    currentDialog = null;
    if (dialog) {
      dialog.removeEventListener("cancel", onCancel);
      dialog.removeEventListener("close", onClose);
      delete dialog.dataset.closing;
      if (dialog.open) dialog.close();
    }
    unlockScroll();
  }

  function openDialog(id: string | null) {
    const data = id ? dialogData[id] : undefined;
    if (!data) return;

    const dialog = document.getElementById("friend-link-dialog") as HTMLDialogElement | null;
    const titleEl = document.getElementById("friend-link-dialog-title") as HTMLHeadingElement | null;
    const bodyEl = document.getElementById("friend-link-dialog-body") as HTMLParagraphElement | null;
    const imageWrap = document.getElementById("friend-link-dialog-image-wrap");
    const imageEl = document.getElementById("friend-link-dialog-image") as HTMLImageElement | null;
    const actionEl = document.getElementById("friend-link-dialog-action") as HTMLAnchorElement | null;
    const closeEl = document.getElementById("friend-link-dialog-close") as HTMLButtonElement | null;
    if (!dialog || typeof dialog.showModal !== "function" || !titleEl || !bodyEl || !imageWrap || !imageEl || !actionEl || !closeEl) {
      return;
    }

    teardownDialog();
    currentDialog = dialog;

    titleEl.textContent = data.title;
    titleEl.hidden = !data.title;
    if (data.title) dialog.setAttribute("aria-labelledby", titleEl.id);
    else dialog.removeAttribute("aria-labelledby");

    bodyEl.textContent = data.body;
    bodyEl.hidden = !data.body;
    if (data.body) dialog.setAttribute("aria-describedby", bodyEl.id);
    else dialog.removeAttribute("aria-describedby");

    if (data.image) {
      imageEl.alt = data.title ? `${data.title}二维码` : "链接二维码";
      imageEl.src = data.image;
      imageWrap.hidden = false;
    } else {
      imageEl.removeAttribute("src");
      imageEl.alt = "";
      imageWrap.hidden = true;
    }
    imageEl.onerror = () => {
      imageWrap.hidden = true;
      imageEl.removeAttribute("src");
    };

    if (data.button?.url) {
      actionEl.href = data.button.url;
      actionEl.textContent = data.button.label || "打开";
      actionEl.hidden = false;
    } else {
      actionEl.removeAttribute("href");
      actionEl.textContent = "";
      actionEl.hidden = true;
    }

    dialog.addEventListener("cancel", onCancel);
    dialog.addEventListener("close", onClose);
    dialog.addEventListener("pointerdown", onDialogPointerDown);
    dialog.addEventListener("click", onDialogClick);
    closeEl.addEventListener("click", requestClose);
    actionEl.addEventListener("click", requestClose);

    delete dialog.dataset.closing;
    dialog.showModal();
    lockScroll();
    closeEl.focus();
  }

  // The dialog itself is swapped with the page, but this module is executed only
  // once per script URL. Delegating the trigger click therefore survives client
  // navigation without rebinding every rendered row.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest("[data-friend-link-dialog]");
    if (!trigger) return;
    openDialog(trigger.getAttribute("data-friend-link-dialog"));
  });

  onBeforeNavigation(teardownDialog);
</script>
