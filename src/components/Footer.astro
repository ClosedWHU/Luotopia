---
import AppIcon from "./AppIcon.astro";
import { resolveLocale, routeUrl, useTranslations, type RouteKey } from "../i18n/ui";

const year = new Date().getFullYear();

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

interface NavItem {
  route: RouteKey;
  label: string;
}

interface ResourceItem {
  href: string;
  label: string;
  external?: boolean;
}

/*
 * Route keys, not literal paths — see the same note in `Navbar.astro`. On a page
 * whose locale does not translate a given destination, `routeUrl()` returns the
 * default-locale URL, so a footer link never points at a redirect stub.
 */
const nav: NavItem[] = [
  { route: "features", label: t("footer.nav.features") },
  { route: "download", label: t("footer.nav.download") },
  { route: "community", label: t("footer.nav.community") },
  { route: "brand", label: t("footer.nav.brand") },
  { route: "legal", label: t("footer.nav.legal") },
];

/*
 * Absolute URLs, identical in every locale: the destination is the same whatever
 * language you are reading, and translating the label is all that is owed.
 *
 * The copyright line below stays English in every locale on purpose:
 * `store-listings/README.md` requires the attribution to be identical in all of
 * them.
 */
const resources: ResourceItem[] = [
  { href: routeUrl(locale, "status"), label: t("footer.resources.status") },
  { href: "https://docs.whu.sb", label: t("footer.resources.docs"), external: true },
  { href: "https://github.com/ClosedWHU", label: t("footer.resources.github"), external: true },
  {
    href: "https://github.com/ClosedWHU/Luotopia",
    label: t("footer.resources.repo"),
    external: true,
  },
];
---

<footer class="relative z-10 mt-auto border-t border-glass-divider">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="lt-reveal">
        <div class="flex items-center gap-2 text-title-large text-on-surface mb-3">
          <AppIcon class="w-[22px] h-[22px]" size={22} lift alt="" />
          Luotopia
        </div>
        <p class="text-body-medium text-on-surface-variant">{t("footer.tagline")}</p>
      </div>

      <div class="lt-reveal" style="--lt-reveal-delay: 80ms">
        <!--
          h2, not h4. The footer follows whatever the page ended on — h2 on the
          homepage, deeper on the docs pages — and a heading may only step *down*
          one level at a time. h2 is the one level that is never a skip
          regardless of the preceding page, and it is also the honest outline
          position: these are site-wide navigation groups, peers of the main
          content sections rather than children of them.
        -->
        <h2 class="text-title-small text-on-surface mb-3">{t("footer.navHeading")}</h2>
        <ul class="space-y-2 text-body-medium">
          {
            nav.map((item) => (
              <li>
                <a
                  href={routeUrl(locale, item.route)}
                  class="text-on-surface-variant hover:text-primary no-underline transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lt-reveal" style="--lt-reveal-delay: 160ms">
        <h2 class="text-title-small text-on-surface mb-3">{t("footer.resourcesHeading")}</h2>
        <ul class="space-y-2 text-body-medium">
          {
            resources.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-on-surface-variant hover:text-primary no-underline transition-colors"
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="lt-reveal mt-8 pt-6 border-t border-glass-divider text-center text-body-small text-outline">
      &copy; {year} Made with ❤ by ClosedWHU Team · All rights reserved.
    </div>
  </div>
</footer>
