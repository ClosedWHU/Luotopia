---
/**
 * The `/download` page body.
 *
 * Extracted from `src/pages/download.astro` so the route can exist once per
 * locale without duplicating any markup: `src/pages/download.astro` renders it
 * in the default locale, `src/pages/[lang]/download.astro` renders it in each
 * published one. Everything locale-dependent is read from `Astro.currentLocale`
 * inside here, so neither caller has to pass anything down and the two cannot
 * drift.
 *
 * Two kinds of string on this page deliberately stay out of the dictionaries:
 *
 * - **The release notes themselves.** They are authored by hand in Chinese and
 *   `/api/releases*` serves one feed with no per-locale variant. The changelog
 *   body is now localised out of band instead: `tools/translate-release-notes.mjs`
 *   publishes a `release-notes-i18n.json` asset on each release and the client
 *   swaps in the entry for this page's locale, falling back to the hand-written
 *   body when there is none (an older release, a locale whose translation failed
 *   validation, or a fetch error). Everything *around* it — the heading that
 *   introduces it, the pager, the loading, empty and failure states, the asset
 *   chips, the toggle that expands a note — is localised as usual.
 * - **The install commands.** `brew tap ClosedWHU/luotopia` is not a sentence
 *   and a translated command does not run, so the snippets stay literal. The
 *   prose, labels and captions around them move to the dictionary, and so do
 *   the shell comments inside them, which are prose that happens to sit in a
 *   `<pre>`.
 */
import { Code } from "astro:components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Icon from "../Icon.astro";
import {
  externalLabelKey,
  platformKeys,
  platforms,
  testFlightUrl,
} from "../../config/downloads";
import { resolveLocale, useTranslations, type TranslationKey } from "../../i18n/ui";
import { DEFAULT_LOCALE } from "../../i18n/locales";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

/*
 * Same escaping as `legal/[slug].astro` does before its own `set:html`. Build
 * time only, so the Chrome 66 floor does not apply, but `replace(/g)` keeps it
 * identical to the copy the script below carries.
 */
function escapeHtml(text: string): string {
  return String(text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/**
 * A dictionary value with inline markup woven through it.
 *
 * The install notes put `<strong>`, `<code>` and `<a>` in the middle of running
 * prose. Splitting every paragraph at each tag would freeze the word order a
 * translation may use — `home.hero.subtitleLine1/2` can only get away with it
 * because its split is a `<br>` — so the value carries `{name}` placeholders and
 * this substitutes the markup for each one.
 *
 * The slots are written out at the call site, i.e. they are this file's own
 * markup, and the dictionary text around them is escaped first, so nothing
 * untrusted reaches `set:html`. Placeholders are matched with the same regex
 * `ui.ts` and the carousel's client-side `fill()` use; an unknown one is left
 * visible rather than blanked.
 */
function rich(key: TranslationKey, slots: Record<string, string>): string {
  return escapeHtml(t(key)).replace(
    /\{([a-zA-Z][a-zA-Z0-9]*)\}/g,
    (match, name: string) =>
      Object.prototype.hasOwnProperty.call(slots, name) ? slots[name] : match,
  );
}

/*
 * The inline fragments the notes above weave in, spelled exactly as the
 * template rendered them before the copy moved out — same tags, same classes,
 * same attribute order. The dictionaries hold sentences; this holds HTML.
 */
const strongHtml = (text: string) =>
  `<strong class="text-on-surface">${escapeHtml(text)}</strong>`;
const codeHtml = (text: string) =>
  `<code class="text-on-surface">${escapeHtml(text)}</code>`;
const linkHtml = (href: string, text: string) =>
  `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${escapeHtml(text)}</a>`;

const testFlightLink = linkHtml(testFlightUrl, t("download.install.apple.joinLink"));
/* Proper nouns: the repository's own name and GitHub's own product name. */
const wingetRepoLink = linkHtml(
  "https://github.com/microsoft/winget-pkgs",
  "microsoft/winget-pkgs",
);
const releasesLink = linkHtml(
  "https://github.com/ClosedWHU/Luotopia/releases",
  "GitHub Releases",
);

/*
 * The install commands, as data.
 *
 * `<Code>` highlights at build time and takes its source as a string, so the
 * eight snippets move out of the markup — and the translated shell comments
 * interpolate into them exactly as they did inside the `<code>` tag, which is
 * the one part of a command that is prose (see the note at the top of this
 * file).
 *
 * `String.raw` on all eight rather than only the two that need it:
 * `.\luotopia\luotopia.exe` and `.\path\to\manifests\folder` contain `\l`, `\p`
 * and `\t`, and an ordinary template literal turns that `\t` into a tab and
 * eats `\l` as a bare `l`. The source still looks right and the command stops
 * being copy-pasteable. One spelling everywhere means no block has to be
 * remembered as the special one.
 */
const snippets = {
  windows: String.raw`# ${t("download.install.windows.snippet")}
Expand-Archive luotopia-*-windows-x64.zip -DestinationPath .
.\luotopia\luotopia.exe`,
  linux: String.raw`# .tar.gz
tar -xzf luotopia-*-linux-x64.tar.gz && ./luotopia/luotopia
# .AppImage
chmod +x luotopia-*-linux-x64.AppImage && ./luotopia-*-linux-x64.AppImage
# .deb
sudo apt install ./luotopia-*-linux-*.deb
# .flatpak
flatpak install --user ./luotopia-*-linux-*.flatpak`,
  scoop: String.raw`scoop bucket add luotopia https://github.com/ClosedWHU/Luotopia-Dist
scoop install luotopia
scoop update luotopia   # ${t("download.pkg.scoop.update")}`,
  brew: String.raw`brew tap ClosedWHU/luotopia
# ${t("download.pkg.brew.linux")}
brew install luotopia
# ${t("download.pkg.brew.macos")}
brew install --cask luotopia`,
  nix: String.raw`nix profile install github:ClosedWHU/Luotopia-Dist`,
  aur: String.raw`yay -S luotopia-bin`,
  wingetDraft: String.raw`# ${t("download.pkg.winget.snippet")}
winget install --manifest .\path\to\manifests\folder`,
  winget: String.raw`winget install ClosedWHU.Luotopia`,
};

/*
 * Shared by every snippet: the docs' own dual theme (the `rehypeShiki` options
 * in `astro.config.mjs`), and no default colour, so Shiki paints nothing on the
 * `<pre>` itself — `.lt-inset` keeps supplying the glass fill and the
 * `.lt-dl-code` rules below pick which palette the tokens read.
 */
const SNIPPET_THEMES = { light: "github-light", dark: "github-dark" };
const SNIPPET_CLASS =
  "lt-dl-code overflow-x-auto rounded-sm lt-inset px-3 py-2 text-body-small text-on-surface";

/*
 * The strings the *script* needs, carried on data attributes.
 *
 * Not `define:vars`: that inlines the script and takes it out of the bundle,
 * which is exactly the tradeoff `ScreenshotCarousel.astro` already rejected.
 * Everything the client says out loud is rendered here instead, including the
 * templates with `{link}` / `{version}` / `{page}` placeholders, so the grammar
 * lives in the dictionaries alongside the words and a translator can move the
 * link to wherever its language wants it.
 *
 * `locale` is the page's own, and is what `formatDate()` now hands to
 * `toLocaleDateString` — the release dates used to be formatted as zh-CN
 * whatever language the page was rendered in.
 */
const i18n = {
  locale,
  notesSourceLocale: DEFAULT_LOCALE,
  latestCurrent: t("download.latest.current"),
  latestUnavailable: t("download.latest.unavailable"),
  releaseDetails: t("download.latest.details"),
  noData: t("download.badge.noData"),
  prerelease: t("download.badge.prerelease"),
  externalFallback: t("download.external.fallback"),
  recommended: t("download.asset.recommended"),
  archFilter: t("download.asset.archFilter"),
  appleStoreSubtitle: t("download.apple.storeSubtitle"),
  appleDmg: t("download.apple.dmgSection"),
  appleDmgCaveat: t("download.apple.dmgCaveat"),
  windowsStoreSubtitle: t("download.windows.storeSubtitle"),
  windowsZip: t("download.windows.zipSection"),
  windowsZipCaveat: t("download.windows.zipCaveat"),
  noNotes: t("download.changelog.noNotes"),
  loading: t("download.changelog.loading"),
  empty: t("download.changelog.empty"),
  loadFailed: t("download.changelog.error"),
  page: t("download.changelog.page"),
  viewOnGithub: t("download.changelog.viewOnGithub"),
  notesExpand: t("download.changelog.notesExpand"),
  notesCollapse: t("download.changelog.notesCollapse"),
};
---

<BaseLayout title={t("download.title")}>
  <PageHeader title={t("download.header")} subtitle={t("download.subtitle")} />

  <section
    class="relative pb-16 px-4"
    data-download-i18n
    data-i18n-locale={i18n.locale}
    data-i18n-notes-source-locale={i18n.notesSourceLocale}
    data-i18n-latest-current={i18n.latestCurrent}
    data-i18n-latest-unavailable={i18n.latestUnavailable}
    data-i18n-release-details={i18n.releaseDetails}
    data-i18n-no-data={i18n.noData}
    data-i18n-prerelease={i18n.prerelease}
    data-i18n-external-fallback={i18n.externalFallback}
    data-i18n-recommended={i18n.recommended}
    data-i18n-arch-filter={i18n.archFilter}
    data-i18n-apple-store-subtitle={i18n.appleStoreSubtitle}
    data-i18n-apple-dmg={i18n.appleDmg}
    data-i18n-apple-dmg-caveat={i18n.appleDmgCaveat}
    data-i18n-windows-store-subtitle={i18n.windowsStoreSubtitle}
    data-i18n-windows-zip={i18n.windowsZip}
    data-i18n-windows-zip-caveat={i18n.windowsZipCaveat}
    data-i18n-no-notes={i18n.noNotes}
    data-i18n-loading={i18n.loading}
    data-i18n-empty={i18n.empty}
    data-i18n-load-failed={i18n.loadFailed}
    data-i18n-page={i18n.page}
    data-i18n-view-on-github={i18n.viewOnGithub}
    data-i18n-notes-expand={i18n.notesExpand}
    data-i18n-notes-collapse={i18n.notesCollapse}
  >
    <div class="max-w-content mx-auto">
      <p id="latest-meta" class="lt-reveal text-body-medium text-outline mb-10">{t("download.latest.loading")}</p>

      <div id="platform-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          platforms.map((p, i) => {
            const keys = platformKeys(p.id);
            /*
             * The external-install link's copy, or `undefined` where the card
             * has no such link — the same presence test `p.externalLabel` was
             * when the label still lived in `config/downloads.ts`.
             */
            const external = p.externalUrl ? t(externalLabelKey(p.id)) : undefined;
            return (
              <div
                class="platform-card lt-reveal-lift lt-lift glass rounded-card p-5 flex flex-col"
                style={`--lt-reveal-delay: ${(i % 4) * 70}ms`}
                data-platform={p.id}
                data-external-url={p.externalUrl ?? ""}
                data-external-label={external ?? ""}
              >
                <span class="lt-icon-chip text-primary text-[22px] mb-3.5"><Icon name={p.icon} /></span>
                <h2 class="text-title-medium text-on-surface">{p.name}</h2>
                <p class="text-body-medium text-on-surface-variant mt-1">{t(keys.desc)}</p>
                <div class="mt-4 flex flex-wrap gap-1.5 items-center platform-badges">
                  <span class="inline-block px-2.5 py-0.5 rounded-sm lt-inset text-on-surface-variant text-label-medium">
                    {p.id === "apple" ? t("download.platform.apple.badge") : t("download.badge.loading")}
                  </span>
                </div>
                <div class:list={["platform-assets", "mt-3", "space-y-1.5", !p.externalUrl && "hidden"]}>
                  {p.externalUrl && (
                    <a
                      href={p.externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1 py-1.5 text-body-small text-primary hover:underline no-underline"
                    >
                      <Icon name="open_in_new" class="text-base" />
                      <span>{external ?? t("download.external.fallback")}</span>
                    </a>
                  )}
                </div>
                <p class="mt-2 text-body-small text-outline">{t(keys.note)}</p>
              </div>
            );
          })
        }
      </div>

      <div class="lt-reveal-lift mt-16 rounded-card glass p-6 sm:p-8">
        <h2 class="text-title-medium text-on-surface mb-4">{t("download.install.title")}</h2>
        <!--
          One drawer per platform, the first one open.

          These five sections used to render flat, which put every platform's
          install prose, both shell snippets and all three caveats on screen at
          once — most of it about a platform the visitor is not on. `<details>`
          keeps the disclosure native, so the copy is reachable with JS off, and
          matches the convention the Navbar's language panel and the docs sidebar
          already set. The script below adds only what `<details>` cannot do
          itself on this site's Chrome 66 floor: the exclusivity, which the
          `name` attribute would need 120+ for.
        -->
        <div class="space-y-2 text-body-medium text-on-surface-variant" data-drawer-group>
          <details class="lt-dl-drawer" open>
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="android" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Android</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p
                  set:html={rich("download.install.android.body", {
                    arm64: strongHtml("arm64-v8a"),
                    armv7: strongHtml("armeabi-v7a"),
                    x86: strongHtml("x86_64"),
                  })}
                />
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="apple" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Apple</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p
                  set:html={rich("download.install.apple.ios.body", {
                    lead: strongHtml(t("download.install.apple.ios.lead")),
                    joinLink: testFlightLink,
                  })}
                />
                <p
                  set:html={rich("download.install.apple.macos.body", {
                    dmg: strongHtml("DMG"),
                    openWith: strongHtml(t("download.install.apple.openWith")),
                    xattr: codeHtml("xattr -cr /Applications/Luotopia.app"),
                  })}
                />
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="windows" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Windows</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p
                  set:html={rich("download.install.windows.body", {
                    extractAll: strongHtml(t("download.install.windows.extractAll")),
                    exe: strongHtml("luotopia.exe"),
                  })}
                />
                <Code code={snippets.windows} lang="powershell" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p class="text-body-small text-outline">{t("download.install.windows.note")}</p>
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="linux" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Linux</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p
                  set:html={rich("download.install.linux.body", {
                    arch: strongHtml(t("download.install.linux.arch")),
                    format: strongHtml(t("download.install.linux.format")),
                  })}
                />
                <Code code={snippets.linux} lang="bash" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p class="text-body-small text-outline">{t("download.install.linux.note")}</p>
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="harmonyos" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">HarmonyOS</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p
                  set:html={rich("download.install.harmony.body", {
                    hap: codeHtml(".hap"),
                    signedHap: codeHtml("luotopia-*-harmonyos-arm64-signed.hap"),
                    sideload: codeHtml("HARMONYOS-SIDELOAD.txt"),
                  })}
                />
                <p class="text-body-small text-outline">{t("download.install.harmony.note")}</p>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="lt-reveal-lift mt-8 rounded-card glass p-6 sm:p-8">
        <h2 class="text-title-medium text-on-surface mb-2">{t("download.pkg.title")}</h2>
        <p class="text-body-medium text-on-surface-variant mb-4">{t("download.pkg.subtitle")}</p>
        <!--
          Marks follow one rule: the brand's own where simple-icons (CC0, the
          source `icon-source.server.ts` already vendors the platform marks
          from) carries one, `terminal` where it does not. Scoop and winget have
          no entry there, and hand-tracing a trademark for two rows of a
          five-row list is not what this card needs — the generic glyph says
          "CLI", which is the card's own subtitle.
        -->
        <div class="space-y-2 text-body-medium text-on-surface-variant" data-drawer-group>
          <details class="lt-dl-drawer" open>
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="terminal" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Scoop</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p>{t("download.pkg.scoop.body")}</p>
                <Code code={snippets.scoop} lang="powershell" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p class="text-body-small text-outline">{t("download.pkg.scoop.note")}</p>
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="homebrew" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Homebrew</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p>{t("download.pkg.brew.body")}</p>
                <Code code={snippets.brew} lang="bash" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p
                  class="text-body-small text-outline"
                  set:html={rich("download.pkg.brew.note", {
                    install: codeHtml("brew install luotopia"),
                    cask: codeHtml("--cask"),
                    upgrade: codeHtml("brew upgrade luotopia"),
                  })}
                />
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="nixos" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">Nix</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p>{t("download.pkg.nix.body")}</p>
                <Code code={snippets.nix} lang="bash" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="archlinux" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">{t("download.pkg.aur.title")}</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p>{t("download.pkg.aur.body")}</p>
                <Code code={snippets.aur} lang="bash" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p class="text-body-small text-outline">{t("download.pkg.aur.note")}</p>
              </div>
            </div>
          </details>
          <details class="lt-dl-drawer">
            <summary class="lt-dl-drawer-head state-layer flex items-center gap-2 px-3.5 py-3 cursor-pointer select-none list-none">
              <Icon name="terminal" class="text-lg text-primary" />
              <h3 class="flex-1 text-title-small text-on-surface">winget</h3>
              <Icon name="keyboard_arrow_down" class="lt-dl-caret text-base text-outline" />
            </summary>
            <div class="lt-dl-drawer-body">
              <div class="space-y-2 px-3.5 py-3">
                <p>{t("download.pkg.winget.body")}</p>
                <Code code={snippets.wingetDraft} lang="powershell" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p set:html={rich("download.pkg.winget.merged", { repo: wingetRepoLink })} />
                <Code code={snippets.winget} lang="powershell" themes={SNIPPET_THEMES} defaultColor={false} class={SNIPPET_CLASS} data-lenis-prevent-horizontal />
                <p class="text-body-small text-outline">{t("download.pkg.winget.note")}</p>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="mt-8 text-center mb-20">
        <p class="text-body-small text-outline" set:html={rich("download.releases.more", { link: releasesLink })} />
      </div>

      <!-- `lt-reveal-lift`, not `lt-reveal`: this wrapper holds the dynamically
           injected `.glass` release articles, and an opacity transition would
           make it a backdrop root for 0.7s — every glass card rendering flat,
           then snapping into blur at the end. Transform-only, per the rule in
           global.css. -->
      <div id="changelog" class="lt-reveal-lift">
        <h2 class="text-headline-small text-on-surface mb-2">{t("download.changelog.title")}</h2>
        <p class="text-body-large text-on-surface-variant mb-8">{t("download.changelog.subtitle")}</p>

        <div id="changelog-list" class="space-y-6" tabindex="-1" aria-busy="true">
          <p class="text-body-medium text-outline">{t("download.changelog.loading")}</p>
        </div>

        <div id="changelog-pager" class="mt-8 flex items-center justify-center gap-3 hidden">
          <button type="button" id="changelog-prev" class="state-layer rounded-full px-5 py-2 border border-outline text-primary bg-transparent cursor-pointer font-medium aria-disabled:opacity-40 aria-disabled:cursor-not-allowed">{t("download.changelog.prev")}</button>
          <span id="changelog-page-label" class="text-body-small text-outline"></span>
          <button type="button" id="changelog-next" class="state-layer rounded-full px-5 py-2 border border-outline text-primary bg-transparent cursor-pointer font-medium aria-disabled:opacity-40 aria-disabled:cursor-not-allowed">{t("download.changelog.next")}</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /*
   * `is:global` because half of this styles DOM the script builds at runtime:
   * Astro stamps its scoping attribute onto the template at build time, so a
   * scoped selector would not match one rendered release card (the same
   * reasoning StatusPage's block gives). Every rule is therefore namespaced
   * under `lt-dl-`, and every one of them outranks the utilities it sits beside
   * on specificity rather than on source order — after `flattenCssLayers()`
   * unwraps Tailwind's layers, order is all that is left of layer precedence,
   * and a component stylesheet's position relative to the utilities chunk is
   * not something this file gets to choose.
   *
   * ── The two drawer groups ──
   *
   * Bordered rows, not inset fills: the shell snippets inside a drawer are
   * already `.lt-inset`, and a second inset surface around them would be a
   * box of the same near-white fill inside a box of it. The border is the card.
   *
   * No `overflow: hidden` on the drawer. Clipping would round the head's state
   * layer for free, but it would also clip the focus ring of every link in the
   * body, so the head's corners are spelled out per state instead: all four
   * when closed, where the head *is* the box, and only the top two when open.
   *
   * `.lt-dl-drawer-body` is the animation shell and therefore carries no
   * padding of its own — the padding sits on the div inside it. A border-box
   * `max-height: 0` cannot squeeze an element's own padding away, so a padded
   * shell would stop 24px short of closed and every drawer would collapse into
   * an empty sliver before blinking out. The script writes `max-height` and
   * `overflow` on the shell while it animates and clears both when it settles,
   * so an open drawer keeps its natural height and nothing in it stays clipped.
   */
  .lt-dl-drawer {
    border: 1px solid var(--lt-glass-divider);
    border-radius: var(--lt-radius-control);
  }

  .lt-dl-drawer-head {
    border-radius: var(--lt-radius-control);
  }

  .lt-dl-drawer[open] > .lt-dl-drawer-head {
    border-radius: var(--lt-radius-control) var(--lt-radius-control) 0 0;
    /* Inset shadow rather than `border-bottom`: a border would grow the head
     * by 1px on every toggle and the whole row would visibly jump. */
    box-shadow: inset 0 -1px 0 0 var(--lt-glass-divider);
  }

  /* The native disclosure triangle, in the spelling WebKit needs; `list-none`
   * on the summary is what removes Firefox's `::marker` (DocsTree does both). */
  .lt-dl-drawer-head::-webkit-details-marker {
    display: none;
  }

  .lt-dl-caret {
    transition: transform 0.2s ease;
  }

  .lt-dl-drawer:not([open]) .lt-dl-caret {
    transform: rotate(-90deg);
  }

  /*
   * ── The store CTA ──
   *
   * The Apple / Windows cards' primary action, rendered by storeCtaHtml: a
   * full-width raised button so TestFlight / Microsoft Store finally outweigh the
   * direct DMG / zip rows that used to out-shine them. It is the raised-glass
   * rung (glass-control fill + sheen), NOT `filled-glass`: the button sits inside
   * a `.glass` card, where the design rules forbid a nested backdrop-filter, and
   * the brand marks are coloured (TestFlight's blue squircle, the Store bag's
   * Fluent blue), so a primary fill would fight them. The 1px primary ring is
   * what lifts it from an ordinary inset row to "the button" — a plain var(), not
   * a color-mix, so it survives the Chrome 66 / Safari 12 build target.
   *
   * `color` is set for the `state-layer` press/hover tint, which paints
   * `currentColor`; the label / subtitle spans override it with their own roles.
   */
  .lt-dl-store {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 0.8rem;
    text-align: left;
    color: var(--lt-color-on-surface);
    border-radius: var(--lt-radius-control);
    background-color: var(--lt-glass-control);
    background-image: var(--lt-glass-sheen);
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 1px var(--lt-color-primary),
      0 8px 20px -14px hsl(215 45% 18% / 0.5);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .lt-dl-store:hover {
      transform: translateY(-2px);
      box-shadow:
        inset 0 1px 0 0 var(--lt-glass-rim),
        inset 0 0 0 1px var(--lt-color-primary),
        0 14px 30px -16px hsl(215 45% 18% / 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-dl-store,
    .lt-dl-store:hover {
      transition: none;
      transform: none;
    }
  }

  /*
   * ── The changelog clamp ──
   *
   * One release note is a page of its own, and five of them per page made
   * /download longer than everything above it put together. Collapsed shows the
   * head of the note and fades its bottom edge out, so the cut reads as
   * "continues" instead of as a paragraph that was truncated.
   *
   * `mask-image`, not a gradient overlay painted on top: the note sits on glass,
   * and an opaque-to-transparent fill over it would hide the aurora the card is
   * refracting. A mask fades the text itself and leaves the panel alone. The
   * `-webkit-` spelling is the one that works on this site's Chrome 66 floor —
   * unprefixed `mask-image` on an HTML element is 120+ (PageHeader and HomePage
   * fade the same way, and neither needs the mask to animate).
   *
   * The height is animated by the script, not by a transition here: the open
   * end state is "natural height", and `max-height: none` is not an
   * interpolatable endpoint on this site's Chrome 66 floor (`interpolate-size`
   * is 129+, animating `grid-template-rows: 0fr → 1fr` is 107+). So the script
   * measures both ends in pixels and transitions an inline `max-height` between
   * them — `animateHeight()` below — and the 168px here is the value it reads
   * back off this rule when it collapses a note, which keeps the number in one
   * place.
   *
   * `data-clamped` is set to "true" by the script only for a note that really
   * overflows, and "false" is what the template renders, so a short note (or a
   * measurement that never ran) keeps its full height: `overflow` stays
   * `visible` unless the clamp is on, and nothing can end up unreachable. Such
   * a note also gets no toggle — the button is dropped from the DOM rather than
   * hidden, so its presence means "there is more" and the two states of the
   * clamp cannot disagree with it.
   */
  .lt-dl-notewrap[data-clamped="true"] .lt-dl-notes {
    /* Eight lines of body-medium (20px line-height). */
    max-height: 168px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 0%, #000 62%, transparent 100%);
    mask-image: linear-gradient(#000 0%, #000 62%, transparent 100%);
  }

  /*
   * A formatting context in every state, which is what keeps the note still at
   * the moment the animation ends. `overflow: hidden` already makes the clamped
   * box one, and a BFC *contains* its first child's top margin — release notes
   * usually open on a heading carrying `mt-4`. Clearing the clip when the note
   * settled let that 16px collapse back out through the top of the box and merge
   * with the version line's own margin, so the whole body jumped up 4px against
   * its title on the last frame. `flow-root` is the same containment without the
   * clipping (58+, inside this site's floor; Safari 12 ignores it and keeps the
   * jump, which is a seam, not a break). The drawer shell needs no such rule:
   * its child is the padded div, which has no margin to escape.
   */
  .lt-dl-notes {
    display: flow-root;
  }

  /*
   * Snippet colours. `<Code>` runs Shiki at build time on the docs' own dual
   * theme with `defaultColor: false`, so each token span carries both palettes
   * as `--shiki-light` / `--shiki-dark` and stays uncoloured until a rule picks
   * one — which also leaves the panel's `.lt-inset` fill in charge of the
   * background instead of the theme's opaque white. The swap reads the `.dark`
   * class rather than `prefers-color-scheme` because that is how this site
   * switches theme (`docs.css` does the same for the docs' fenced blocks).
   */
  .lt-dl-code span {
    color: var(--shiki-light);
  }

  html.dark .lt-dl-code span {
    color: var(--shiki-dark);
  }

  .lt-dl-more[aria-expanded="true"] .lt-dl-caret {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-dl-caret {
      transition: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../../scripts/page-lifecycle";
  import { normalizeIconSvg } from "../../scripts/icon-svg";
  import downloadIconRaw from "@material-symbols/svg-400/outlined/download.svg?raw";
  import openInNewIconRaw from "@material-symbols/svg-400/outlined/open_in_new.svg?raw";
  import caretIconRaw from "@material-symbols/svg-400/outlined/keyboard_arrow_down.svg?raw";
  import msStoreIconRaw from "../../assets/icons/store-microsoft-24-filled.svg?raw";

  const assetDownloadIcon = normalizeIconSvg(downloadIconRaw, "text-base shrink-0 mt-0.5");
  /* The de-emphasized direct-download rows (the Apple DMG / Windows zip that sit
   * below the store CTA): a smaller, muted glyph, so the store button above is
   * the one that reads as "click me". Android / Linux keep assetDownloadIcon —
   * there the direct download *is* the primary path. */
  const directDownloadIcon = normalizeIconSvg(downloadIconRaw, "text-sm shrink-0 opacity-60");
  const changelogDownloadIcon = normalizeIconSvg(downloadIconRaw, "text-sm");
  /* The changelog's expand/collapse caret. It borrows `.lt-dl-caret` from the
   * drawer groups for the transition only — duration and curve — while its
   * rotation comes from the button's own `aria-expanded` rule (down at rest,
   * up when expanded). The drawers rotate theirs -90deg when closed instead:
   * a disclosure points at what it will reveal, a read-more points at what is
   * below, and the two idioms are not the same arrow. */
  const notesCaretIcon = normalizeIconSvg(caretIconRaw, "lt-dl-caret text-sm");

  /*
   * The link both changelog failure states point at. Markup, not copy: the
   * dictionaries carry the sentence with a `{link}` placeholder, so a
   * translation can put the link wherever its grammar needs it.
   */
  const releasesLinkHtml = `<a href="https://github.com/ClosedWHU/Luotopia/releases" class="text-primary hover:underline" target="_blank" rel="noopener noreferrer">GitHub Releases</a>`;

  onPageSetup((signal) => {
    const PER_PAGE = 5;
    let page = 1;
    let hasNext = false;
    let hasPrev = false;
    // Read back by loadTestFlightVersion, which repaints the Apple badge after
    // the release pass and must not drop the 测试版 chip.
    let latestPrerelease = false;

    const latestMeta = document.getElementById("latest-meta");
    const listEl = document.getElementById("changelog-list");
    const pager = document.getElementById("changelog-pager");
    const prevBtn = document.getElementById("changelog-prev");
    const nextBtn = document.getElementById("changelog-next");
    const pageLabel = document.getElementById("changelog-page-label");

    /*
     * The strings this script speaks, read back off the section.
     *
     * Same reasoning as `ScreenshotCarousel`'s slide labels: a `<script>` is its
     * own module, and `define:vars` would inline it and drop it out of the
     * bundle. The frontmatter renders every one of them into a `data-i18n-*`
     * attribute, including the `{link}` / `{version}` / `{page}` templates, so
     * the client bundle stays language-neutral and the grammar is translated
     * along with the words instead of being baked into concatenation here.
     *
     * `locale` is the page's own, for `formatDate()`.
     */
    const root = document.querySelector<HTMLElement>("[data-download-i18n]");
    const dataset = root?.dataset ?? {};
    const copy = {
      locale: dataset.i18nLocale ?? "",
      notesSourceLocale: dataset.i18nNotesSourceLocale ?? "",
      latestCurrent: dataset.i18nLatestCurrent ?? "",
      latestUnavailable: dataset.i18nLatestUnavailable ?? "",
      releaseDetails: dataset.i18nReleaseDetails ?? "",
      noData: dataset.i18nNoData ?? "",
      prerelease: dataset.i18nPrerelease ?? "",
      externalFallback: dataset.i18nExternalFallback ?? "",
      recommended: dataset.i18nRecommended ?? "",
      archFilter: dataset.i18nArchFilter ?? "",
      appleStoreSubtitle: dataset.i18nAppleStoreSubtitle ?? "",
      appleDmg: dataset.i18nAppleDmg ?? "",
      appleDmgCaveat: dataset.i18nAppleDmgCaveat ?? "",
      windowsStoreSubtitle: dataset.i18nWindowsStoreSubtitle ?? "",
      windowsZip: dataset.i18nWindowsZip ?? "",
      windowsZipCaveat: dataset.i18nWindowsZipCaveat ?? "",
      noNotes: dataset.i18nNoNotes ?? "",
      loading: dataset.i18nLoading ?? "",
      empty: dataset.i18nEmpty ?? "",
      loadFailed: dataset.i18nLoadFailed ?? "",
      page: dataset.i18nPage ?? "",
      viewOnGithub: dataset.i18nViewOnGithub ?? "",
      notesExpand: dataset.i18nNotesExpand ?? "",
      notesCollapse: dataset.i18nNotesCollapse ?? "",
    };

    /**
     * `{name}` substitution.
     *
     * `String.prototype.replaceAll` is Chrome 85 and the bundle's floor is 66, so
     * this is a global regex instead. Unknown placeholders are left alone rather
     * than blanked, so a typo in a dictionary shows up on the page instead of
     * silently deleting part of the sentence.
     */
    function fill(template: string, vars: Record<string, string | number>): string {
      return template.replace(/\{([a-zA-Z][a-zA-Z0-9]*)\}/g, (match, name: string) =>
        Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : match,
      );
    }

    function formatSize(bytes) {
      if (!bytes && bytes !== 0) return "";
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
      return (bytes / (1024 * 1024)).toFixed(1) + " MB";
    }

    /** Split name so UI can truncate base while keeping suffix (e.g. .tar.gz) visible. */
    function splitFilename(name) {
      const n = String(name || "");
      const multi = n.match(/(\.(tar\.gz|tgz))$/i);
      if (multi) {
        return { base: n.slice(0, -multi[1].length), ext: multi[1] };
      }
      const i = n.lastIndexOf(".");
      if (i > 0) return { base: n.slice(0, i), ext: n.slice(i) };
      return { base: n, ext: "" };
    }

    /*
     * The page's own locale, not a hardcoded one: this page now exists in ten
     * languages and a release date written as zh-CN on the English page is
     * wrong twice over. An empty value falls back to the browser's locale,
     * which is what passing `undefined` means.
     */
    function formatDate(iso) {
      if (!iso) return "";
      try {
        return new Date(iso).toLocaleDateString(copy.locale || undefined, { year: "numeric", month: "short", day: "numeric" });
      } catch {
        return iso.slice(0, 10);
      }
    }

    function escapeHtml(s) {
      // `replace(/g)`, not `replaceAll` (Chrome 85+): this bundle must parse
      // and run on WebView kernels back to ~66.
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    /** Inline markdown after HTML escape: **bold**, `code`, [text](url) */
    function formatInline(s) {
      return s
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (_, t, u) => {
          return `<a href="${u}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${t}</a>`;
        })
        .replace(/`([^`]+)`/g, '<code class="px-1 rounded-[4px] lt-inset text-on-surface text-[0.9em]">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-medium text-on-surface">$1</strong>');
    }

    /** Release notes markdown: headings, lists, quotes, hr, paragraphs */
    function formatBody(body) {
      if (!body) return `<p class="text-outline">${copy.noNotes}</p>`;
      const lines = escapeHtml(body).split(/\r?\n/);
      const html = [];
      let inList = false;
      const closeList = () => {
        if (inList) {
          html.push("</ul>");
          inList = false;
        }
      };
      let inQuote = false;
      let quoteLines = [];
      const closeQuote = () => {
        if (!inQuote) return;
        const paras = [];
        let cur = [];
        for (const l of quoteLines) {
          if (l.trim() === "") {
            if (cur.length) {
              paras.push(cur);
              cur = [];
            }
          } else {
            cur.push(l);
          }
        }
        if (cur.length) paras.push(cur);
        const inner = paras.length
          ? paras
              .map(
                (p) =>
                  `<p class="my-1 text-body-medium text-on-surface-variant">${p
                    .map(formatInline)
                    .join("<br>")}</p>`,
              )
              .join("")
          : '<p class="my-1">&nbsp;</p>';
        html.push(
          `<blockquote class="my-2 border-l-2 border-outline-variant pl-3">${inner}</blockquote>`,
        );
        inQuote = false;
        quoteLines = [];
      };
      for (const raw of lines) {
        const line = raw.replace(/\s+$/, "");
        // `>` is HTML-escaped to `&gt;` before parsing, so match the entity.
        const quote = line.match(/^\s*&gt;\s?(.*)$/);
        if (quote) {
          if (!inQuote) {
            closeList();
            inQuote = true;
            quoteLines = [];
          }
          quoteLines.push(quote[1].replace(/\s+$/, ""));
          continue;
        }
        closeQuote();
        if (line.trim() === "") {
          closeList();
          html.push('<div class="h-2"></div>');
          continue;
        }
        if (/^---+$/.test(line.trim()) || /^\*\*\*+$/.test(line.trim())) {
          closeList();
          html.push('<hr class="my-3 border-outline-variant" />');
          continue;
        }
        const h = line.match(/^(#{1,4})\s+(.+)$/);
        if (h) {
          closeList();
          const level = h[1].length;
          const text = formatInline(h[2]);
          // The release article already spends h3 on the version title, so
          // note headings start at h4 to keep the outline hierarchical.
          if (level === 1) {
            html.push(
              `<h4 class="mt-4 mb-2 text-title-large text-on-surface">${text}</h4>`,
            );
          } else if (level === 2) {
            html.push(
              `<h4 class="mt-4 mb-2 text-title-medium text-on-surface">${text}</h4>`,
            );
          } else {
            html.push(
              `<h5 class="mt-3 mb-1.5 text-title-small text-on-surface">${text}</h5>`,
            );
          }
          continue;
        }
        const item = line.match(/^\s*[-*•]\s+(.+)/);
        if (item) {
          if (!inList) {
            html.push('<ul class="space-y-1.5 my-2 pl-0 list-none">');
            inList = true;
          }
          html.push(
            `<li class="flex gap-2 text-body-medium text-on-surface-variant"><span class="text-primary shrink-0 select-none">•</span><span class="min-w-0">${formatInline(item[1])}</span></li>`,
          );
          continue;
        }
        closeList();
        html.push(
          `<p class="text-body-medium text-on-surface-variant">${formatInline(line)}</p>`,
        );
      }
      closeList();
      closeQuote();
      return html.join("");
    }

    function prereleaseBadge() {
      return `<span class="inline-block px-2 py-0.5 rounded-sm bg-error-container text-on-error-container text-label-medium">${copy.prerelease}</span>`;
    }

    function stableBadge(text) {
      return `<span class="inline-block px-2.5 py-0.5 rounded-sm bg-primary-container text-on-primary-container text-label-medium">${escapeHtml(text)}</span>`;
    }

    function statusBadge(text) {
      return `<span class="inline-block px-2.5 py-0.5 rounded-sm lt-inset text-on-surface-variant text-label-medium">${escapeHtml(text)}</span>`;
    }

    /**
     * Every card renders its version through here, whether or not it has
     * GitHub assets. The Apple card ships via TestFlight and so has none; it
     * used to keep the grey status pill while the others got a filled badge,
     * which read as a different version even when the string matched.
     */
    function paintBadges(badges, verLabel, isPrerelease, statusText) {
      badges.innerHTML = verLabel
        ? (isPrerelease ? prereleaseBadge() : "") + stableBadge(verLabel)
        : statusBadge(statusText || copy.noData);
    }

    /**
     * The store CTA — the Apple / Windows cards' one prominent action.
     *
     * TestFlight and the Microsoft Store are the *recommended* install path
     * (signed, auto-updating, no Gatekeeper / SmartScreen / unzip dance), but the
     * old small inline link read as just another hyperlink and sat above a pile of
     * direct-download rows that looked more clickable — so visitors kept grabbing
     * the unsigned DMG / zip and then could not open it. This inverts that: a
     * full-width raised button (brand mark + a 推荐 eyebrow + the store label + a
     * benefit subtitle) that is unmistakably the primary action, with the direct
     * downloads demoted below it (see mutedAssetLinkHtml).
     *
     * Returns "" when the card has no external store URL (Android, Linux), which
     * is what keeps the generic branch of cardAssetsHtml a no-op for them.
     */
    function storeCtaHtml(card) {
      const externalUrl = card.getAttribute("data-external-url") || "";
      if (!externalUrl) return "";
      const platform = card.getAttribute("data-platform") || "";
      const label = card.getAttribute("data-external-label") || copy.externalFallback;
      const subtitle =
        platform === "apple"
          ? copy.appleStoreSubtitle
          : platform === "windows"
            ? copy.windowsStoreSubtitle
            : "";
      /*
       * The brand marks carry their own colours (TestFlight's blue squircle, the
       * Store bag's Fluent blue) — exactly what a store badge should do, and why
       * a lone grey arrow was replaced. normalizeIconSvg stamps fill=currentColor
       * on the root, but the marks keep the fills on their own paths, so the
       * colour survives; `sizeClass` scales the 1em glyph up to badge size. A URL
       * that is neither store falls back to the arrow.
       */
      const icon =
        brandIconHtml(externalUrl, "text-[26px]") ||
        normalizeIconSvg(openInNewIconRaw, "text-[22px] shrink-0");
      return `<a href="${escapeHtml(externalUrl)}" target="_blank" rel="noopener noreferrer" class="lt-dl-store state-layer no-underline">
          ${icon}
          <span class="min-w-0 flex-1 flex flex-col gap-1">
            <span class="self-start px-2 py-0.5 rounded-sm bg-primary-container text-on-primary-container text-label-small leading-none">${escapeHtml(copy.recommended)}</span>
            <span class="text-title-small text-on-surface">${escapeHtml(label)}</span>
            ${subtitle ? `<span class="text-body-small text-on-surface-variant">${escapeHtml(subtitle)}</span>` : ""}
          </span>
        </a>`;
    }

    /*
     * Channel marks, because Material Symbols - the source every other icon
     * on this page is read from - has no brand glyphs, and a lone grey arrow
     * reads as "some hyperlink" rather than an install entry point.
     *
     * Provenance, after searching the usual standards: the Store mark is
     * vendored from Microsoft's own Fluent UI System Icons (MIT, see the
     * file's header). TestFlight has no public SVG anywhere - simple-icons
     * v16 never carried it, the Iconify aggregate has zero hits, Wikimedia
     * Commons has no logo, svgrepo sits behind a bot checkpoint, and tracing
     * the official PNG (homarr-labs/dashboard-icons, Apache-2.0) yields a
     * 10-53 KB patchwork because the artwork is gradients, not flats. So the
     * plane is a flat-vector reconstruction of the official icon's geometry:
     * squircle plus three-blade propeller. Its two fills read the --lt-tf-*
     * variables defined in global.css, which carry each theme's Apple system
     * blue (a single fixed azure was near-invisible on the light glass panel
     * and the ice-blue blade washed out against it). Brand hues live there
     * rather than in the token palette, which is for the app's own colours.
     */
    const TESTFLIGHT_ICON_RAW =
      '<svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.5" style="fill:var(--lt-tf-square,#007aff)"/><g style="fill:var(--lt-tf-blade,#fff)"><path d="M12 12.4C10.9 11.6 10.25 10.4 10.3 9.0L10.4 6.6C10.45 5.3 11.1 4.4 12 4.4C12.9 4.4 13.55 5.3 13.6 6.6L13.7 9.0C13.75 10.4 13.1 11.6 12 12.4Z"/><path d="M12 12.4C10.9 11.6 10.25 10.4 10.3 9.0L10.4 6.6C10.45 5.3 11.1 4.4 12 4.4C12.9 4.4 13.55 5.3 13.6 6.6L13.7 9.0C13.75 10.4 13.1 11.6 12 12.4Z" transform="rotate(120 12 12.4)"/><path d="M12 12.4C10.9 11.6 10.25 10.4 10.3 9.0L10.4 6.6C10.45 5.3 11.1 4.4 12 4.4C12.9 4.4 13.55 5.3 13.6 6.6L13.7 9.0C13.75 10.4 13.1 11.6 12 12.4Z" transform="rotate(240 12 12.4)"/><circle cx="12" cy="12.4" r="1.2"/></g></svg>';

    function brandIconHtml(url, sizeClass) {
      const size = sizeClass || "text-lg";
      if (url.includes("testflight.apple.com")) {
        return normalizeIconSvg(TESTFLIGHT_ICON_RAW, `${size} shrink-0 lt-tf-mark`);
      }
      if (url.includes("apps.microsoft.com")) {
        // Fluent's own light/dark brand pair: the light-mode #0078D4 reads
        // well on the glass panel but sinks into the dark one, where Fluent
        // itself switches to the brighter accent.
        return normalizeIconSvg(msStoreIconRaw, `${size} shrink-0 text-[#0078D4] dark:text-[#4CC2FF]`);
      }
      return "";
    }

    function paintAssets(assetsEl, html) {
      if (html) {
        assetsEl.classList.remove("hidden");
        assetsEl.innerHTML = html;
      } else {
        assetsEl.classList.add("hidden");
        assetsEl.innerHTML = "";
      }
    }

    /* ── Per-arch filtering for the desktop cards ──
     * Windows and Linux ship x64 and arm64 builds of every format; without a
     * filter the cards list eight links and bury the one the visitor wants.
     * A segmented pill (inset container + raised active segment, per the glass
     * rules — no nested backdrop-filter) narrows the list to one arch.
     * Arch-less assets (universal/unknown) stay visible in both segments so
     * nothing ever disappears. Cards whose release only spans one arch render
     * no switcher at all.
     */
    const ARCH_FILTER_DEFAULT = { windows: "x64", linux: "x64" };
    const archChoice = {};
    const cardAssetState = {};

    function archBucketOf(a) {
      if (a.arch === "amd64") return "x64";
      if (a.arch === "arm64") return "arm64";
      return null;
    }

    function assetLinkHtml(a) {
      const title =
        a.label ||
        [a.archLabel || a.arch, a.formatLabel].filter(Boolean).join(" · ") ||
        a.name;
      const rec = a.recommended
        ? `<span class="shrink-0 px-1.5 py-0.5 rounded-sm bg-primary-container text-on-primary-container text-label-small leading-none">${copy.recommended}</span>`
        : "";
      const { base, ext } = splitFilename(a.name);
      return `<a href="${escapeHtml(a.url)}" title="${escapeHtml(a.name)}" class="flex items-start gap-1.5 text-body-small text-primary hover:underline no-underline" download>
          ${assetDownloadIcon}
          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-center gap-1.5">
              <span class="font-medium text-on-surface">${escapeHtml(title)}</span>
              ${rec}
            </span>
            <span class="flex min-w-0 items-baseline text-outline text-[11px] mt-0.5">
              <span class="truncate min-w-0">${escapeHtml(base)}</span>
              <span class="shrink-0">${escapeHtml(ext)}</span>
              <span class="shrink-0"> · ${formatSize(a.size)}</span>
            </span>
          </span>
        </a>`;
    }

    /**
     * The de-emphasized direct-download row, for the Apple DMG and Windows zip
     * that sit *below* the store CTA. Same link and same target as the prominent
     * assetLinkHtml, but muted: on-surface-variant rather than primary, a smaller
     * dimmed glyph, one line instead of two, and no 推荐 badge — that signal now
     * belongs to the store button above, and repeating it on the unsigned /
     * needs-extracting fallback is exactly what sent visitors the wrong way
     * before. The full filename stays on the tooltip. Android / Linux keep
     * assetLinkHtml, because there the direct download *is* the primary path.
     */
    function mutedAssetLinkHtml(a) {
      const title =
        a.label ||
        [a.archLabel || a.arch, a.formatLabel].filter(Boolean).join(" · ") ||
        a.name;
      return `<a href="${escapeHtml(a.url)}" title="${escapeHtml(a.name)}" class="flex items-center gap-1.5 text-body-small text-on-surface-variant hover:text-primary hover:underline no-underline" download>
          ${directDownloadIcon}
          <span class="truncate min-w-0">${escapeHtml(title)}</span>
          <span class="shrink-0 text-outline">· ${formatSize(a.size)}</span>
        </a>`;
    }

    function archSwitcherHtml(id) {
      const seg = (key) => {
        const active = archChoice[id] === key;
        return `<button type="button" data-arch="${key}" aria-pressed="${active ? "true" : "false"}" class="state-layer rounded-full px-2.5 py-0.5 text-label-medium cursor-pointer ${active ? "lt-inset-raised text-primary" : "bg-transparent text-on-surface-variant"}">${key}</button>`;
      };
      /* Escaped because it lands in an attribute: Astro escaped the literal this
       * replaced, and a translated value must not be able to close the quote. */
      return `<div class="inline-flex items-center gap-0.5 rounded-full lt-inset p-0.5" role="group" aria-label="${escapeHtml(copy.archFilter)}">${seg("x64")}${seg("arm64")}</div>`;
    }

    /**
     * The Apple card carries two distribution channels that are NOT equals:
     * TestFlight (signed, auto-updating, the recommended path) and the direct
     * unsigned DMG (which trips Gatekeeper and needs the right-click → Open
     * ritual). The old flat layout listed them under look-alike headers, so
     * visitors kept picking the DMG. The store CTA therefore leads, full width
     * and raised, and the DMG drops below a divider into muted rows with a
     * caveat that names what it costs to use.
     * The asset label says macOS because DMGs are the only public Apple
     * asset; IPAs stay TestFlight-only.
     */
    function appleCardHtml(installers, storeCta) {
      let html = storeCta;
      if (installers.length > 0) {
        html += `<div class="space-y-1.5 ${storeCta ? "pt-3 border-t border-outline-variant" : ""}">
          <p class="text-label-medium text-outline">${copy.appleDmg}</p>
          ${installers.map(mutedAssetLinkHtml).join("")}
          <p class="text-body-small text-outline">${copy.appleDmgCaveat}</p>
        </div>`;
      }
      return html;
    }

    /**
     * Windows mirrors Apple: the Microsoft Store MSIX (Store-signed,
     * auto-updating, never a GitHub asset) leads as the store CTA, and the
     * portable zip — which needs extracting and trips SmartScreen — drops below a
     * divider into muted rows with a caveat. The zip section still gets the
     * x64 / arm64 switcher the Apple DMG never needed, and the Store version line
     * still hangs off the CTA (part of the stored html, so the switcher's repaint
     * does not drop it).
     */
    function windowsCardHtml(installers, storeCta) {
      const { switcher, list } = applyArchFilter("windows", installers);
      let html = "";
      if (storeCta) {
        /* The empty version line is a placeholder, not something
         * loadMsStoreVersion appends: the arch switcher repaints this whole
         * container from the stored html string, which would drop an appended
         * node. The filler only ever writes into an element the template
         * already put here. */
        html += `<div class="space-y-1.5">
          ${storeCta}
          <p class="text-body-small text-outline hidden" data-msstore-version></p>
        </div>`;
      }
      if (list.length > 0) {
        html += `<div class="space-y-1.5 ${storeCta ? "pt-3 border-t border-outline-variant" : ""}">
          <p class="text-label-medium text-outline">${copy.windowsZip}</p>
          ${switcher}
          ${list.map(mutedAssetLinkHtml).join("")}
          <p class="text-body-small text-outline">${copy.windowsZipCaveat}</p>
        </div>`;
      }
      return html;
    }

    /**
     * Apply the x64 / arm64 filter to a desktop platform's installers, or
     * hand them back untouched when the platform has no filter or the release
     * only spans one arch. The caller decides where the switcher sits.
     */
    function applyArchFilter(id, installers) {
      if (!Object.prototype.hasOwnProperty.call(ARCH_FILTER_DEFAULT, id)) {
        return { switcher: "", list: installers };
      }
      let hasX64 = false;
      let hasArm64 = false;
      for (const a of installers) {
        const bucket = archBucketOf(a);
        if (bucket === "x64") hasX64 = true;
        if (bucket === "arm64") hasArm64 = true;
      }
      if (!hasX64 || !hasArm64) return { switcher: "", list: installers };
      if (!archChoice[id]) archChoice[id] = ARCH_FILTER_DEFAULT[id];
      const choice = archChoice[id];
      return {
        switcher: archSwitcherHtml(id),
        list: installers.filter((a) => {
          const bucket = archBucketOf(a);
          return bucket === null || bucket === choice;
        }),
      };
    }

    function cardAssetsHtml(id, installers, storeCta) {
      if (id === "apple") return appleCardHtml(installers, storeCta);
      if (id === "windows") return windowsCardHtml(installers, storeCta);
      const { switcher, list } = applyArchFilter(id, installers);
      return storeCta + switcher + list.map(assetLinkHtml).join("");
    }

    /**
     * The navigation signal plus a timeout, combined by hand: `AbortSignal.any`
     * is Chrome 116+ and `AbortSignal.timeout` 103+, far above this bundle's
     * ~66 floor. Without a timeout a hung API would keep "加载中…" forever.
     */
    function fetchWithTimeout(url: string, ms: number) {
      const ctrl = new AbortController();
      const timer = window.setTimeout(() => ctrl.abort(), ms);
      const onNavAbort = () => ctrl.abort();
      if (signal.aborted) onNavAbort();
      else signal.addEventListener("abort", onNavAbort, { once: true });
      return fetch(url, { signal: ctrl.signal }).finally(() => {
        window.clearTimeout(timer);
        signal.removeEventListener("abort", onNavAbort);
      });
    }

    async function loadTestFlightVersion() {
      if (signal.aborted) return;

      try {
        // TestFlight builds are not GitHub Release assets. Ask the Pages
        // Function directly so the Apple card shows the actual beta build.
        const r = await fetchWithTimeout("/api/appstore/latest?connect=1", 15000);
        if (!r.ok || signal.aborted) return;

        const info = await r.json();
        if (info?.error || info?.channel !== "testflight" || !info.version) return;

        const card = document.querySelector('.platform-card[data-platform="apple"]');
        const badges = card?.querySelector(".platform-badges");
        if (!badges) return;
        paintBadges(badges, info.version, latestPrerelease, "");
      } catch { /* Keep the static TestFlight label when Connect is unavailable. */ }
    }

    /*
     * The Windows card's Store section gets its version the same way the Apple
     * card gets its beta build: from a Pages Function, here /api/msstore/latest.
     * A version string is digits and dots - language-neutral, like the platform
     * names - and the date goes through the page's own locale, so this needs no
     * dictionary entry. When the Store API answers nothing useful the line stays
     * hidden and the section keeps its static link.
     */
    let msStoreVersion = null;

    function paintMsStoreVersion() {
      const el = document.querySelector("[data-msstore-version]");
      if (!el || !msStoreVersion) return;
      const parts = [msStoreVersion.version];
      if (msStoreVersion.releaseDateUtc) {
        parts.push(formatDate(msStoreVersion.releaseDateUtc));
      }
      el.textContent = parts.join(" · ");
      el.classList.remove("hidden");
    }

    async function loadMsStoreVersion() {
      if (signal.aborted) return;

      try {
        const r = await fetchWithTimeout("/api/msstore/latest", 15000);
        if (!r.ok || signal.aborted) return;

        const info = await r.json();
        if (info?.error || !info.version) return;

        msStoreVersion = {
          version: info.version,
          releaseDateUtc: info.releaseDateUtc || null,
        };
        paintMsStoreVersion();
      } catch { /* Keep the static Store link when the Store API is unavailable. */ }
    }

    async function loadLatest() {
      if (signal.aborted) return;
      // Prefer newest including prerelease so testers see pre builds; badge will mark it
      let release = null;
      try {
        const r = await fetchWithTimeout("/api/releases/latest?prerelease=1", 15000);
        if (r.ok) release = await r.json();
      } catch { /* ignore */ }
      if (signal.aborted) return;

      if (!release || release.error) {
        if (latestMeta) latestMeta.textContent = copy.latestUnavailable;
        document.querySelectorAll(".platform-card").forEach((card) => {
          const badges = card.querySelector(".platform-badges");
          const assetsEl = card.querySelector(".platform-assets");
          if (!badges || !assetsEl) return;
          paintBadges(badges, "", false, copy.noData);
          paintAssets(assetsEl, storeCtaHtml(card));
        });
        void loadTestFlightVersion();
        void loadMsStoreVersion();
        return;
      }

      const verLabel = release.version || release.tag || release.title;
      latestPrerelease = !!release.prerelease;
      if (latestMeta) {
        latestMeta.innerHTML =
          fill(copy.latestCurrent, {
            version: `<strong class="text-on-surface">${escapeHtml(verLabel)}</strong>`,
          }) +
          (release.prerelease ? ` ${prereleaseBadge()}` : "") +
          (release.publishedAt ? ` · ${formatDate(release.publishedAt)}` : "") +
          (release.htmlUrl
            ? ` · <a href="${escapeHtml(release.htmlUrl)}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${copy.releaseDetails}</a>`
            : "");
      }

      const byPlatform = {};
      for (const a of release.assets || []) {
        const p = a.platform || "other";
        if (!byPlatform[p]) byPlatform[p] = [];
        byPlatform[p].push(a);
      }

      document.querySelectorAll(".platform-card").forEach((card) => {
        const id = card.getAttribute("data-platform");
        const badges = card.querySelector(".platform-badges");
        const assetsEl = card.querySelector(".platform-assets");
        if (!badges || !assetsEl) return;

        paintBadges(badges, verLabel, release.prerelease, "");

        // The Apple card stands in for both asset platforms the classifier
        // produces (ios IPAs - never public - and macOS DMGs). concat, not
        // flatMap: the bundle floor is Chrome 66.
        const sources = id === "apple" ? ["macos", "ios"] : [id];
        let platformAssets = [];
        for (const source of sources) {
          platformAssets = platformAssets.concat(byPlatform[source] || []);
        }
        const installers = platformAssets.filter((a) => !a.meta);
        const storeCta = storeCtaHtml(card);
        cardAssetState[id] = { installers, storeCta, assetsEl };
        paintAssets(assetsEl, cardAssetsHtml(id, installers, storeCta));
        paintMsStoreVersion();

        if (Object.prototype.hasOwnProperty.call(ARCH_FILTER_DEFAULT, id)) {
          // Delegated: the switcher buttons live in innerHTML that is replaced
          // on every toggle, while assetsEl itself is static Astro markup.
          assetsEl.addEventListener(
            "click",
            (ev) => {
              const btn =
                ev.target && ev.target.closest
                  ? ev.target.closest("button[data-arch]")
                  : null;
              if (!btn || !assetsEl.contains(btn)) return;
              const state = cardAssetState[id];
              if (!state) return;
              const nextArch = btn.getAttribute("data-arch");
              // Replacing innerHTML detaches the focused segment and drops
              // focus to <body>; park it back on the same segment (the
              // changelog pager does the same with its list).
              const hadFocus = assetsEl.contains(document.activeElement);
              archChoice[id] = nextArch;
              paintAssets(
                state.assetsEl,
                cardAssetsHtml(id, state.installers, state.storeCta),
              );
              paintMsStoreVersion();
              if (hadFocus) {
                const restored = state.assetsEl.querySelector(
                  `button[data-arch="${nextArch}"]`,
                );
                if (restored) restored.focus({ preventScroll: true });
              }
            },
            { signal },
          );
        }
      });

      void loadTestFlightVersion();
      void loadMsStoreVersion();
    }

    /*
     * Per-locale release notes.
     *
     * `tools/translate-release-notes.mjs` publishes a `release-notes-i18n.json`
     * asset beside the installers on every release, carrying a translated body
     * for each locale in `src/i18n/published.json`. It is fetched through the
     * existing `/api/releases/download/:tag/:filename` proxy, which already
     * caches and mirror-hops, so this adds no endpoint and nothing to adapt for
     * EdgeOne or ESA.
     *
     * Three things legitimately produce no translation: a release published
     * before the asset existed, a locale whose translation failed validation and
     * was omitted rather than filled with the source text, and a fetch error. All
     * three fall back to the hand-written body, which is what this page showed
     * before. A note rendered that way carries `lang` with the source locale, so
     * a Mandarin paragraph on an English page is at least announced and shaped
     * as Mandarin instead of inheriting the page's voice.
     *
     * The source locale never fetches: its body already *is* the hand-written one.
     */
    const notesCache = new Map();

    async function localizedNote(tag) {
      if (notesCache.has(tag)) return notesCache.get(tag);
      let body = null;
      try {
        const r = await fetchWithTimeout(
          `/api/releases/download/${encodeURIComponent(tag)}/release-notes-i18n.json`,
          15000,
        );
        if (r.ok) {
          const data = await r.json();
          const entry = data && data.locales ? data.locales[copy.locale] : null;
          if (entry && typeof entry.body === "string" && entry.body.trim()) {
            body = entry.body;
          }
        }
      } catch { /* Keep the hand-written body. */ }
      notesCache.set(tag, body);
      return body;
    }

    // Resolved before rendering so the item template below stays synchronous,
    // and in parallel because a page lists several releases at once.
    async function localizedNotes(items) {
      const out = new Map();
      if (!copy.locale || copy.locale === copy.notesSourceLocale) return out;
      const tags = [];
      for (const rel of items) {
        if (rel && rel.tag) tags.push(rel.tag);
      }
      const bodies = await Promise.all(tags.map(localizedNote));
      for (let i = 0; i < tags.length; i++) {
        if (bodies[i]) out.set(tags[i], bodies[i]);
      }
      return out;
    }

    /*
     * Height animation, shared by both disclosures on this page.
     *
     * One end state is always "the element's natural height", which is not an
     * interpolatable `max-height` value: `interpolate-size: allow-keywords` is
     * Chrome 129+ and animating `grid-template-rows: 0fr → 1fr` is 107+, against
     * this bundle's 66 floor. So both ends are measured in pixels and an inline
     * `max-height` transitions between them, after which the inline styles are
     * dropped and the element returns to its own height — which is also what
     * keeps a settled drawer correct when its content reflows later (a font
     * swap, a rotation, a narrower window).
     *
     * `fromPx` is passed in rather than measured here because the caller has
     * usually just flipped the state that decides the height: by the time this
     * runs the box is already at its new natural size, so measuring would report
     * the end state as the start state and the animation away.
     *
     * The completion signal is a timer, not `transitionend`. That event does not
     * fire when a transition is superseded, when reduced motion drops it, or
     * when the element leaves the document — every changelog page turn replaces
     * the list's innerHTML — and the drawer handoff below needs the callback to
     * actually run.
     *
     * A second call on the same element supersedes the first: a mid-flight click
     * starts from wherever the height currently is, and the superseded callback
     * is dropped rather than run, because it described a state nobody wants any
     * more (an interrupted close must not still set `open = false`).
     */
    const HEIGHT_MS = 280;
    const HEIGHT_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
    const heightAnims = new Map();
    const reducedMotion = window.matchMedia
      ? window.matchMedia("(prefers-reduced-motion: reduce)")
      : null;

    /**
     * @param el the element to animate — it must carry no padding of its own,
     *   since a border-box `max-height: 0` cannot squeeze padding away
     * @param fromPx the height it is on screen at right now
     * @param toPx the target height, or null for its natural height
     * @param onDone runs once el has settled, whether it animated or not
     */
    function animateHeight(el, fromPx, toPx, onDone) {
      const pending = heightAnims.get(el);
      if (pending) window.clearTimeout(pending);
      heightAnims.delete(el);

      const settle = () => {
        const timer = heightAnims.get(el);
        if (timer) window.clearTimeout(timer);
        heightAnims.delete(el);
        el.style.transition = "";
        el.style.maxHeight = "";
        el.style.overflow = "";
        if (onDone) onDone();
      };

      const to = toPx === null ? el.scrollHeight : toPx;
      if ((reducedMotion && reducedMotion.matches) || Math.abs(to - fromPx) < 1) {
        settle();
        return;
      }

      el.style.overflow = "hidden";
      el.style.transition = "none";
      el.style.maxHeight = fromPx + "px";
      // Commit the start value before arming the transition, or both writes land
      // in the same style recalculation and there is nothing to animate.
      void el.offsetHeight;
      el.style.transition = "max-height " + HEIGHT_MS + "ms " + HEIGHT_EASE;
      el.style.maxHeight = to + "px";
      heightAnims.set(el, window.setTimeout(settle, HEIGHT_MS + 60));
    }

    /*
     * Clamping the release notes.
     *
     * The card is rendered as `data-clamped="false"` — full height, no clamp —
     * and this pass flips it to "true" only where the note genuinely overflows,
     * dropping the toggle from the DOM where it does not. A button that reveals
     * nothing is worse than no button: an empty body renders as the one-line
     * "no release notes" placeholder, and plenty of releases are a short list.
     *
     * Measuring means clamping first, then comparing `scrollHeight` against the
     * `clientHeight` the clamp produced: the collapsed height lives in the
     * stylesheet, and repeating the number here would be a second copy of it
     * that nothing would notice drifting.
     *
     * MIN_HIDDEN is a line and a half rather than a pixel — offering "show full
     * notes" for a sliver of a last line is noise, and the unclamped state that
     * follows it hides nothing, since `overflow` only becomes `hidden` together
     * with the clamp.
     */
    const MIN_HIDDEN_NOTES_PX = 30;
    // `aria-controls` needs an id per note, and the list is replaced wholesale
    // on every page turn, so a counter that only ever grows cannot collide with
    // an id still in the document.
    let notesSeq = 0;

    function clampNotes() {
      listEl.querySelectorAll(".lt-dl-notewrap").forEach((wrap) => {
        const notes = wrap.querySelector(".lt-dl-notes");
        const more = wrap.querySelector(".lt-dl-more");
        if (!notes || !more) return;
        wrap.setAttribute("data-clamped", "true");
        if (notes.scrollHeight - notes.clientHeight > MIN_HIDDEN_NOTES_PX) return;
        wrap.setAttribute("data-clamped", "false");
        more.parentNode.removeChild(more);
      });
    }

    // Rapid clicks put several loadChangelog calls in flight at once; a stale
    // response landing late would otherwise overwrite the newer page and leave
    // `page` disagreeing with what is on screen. Only the newest request may
    // touch the DOM. The pager stays clickable-throughout for the same reason it
    // uses `aria-disabled` rather than `disabled` at the ends: a disabled button
    // that holds focus drops it to <body>.
    let changelogRequestId = 0;

    async function loadChangelog(p) {
      if (!listEl || signal.aborted) return;
      const requestId = ++changelogRequestId;
      // Replacing innerHTML detaches a focused link and drops focus to <body>;
      // remember it and park focus on the list (tabindex="-1") instead, both
      // while loading and after the new page renders.
      const focusWasInList = listEl.contains(document.activeElement);
      listEl.innerHTML = `<p class="text-body-medium text-outline">${copy.loading}</p>`;
      listEl.setAttribute("aria-busy", "true");
      if (focusWasInList) listEl.focus({ preventScroll: true });
      try {
        const r = await fetchWithTimeout(`/api/releases?page=${p}&per_page=${PER_PAGE}`, 15000);
        if (!r.ok) throw new Error("HTTP " + r.status);
        const data = await r.json();
        if (signal.aborted || requestId !== changelogRequestId) return;
        page = data.page || p;
        hasNext = !!data.hasNext;
        hasPrev = !!data.hasPrev || page > 1;
        const items = data.items || [];

        const notes = await localizedNotes(items);
        // The notes round-trip is a second await, so the staleness guard has to
        // run again before anything touches the DOM.
        if (signal.aborted || requestId !== changelogRequestId) return;

        if (items.length === 0) {
          listEl.innerHTML = `<p class="text-body-medium text-outline">${fill(copy.empty, { link: releasesLinkHtml })}</p>`;
        } else {
          listEl.innerHTML = items
            .map((rel) => {
              const ver = rel.version || rel.tag || rel.title;
              const assetList = (rel.assets || []).filter((a) => !a.meta);
              const assets =
                assetList.length > 0
                  ? `<div class="mt-4 flex flex-wrap gap-2">${assetList
                      .map((a) => {
                        const label =
                          a.label ||
                          [a.platform, a.archLabel || a.arch, a.formatLabel]
                            .filter(Boolean)
                            .join(" · ") ||
                          a.name;
                        const rec = a.recommended ? ` · ${copy.recommended}` : "";
                        return `<a href="${escapeHtml(a.url)}" title="${escapeHtml(a.name)}" class="inline-flex items-center gap-1 px-3 py-1 rounded-full lt-inset-raised text-label-medium text-primary no-underline hover:underline" download>
                            ${changelogDownloadIcon}${escapeHtml(label + rec)}
                          </a>`;
                      })
                      .join("")}</div>`
                  : "";
              const notesId = "lt-dl-notes-" + ++notesSeq;
              return `<article class="rounded-card glass p-6">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="text-title-large text-on-surface">${escapeHtml(ver)}</h3>
                  ${rel.prerelease ? prereleaseBadge() : ""}
                  <span class="text-body-small text-outline ml-auto">${formatDate(rel.publishedAt)}</span>
                </div>
                ${rel.title && rel.title !== ver && rel.title !== rel.tag ? `<p class="text-body-small text-outline mb-3">${escapeHtml(rel.title)}</p>` : ""}
                <div class="lt-dl-notewrap" data-clamped="false">
                  <div class="lt-dl-notes text-body-medium text-on-surface-variant" id="${notesId}"${notes.get(rel.tag) ? "" : ` lang="${copy.notesSourceLocale}"`}>${formatBody(notes.get(rel.tag) || rel.body)}</div>
                  <button type="button" class="lt-dl-more state-layer mt-3 inline-flex items-center gap-1 rounded-full lt-inset-raised px-3.5 py-2 text-label-medium text-primary cursor-pointer" data-notes-toggle aria-expanded="false" aria-controls="${notesId}">
                    <span data-notes-label>${escapeHtml(copy.notesExpand)}</span>
                    ${notesCaretIcon}
                  </button>
                </div>
                ${assets}
                ${rel.htmlUrl ? `<p class="mt-4 text-body-small"><a href="${escapeHtml(rel.htmlUrl)}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">${copy.viewOnGithub}</a></p>` : ""}
              </article>`;
            })
            .join("");
        }
        clampNotes();
        listEl.setAttribute("aria-busy", "false");
        if (focusWasInList) listEl.focus({ preventScroll: true });

        if (pager && prevBtn && nextBtn && pageLabel) {
          pager.classList.remove("hidden");
          /*
           * `aria-disabled`, not `disabled`: a disabled button that currently
           * holds focus drops it to <body> when the attribute lands, and the
           * pager is exactly the control a keyboard user is on when they turn
           * the page. The click handlers below already refuse to act on the
           * guarded side, so the attribute is presentation and announcement
           * only.
           */
          prevBtn.setAttribute("aria-disabled", String(!hasPrev));
          nextBtn.setAttribute("aria-disabled", String(!hasNext));
          pageLabel.textContent = fill(copy.page, { page });
        }
      } catch {
        if (signal.aborted || requestId !== changelogRequestId) return;
        listEl.innerHTML = `<p class="text-body-medium text-outline">${fill(copy.loadFailed, { link: releasesLinkHtml })}</p>`;
        listEl.setAttribute("aria-busy", "false");
        pager?.classList.add("hidden");
      }
    }

    /*
     * Delegated for the reason the arch switcher's listener is: the toggle sits
     * in innerHTML that is replaced on every page turn, while `listEl` itself is
     * static Astro markup, bound once per navigation.
     */
    if (listEl) {
      listEl.addEventListener("click", (ev) => {
        const btn =
          ev.target && ev.target.closest ? ev.target.closest("[data-notes-toggle]") : null;
        if (!btn || !listEl.contains(btn)) return;
        const wrap = btn.closest(".lt-dl-notewrap");
        const notes = wrap && wrap.querySelector(".lt-dl-notes");
        if (!notes) return;

        /*
         * One boolean drives all three writes, and that is the point: `collapse`
         * is what this click is about to do, so the button's state, the clamp and
         * the label all read off the same value and cannot drift apart. They did
         * once — `data-clamped` was written from the *pre*-click state, which is
         * the same thing `aria-expanded` was about to become, so the first click
         * only relabelled the button and the second one did the work.
         */
        const collapse = btn.getAttribute("aria-expanded") === "true";
        // Measured before either attribute moves: this is the height on screen
        // right now, and flipping `data-clamped` changes it in the same task.
        const from = notes.getBoundingClientRect().height;

        btn.setAttribute("aria-expanded", collapse ? "false" : "true");
        const label = btn.querySelector("[data-notes-label]");
        if (label) label.textContent = collapse ? copy.notesExpand : copy.notesCollapse;

        if (!collapse) {
          wrap.setAttribute("data-clamped", "false");
          animateHeight(notes, from, null, null);
          return;
        }
        // The collapsed height is read back off the rule the attribute just
        // switched on, so 168px lives in the stylesheet and nowhere else. A
        // non-px answer (rule missing, old kernel) degrades to no animation:
        // settle() drops the inline style and the clamp takes over.
        wrap.setAttribute("data-clamped", "true");
        const clamped = parseFloat(window.getComputedStyle(notes).maxHeight);
        animateHeight(notes, from, clamped > 0 ? clamped : null, null);
      }, { signal });
    }

    /*
     * The drawers, animated.
     *
     * `<details>` still does the disclosure on its own with JS off. With JS on
     * the summary's click is taken over, because the body has to be rendered
     * before it can be measured and native `open` offers no such window — a
     * closed drawer renders no body at all. `preventDefault()` is what stops the
     * browser flipping `open` underneath the animation, and it stops the `toggle`
     * event with it, so the group's exclusivity is driven from here instead of
     * from a second listener that would race the animation.
     *
     * Exclusivity is the one thing `<details>` cannot do on this site's Chrome 66
     * floor, since `name`-grouped accordions are 120+. The two cards are two
     * groups, so an install note and a package manager stay readable side by
     * side, and within a group the handoff is sequential: the drawer that was
     * clicked finishes opening before the one it replaces starts closing, so the
     * page never moves twice at once under the cursor.
     */
    function closeDrawer(drawer) {
      const body = drawer.querySelector(".lt-dl-drawer-body");
      if (!body) {
        drawer.open = false;
        return;
      }
      // `open` stays set until the body has finished collapsing: unsetting it
      // first would remove the very element being measured.
      animateHeight(body, body.getBoundingClientRect().height, 0, () => {
        drawer.open = false;
      });
    }

    document.querySelectorAll("[data-drawer-group]").forEach((group) => {
      /*
       * The drawer this group is showing: the one the visitor last clicked, which
       * is not necessarily the one whose animation just finished. The handoff
       * closes everything except *this*, and the difference only shows up when a
       * second click lands while the first drawer is still opening — keying the
       * handoff to the drawer that opened lets the first one's callback close the
       * second one, which is the one the visitor actually asked for.
       */
      let current = group.querySelector("details.lt-dl-drawer[open]");

      const closeOthers = () => {
        group.querySelectorAll("details.lt-dl-drawer[open]").forEach((other) => {
          if (other !== current) closeDrawer(other);
        });
      };

      const open = (drawer) => {
        current = drawer;
        drawer.open = true;
        const body = drawer.querySelector(".lt-dl-drawer-body");
        if (!body) {
          closeOthers();
          return;
        }
        animateHeight(body, 0, null, closeOthers);
      };

      group.addEventListener("click", (ev) => {
        const head =
          ev.target && ev.target.closest
            ? ev.target.closest("summary.lt-dl-drawer-head")
            : null;
        if (!head || !group.contains(head)) return;
        const drawer = head.closest("details.lt-dl-drawer");
        if (!drawer) return;
        ev.preventDefault();
        if (drawer.open) {
          if (current === drawer) current = null;
          closeDrawer(drawer);
        } else {
          open(drawer);
        }
      }, { signal });
    });

    prevBtn?.addEventListener("click", () => {
      if (page > 1) loadChangelog(page - 1);
    }, { signal });
    nextBtn?.addEventListener("click", () => {
      if (hasNext) loadChangelog(page + 1);
    }, { signal });

    loadLatest();
    loadChangelog(1);

    return () => {
      heightAnims.forEach((timer) => window.clearTimeout(timer));
      heightAnims.clear();
    };
  });
</script>
