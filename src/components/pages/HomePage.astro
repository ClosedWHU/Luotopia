---
/**
 * The home page body.
 *
 * Extracted from `src/pages/index.astro` so `/` and `/en/` can share one
 * implementation; see the same note in `FeaturesPage.astro`. The locale is read
 * from `Astro.currentLocale` here rather than passed in, so the two route files
 * cannot disagree with what the page actually renders.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppIcon from "../AppIcon.astro";
import FeatureCard from "../FeatureCard.astro";
import Icon from "../Icon.astro";
import ScreenshotCarousel from "../ScreenshotCarousel.astro";
import DownloadButtons from "../DownloadButtons.astro";
import { featureKeys, highlightedFeatures } from "../../config/features";
import { resolveLocale, useTranslations } from "../../i18n/ui";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

/**
 * Rotating hero adjectives.
 *
 * In the default locale all five are two characters on purpose: the rotator is a
 * grid stack sized to its widest child, so equal-length words mean the "· 珞家"
 * tail never shifts as the word changes.
 *
 * Other locales cannot honour that — "Efficient" and "Open" are not the same
 * width — and the consequence is narrower than it sounds. The cell is still sized
 * to the widest candidate and each word is `justify-self: center` inside it, so
 * the *tail* stays exactly put; only the words themselves wobble a little around
 * the centre as they roll. Keeping the tail stable is the part the design depends
 * on, and it survives translation. What would not survive is a candidate long
 * enough to make the whole heading wrap, so translations should stay short.
 */
const heroWords = t.list("home.hero.words");
const heroSrPrefix = t("home.hero.srPrefix");
---

<BaseLayout title={t("home.title")}>
  <section class="lt-hero relative overflow-hidden pt-[120px] pb-24 px-4 flex flex-col justify-center">
    <div class="lt-hero-wash" aria-hidden="true"></div>

    <div class="relative max-w-content mx-auto flex flex-col items-center text-center">

      <div class="lt-hero-rise" style="--lt-reveal-delay: 60ms">
        {/* Decorative: the h1 below carries an sr-only "Luotopia", so the mark
            itself must not announce a second copy of the name. */}
        <AppIcon class="w-[120px] h-[120px]" size={120} plate alt="" />
      </div>

      <h1 class="lt-hero-fade lt-hero-title mt-6 text-display-small sm:text-display-medium lg:text-display-large text-on-surface tracking-tight" style="--lt-reveal-delay: 120ms">
        {
          /*
           * Only emitted where the visible tail is not already the brand's Latin
           * name. In the default locale the heading reads "智慧 · 珞家" — Chinese
           * throughout — so screen readers need "Luotopia" spelled out ahead of
           * it. In English the tail *is* "Luotopia", and an sr-only prefix would
           * make the heading announce the name twice.
           */
          heroSrPrefix && <span class="sr-only">{heroSrPrefix}</span>
        }
        <span class="lt-rotator" data-lt-rotator>
          {
            heroWords.map((word, i) => (
              <span class="lt-word" data-active={i === 0 ? "true" : undefined} aria-hidden={i === 0 ? undefined : "true"}>
                {word}
              </span>
            ))
          }
        </span>
        <span class="lt-sep" aria-hidden="true">·</span>
        <span class="lt-hero-accent">{t("home.hero.tail")}</span>
      </h1>

      <p class="lt-hero-fade mt-6 text-title-large sm:text-headline-small font-normal text-on-surface-variant max-w-2xl" style="--lt-reveal-delay: 180ms">
        {t("home.hero.subtitleLine1")}<br class="hidden sm:block" />{t("home.hero.subtitleLine2")}
      </p>

      <div class="lt-hero-rise w-full max-w-2xl mt-12" style="--lt-reveal-delay: 240ms">
        <DownloadButtons variant="hero" />
        <p class="mt-5 text-body-small text-outline">{t("home.hero.platforms")}</p>
      </div>
    </div>

    {/*
      A sibling of the content column, not its last child: the hint is anchored
      to the hero's bottom edge, and the column carries its own `relative` (it
      has to, to paint over the wash), which would otherwise capture it and pin
      it 96px higher — back inside the band it is meant to mark the end of.
    */}
    <a href="#features" class="lt-scroll-hint" aria-label={t("home.hero.scrollHint")} style="--lt-reveal-delay: 420ms">
      <Icon name="keyboard_arrow_down" />
    </a>
  </section>

  <section id="features" class="relative pt-16 pb-24 sm:pt-24 px-4 scroll-mt-20">
    <div class="max-w-content mx-auto">
      <h2 class="lt-reveal text-headline-small text-center text-on-surface mb-3">{t("home.features.title")}</h2>
      <p class="lt-reveal text-body-large text-center text-on-surface-variant max-w-xl mx-auto mb-12" style="--lt-reveal-delay: 60ms">
        {t("home.features.subtitle")}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          highlightedFeatures.map((feature, i) => {
            const keys = featureKeys(feature.id);
            return (
              <div class="lt-reveal-lift h-full" style={`--lt-reveal-delay: ${(i % 4) * 70}ms`}>
                <FeatureCard
                  icon={feature.icon}
                  title={t(keys.title)}
                  description={t(keys.summary)}
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="relative py-24 px-4">
    <div class="max-w-content mx-auto">
      <h2 class="lt-reveal text-headline-small text-center text-on-surface mb-3">{t("home.preview.title")}</h2>
      <p class="lt-reveal text-body-large text-center text-on-surface-variant max-w-xl mx-auto mb-10" style="--lt-reveal-delay: 60ms">
        {t("home.preview.subtitle")}
      </p>
      <div class="lt-reveal-lift">
        <ScreenshotCarousel />
      </div>
    </div>
  </section>

  <section class="relative py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="lt-reveal-lift glass rounded-group px-6 py-14 sm:px-12 text-center">
        <h2 class="text-headline-small sm:text-headline-medium text-on-surface mb-4">{t("home.cta.title")}</h2>
        <p class="text-body-large text-on-surface-variant mb-9 max-w-md mx-auto">{t("home.cta.subtitle")}</p>
        <DownloadButtons variant="hero" surface="panel" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * The hero owns the fold.
   *
   * Its height used to be purely content-driven — 726px at every viewport — so
   * what sat under it was whatever the fold happened to have left. On a phone
   * that was 284px of stacked section padding below the buttons, with only the
   * first 22px of the next heading in view, against 54px of visible air above
   * the icon (120 of padding, 66 of it behind the navbar): 54 above, 284 below.
   * `min-height` makes the box follow the viewport and the section's
   * `justify-center` puts the mass in the middle of it, so the same 418px of
   * content is balanced at 844px tall and at 1080.
   *
   * `svh`, not `vh`: on a phone `100vh` is the *large* viewport, i.e. the URL
   * bar collapsed, so the anchored hint below would start its life under the
   * browser chrome. The `56rem` cap is what stops a 1080p screen from buying
   * 280px of nothing above and below the content — at the cap the next
   * section's heading still arrives inside the fold, which is the affordance a
   * full-height hero otherwise gives up.
   *
   * Deliberately no fallback declaration and no `@supports`: an engine without
   * `svh` (or without `min()`, Chrome 79+) drops the whole declaration as
   * invalid and the hero keeps the content-driven height it has today. That
   * path is not left unbalanced either — the features section below trims its
   * top padding under `sm`, which is what puts the heading inside a phone's
   * fold when this rule does not apply.
   */
  .lt-hero {
    min-height: min(100svh, 56rem);
  }

  /* A local wash over the page-wide aurora, so the hero carries more chroma
   * than the body copy below it — the same top-down gradient DeepSeek's hero
   * section layers over its shader, built from our own primary/tertiary tones.
   *
   * Centers are fractions of the hero box, which is now viewport-sized between
   * its content height and the 56rem cap, so the blooms scale with it rather
   * than drifting to the top of a taller box. Negative or zero centres are what
   * would park a bloom above the fold and leave the wash reading as nothing at
   * all. */
  .lt-hero-wash {
    position: absolute;
    /* Four sides, not the `inset` shorthand (Chrome 87+): legacy-WebView floor. */
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background:
      radial-gradient(48rem 27rem at 50% 13%, var(--lt-hero-wash-from), var(--lt-hero-wash-to) 74%),
      radial-gradient(34rem 22rem at 12% 34%, hsl(196 62% 76% / 0.42), transparent 70%),
      radial-gradient(34rem 22rem at 88% 26%, hsl(224 56% 80% / 0.42), transparent 70%);
    mask-image: linear-gradient(#000 0%, rgba(0, 0, 0, 0.92) 9%, transparent 100%);
    -webkit-mask-image: linear-gradient(#000 0%, rgba(0, 0, 0, 0.92) 9%, transparent 100%);
  }

  /*
   * Above-the-fold entrance, on CSS animations rather than the observer-driven
   * `.lt-reveal*` system the rest of the page uses.
   *
   * The split is forced by a timing mismatch, not taste. `.lt-reveal` starts at
   * opacity 0, but `.lt-reveal-lift` *cannot* — opacity < 1 turns an element
   * into a backdrop root and kills the glass inside it — so lift elements paint
   * fully visible at first frame, merely offset 28px. The observer that flips
   * `data-revealed` only runs once the deferred module chunk arrives, so on a
   * cold load the icon and buttons sat there "already done" while the title and
   * subtitle waited invisible, then faded in after them. Backwards.
   *
   * Animations start at first paint with no JS in the loop, so the whole hero
   * choreographs top-down (60 → 420ms) deterministically — and identically
   * after a client-side swap, where the new DOM restarts them just as the
   * observer would have. `backwards` fill holds the hidden state through the
   * delay and then lets go: the keyframes end at each element's natural state,
   * so a forwards fill would retain a composited layer on all five hero
   * elements — including the two CTA pills and the bobbing scroll hint — for
   * the life of the page. Nothing here ever sets `data-revealed`, so the two
   * systems stay decoupled.
   *
   * Same glass rule as `.lt-reveal-lift`: the rise variant animates `transform`
   * only. The fade variant is used on pure-text elements (title, subtitle,
   * scroll hint), where an opacity transition is safe.
   */
  @keyframes lt-hero-fade {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lt-hero-rise {
    from {
      transform: translateY(28px);
    }
    to {
      transform: none;
    }
  }

  .lt-hero-fade {
    animation: lt-hero-fade 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) backwards;
  }

  .lt-hero-rise {
    animation: lt-hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) backwards;
  }

   /*
    * Rotating hero word.
    *
    * The candidates are stacked in a single grid cell rather than absolutely
    * positioned, so the rotator is always as wide as the widest one and the
    * "· 珞家" tail never shifts mid-cycle. Every candidate being two characters
    * is what makes that invisible in the default locale; see `heroWords` above
    * for what happens when a translation cannot match that.
    *
    * The padding plus its cancelling negative margin enlarge the clip reference
    * box without enlarging the layout box, so the flex gap still reads as
    * designed. See `.lt-rotator` for what the extra room is for.
    */
  .lt-hero-title {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.3em;
    /*
      * The `mt-6` on this element is load-bearing, not cosmetic. The heading
      * used to read "Luotopia", whose Latin cap-height fills ~70% of the em box;
      * the default locale now leads with CJK, which fills ~88%. In the same line
      * box that moves the ink top up by roughly 10px, which collapsed the gap
      * under the icon plate and read as the two touching.
      *
      * It stays `mt-6` for every locale, including the Latin-led ones where the
      * original reasoning no longer applies. Tightening it per locale would mean
      * two values for the same visual relationship, decided by a script flag
      * nobody will remember; the Latin heading simply gets ~10px more air under
      * the icon, which reads as breathing room rather than as a mistake.
      */
  }

  .lt-rotator {
    display: grid;
    /*
     * `clip-path`, not `overflow: hidden`. Both clip identically here, but per
     * spec an element whose `overflow` is not `visible` has its baseline at its
     * *bottom margin edge* instead of its first line's baseline. The h1 is
     * `align-items: baseline`, so that silently lifted the whole rotator by
     * roughly a line-height and drove the word into the logo above it.
     * `clip-path` leaves the baseline alone.
     *
     * The negative inset expands the clipping rectangle past the text box so a
     * word at rest is never shaved by it — CJK ink reaches ~88% of the em box,
     * well past the half-leading a Latin metric would leave. It stays bounded on
     * purpose: the slot travel is 0.72em, so the departing and entering words
     * are still clipped mid-roll, which is what makes the swap read as a slot
     * rolling rather than a cross-fade, and they cannot travel far enough to
     * collide with the logo above or the subtitle below. The smaller horizontal
     * inset keeps them out of the separator and the accent tail.
     */
    clip-path: inset(-0.5em -0.2em);
    padding: 0.18em 0.24em;
    margin: -0.18em -0.24em;
  }

  .lt-rotator > .lt-word {
    grid-area: 1 / 1;
    justify-self: center;
    opacity: 0;
    transform: translateY(0.72em) scale(0.94);
    transition:
      opacity 0.5s ease,
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lt-rotator > .lt-word[data-active="true"] {
    opacity: 1;
    transform: none;
  }

  /* Must come after the [data-active] rule: both selectors are (0,2,0), and a
   * leaving word carries both attributes for the duration of the swap. */
  .lt-rotator > .lt-word[data-leaving="true"] {
    opacity: 0;
    transform: translateY(-0.72em) scale(0.96);
  }

  /*
   * Only `opacity` and `transform` are animated above, and that is a constraint
   * rather than a preference: they are the two properties the compositor can run
   * on its own thread.
   *
   * These words used to also transition `filter: blur(10px)`. Chromium cannot
   * composite a filter animation — every frame of it re-rasterizes the text and
   * re-runs the blur passes on the main thread — and this rotator fires two
   * overlapping blurs (the entering word and the leaving one) every 2.6 seconds
   * for as long as the tab is open, at display-large size. Lighthouse listed
   * both under non-composited animations.
   *
   * The roll and the fade carry the motion on their own; what is lost is a
   * defocus cue on a half-second transition, which is not something the swap
   * reads as missing. If the blur is wanted back, the price is a permanently
   * non-composited heading, so it should be a deliberate choice.
   */

  /* Keeps select-all / copy on the heading from yielding all five candidates
   * concatenated. */
  .lt-rotator > .lt-word:not([data-active="true"]) {
    user-select: none;
    pointer-events: none;
  }

  .lt-sep {
    opacity: 0.42;
  }

  /*
   * Stops run 0% -> 100% rather than the previous 8% -> 96%. Insetting them
   * clamped both ends, so over a box only ~114px wide the outer 16% of each
   * glyph sat on a flat colour and the visible ramp was even shorter than the
   * token range implies.
   */
  .lt-hero-accent {
    background-image: linear-gradient(
      100deg,
      var(--lt-title-gradient-from) 0%,
      var(--lt-title-gradient-via) 46%,
      var(--lt-title-gradient-to) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /*
   * Anchored to the hero's bottom edge instead of trailing the buttons.
   *
   * In flow it sat 3.5rem under the last text and then 96px of section padding
   * followed, so on a tall fold it floated in the middle of the empty band — the
   * one element down there, which is exactly what read as "the bottom is empty
   * apart from an arrow". At the edge it does the job it has: marks where the
   * fold ends. `left`/`right` with auto margins rather than `inset-inline-start`
   * (87+) or a centring `translate`, which the bob below already spends.
   */
  .lt-scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--lt-color-outline);
    text-decoration: none;
    /* The entrance rides alongside the bob rather than via `.lt-hero-fade`:
     * one element, one `animation` shorthand — two rules setting it would
     * cascade down to a single winner. The bob animates `translate`, not
     * `transform`, so the two compositions never fight over the same property
     * (and the entrance's transform transition is no longer overridden). */
    animation:
      lt-hero-fade 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--lt-reveal-delay, 0ms) backwards,
      lt-bob 2.4s ease-in-out infinite;
  }

  @keyframes lt-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-scroll-hint,
    .lt-hero-fade,
    .lt-hero-rise {
      animation: none;
    }

    /* The script never starts the cycle under reduced motion, so the first
     * candidate stays active and the heading reads as a stable
     * "智慧 · 珞家" — the other four are still stacked in the same cell at
     * opacity 0, which is why no display juggling is needed here. */
    .lt-rotator > .lt-word {
      transition: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../../scripts/page-lifecycle";

  onPageSetup((signal) => {
    const rotator = document.querySelector("[data-lt-rotator]");
    if (!rotator) return;

    const words = Array.from(rotator.querySelectorAll<HTMLElement>(".lt-word"));
    if (words.length <= 1) return;

    // Read live, not snapshotted: an OS reduced-motion flip mid-session has to
    // stop (or restart) the cycle — the same contract the friend-link dialog's
    // close timing keeps. The typeof guard covers engines whose MediaQueryList
    // is not an EventTarget; there the old snapshot behaviour remains.
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const HOLD = 2600;
    /** Must outlast the longest transition in `.lt-word` (0.72s transform). */
    const SWAP = 780;
    const leavingTimers = new Set<number>();
    let index = 0;
    let timer = 0;

    const show = (next: HTMLElement) => {
      const current = words[index];
      if (current === next) return;
      current.removeAttribute("data-active");
      current.setAttribute("data-leaving", "true");
      current.setAttribute("aria-hidden", "true");
      next.setAttribute("data-active", "true");
      next.removeAttribute("aria-hidden");

      // Clear `data-leaving` only after it has finished leaving, otherwise
      // the next cycle would find it mid-transition and snap.
      const timeout = window.setTimeout(() => {
        current.removeAttribute("data-leaving");
        leavingTimers.delete(timeout);
      }, SWAP);
      leavingTimers.add(timeout);
      index = words.indexOf(next);
    };

    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => show(words[(index + 1) % words.length]), HOLD);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    // Single gate for every "should the cycle run" input. A background tab
    // would otherwise pile up intervals and fire every queued swap at once on
    // return; a mid-session reduced-motion flip would otherwise keep rolling.
    const refresh = () => {
      if (document.hidden || motion.matches) stop();
      else start();
    };

    refresh();
    document.addEventListener("visibilitychange", refresh, { signal });
    if (typeof motion.addEventListener === "function") {
      motion.addEventListener("change", refresh, { signal });
    }

    signal.addEventListener("abort", () => {
      stop();
      for (const timeout of leavingTimers) window.clearTimeout(timeout);
      leavingTimers.clear();
    });
  });
</script>
