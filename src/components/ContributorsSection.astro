---
import { resolveLocale, useTranslations } from "../i18n/ui";

const t = useTranslations(resolveLocale(Astro.currentLocale));
---

<section
  class="relative pb-24 px-4"
  aria-labelledby="community-contributors-title"
  data-contributors-page
  data-contributors-locale={t.locale}
  data-contributors-commits={t("community.contributors.commits")}
  data-contributors-added={t("community.contributors.added")}
  data-contributors-deleted={t("community.contributors.deleted")}
  data-contributors-canceled-added={t("community.contributors.canceledAdded")}
  data-contributors-canceled-deleted={t("community.contributors.canceledDeleted")}
  data-contributors-net-added={t("community.contributors.netAdded")}
  data-contributors-net-deleted={t("community.contributors.netDeleted")}
  data-contributors-error={t("community.contributors.error")}
  data-contributors-empty={t("community.contributors.empty")}
>
  <div class="max-w-content mx-auto">
    <div class="mb-6 max-w-2xl">
      <h2 id="community-contributors-title" class="text-title-large text-on-surface mb-2">
        {t("community.contributors.title")}
      </h2>
      <p class="text-body-large text-on-surface-variant">
        {t("community.contributors.subtitle")}
      </p>
    </div>

    <div class="lt-contributors-groups">
      <section class="lt-contributors-panel" aria-labelledby="community-contributors-human-title">
        <h3 id="community-contributors-human-title" class="text-title-medium text-on-surface mb-4">
          {t("community.contributors.humans")}
        </h3>
        <p class="text-body-medium text-on-surface-variant" data-contributors-state="human">
          {t("community.contributors.loading")}
        </p>
        <div class="lt-contributors-list" data-contributors-group="human"></div>
      </section>

      <section class="lt-contributors-panel" aria-labelledby="community-contributors-bot-title">
        <h3 id="community-contributors-bot-title" class="text-title-medium text-on-surface mb-4">
          {t("community.contributors.bots")}
        </h3>
        <p class="text-body-medium text-on-surface-variant" data-contributors-state="bot">
          {t("community.contributors.loading")}
        </p>
        <div class="lt-contributors-list" data-contributors-group="bot"></div>
      </section>
    </div>
  </div>
</section>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";
  import { normalizeIconSvg } from "../scripts/icon-svg";
  import addRaw from "@material-symbols/svg-400/outlined/add.svg?raw";
  import removeRaw from "@material-symbols/svg-400/outlined/remove.svg?raw";
  import commitRaw from "@material-symbols/svg-400/outlined/commit.svg?raw";
  import historyRaw from "@material-symbols/svg-400/outlined/history.svg?raw";
  import cleanupRaw from "@material-symbols/svg-400/outlined/cleaning_services.svg?raw";
  import balanceRaw from "@material-symbols/svg-400/outlined/swap_vert.svg?raw";

  const icons = {
    added: normalizeIconSvg(addRaw, "lt-contributor-icon"),
    deleted: normalizeIconSvg(removeRaw, "lt-contributor-icon"),
    commits: normalizeIconSvg(commitRaw, "lt-contributor-icon"),
    history: normalizeIconSvg(historyRaw, "lt-contributor-icon"),
    cleanup: normalizeIconSvg(cleanupRaw, "lt-contributor-icon"),
    net: normalizeIconSvg(balanceRaw, "lt-contributor-icon"),
  };

  type Contributor = {
    name: string;
    username: string | null;
    type: "human" | "bot";
    commits: number;
    addedLines: number;
    deletedLines: number;
    canceledAddedLines: number;
    canceledDeletedLines: number;
    netLines: number;
    rankScoreKsloc: number;
    avatarUrl: string | null;
  };

  type ContributorsResponse = {
    humanContributors: Contributor[];
    botContributors: Contributor[];
  };

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function initials(name: string): string {
    return name.trim().slice(0, 1).toUpperCase() || "?";
  }

  function formatLines(value: number, locale: string): string {
    const absolute = Math.abs(Math.round(value));
    const chinese = locale.indexOf("zh") === 0;
    if (absolute < 1000) return `${absolute} ${chinese ? "行" : "SLOC"}`;
    if (absolute < 1000000) {
      return `${(absolute / 1000).toFixed(absolute < 10000 ? 1 : 0).replace(/\.0$/, "")}${chinese ? "k 行" : " kSLOC"}`;
    }
    return `${(absolute / 1000000).toFixed(absolute < 10000000 ? 1 : 0).replace(/\.0$/, "")}${chinese ? "m 行" : " MSLOC"}`;
  }

  function renderGroup(
    group: HTMLElement,
    state: HTMLElement,
    items: Contributor[],
    commitsTemplate: string,
    labels: Record<string, string>,
    emptyText: string,
  ): void {
    const format = (value: number) => formatLines(value, labels.locale);
    if (!items.length) {
      state.textContent = emptyText;
      return;
    }
    state.textContent = "";
    state.hidden = true;
    group.innerHTML = items.map((item, index) => {
      const avatar = item.avatarUrl
        ? `<img class="lt-contributor-avatar" src="${escapeHtml(item.avatarUrl)}" alt="" loading="lazy" decoding="async" width="40" height="40">`
        : `<span class="lt-contributor-avatar lt-contributor-avatar-fallback" aria-hidden="true">${escapeHtml(initials(item.name))}</span>`;
      const netLabel = item.netLines < 0 ? labels.netDeleted : labels.netAdded;
      return `<article class="lt-contributor-card" aria-labelledby="contributor-${item.type}-${index}">
        <header class="lt-contributor-heading">
          ${avatar}
          <div class="lt-contributor-identity">
            <h4 id="contributor-${item.type}-${index}" class="text-title-small text-on-surface">${escapeHtml(item.name)}</h4>
            ${item.username ? `<p class="lt-contributor-username">@${escapeHtml(item.username)}</p>` : ""}
            <p class="lt-contributor-commits text-body-small text-on-surface-variant">${icons.commits}${escapeHtml(commitsTemplate.replace("{count}", String(item.commits)))}</p>
          </div>
        </header>
        <dl class="lt-contributor-primary">
          <div class="lt-contributor-added">
            <dt>${icons.added}${escapeHtml(labels.added)}</dt>
            <dd>${escapeHtml(format(item.addedLines))}</dd>
          </div>
          <div class="lt-contributor-deleted">
            <dt>${icons.deleted}${escapeHtml(labels.deleted)}</dt>
            <dd>${escapeHtml(format(item.deletedLines))}</dd>
          </div>
        </dl>
        <dl class="lt-contributor-secondary text-body-small text-on-surface-variant">
          <div><dt>${icons.history}${escapeHtml(labels.canceledAdded)}</dt><dd>${escapeHtml(format(item.canceledAddedLines))}</dd></div>
          <div><dt>${icons.cleanup}${escapeHtml(labels.canceledDeleted)}</dt><dd>${escapeHtml(format(item.canceledDeletedLines))}</dd></div>
          <div><dt>${icons.net}${escapeHtml(netLabel)}</dt><dd>${escapeHtml(format(item.netLines))}</dd></div>
        </dl>
      </article>`;
    }).join("");
  }

  onPageSetup((signal) => {
    const humanGroup = document.querySelector<HTMLElement>('[data-contributors-group="human"]');
    const botGroup = document.querySelector<HTMLElement>('[data-contributors-group="bot"]');
    const humanState = document.querySelector<HTMLElement>('[data-contributors-state="human"]');
    const botState = document.querySelector<HTMLElement>('[data-contributors-state="bot"]');
    const page = document.querySelector<HTMLElement>("[data-contributors-page]");
    if (!humanGroup || !botGroup || !humanState || !botState || !page) return;
    const commitsTemplate = page.dataset.contributorsCommits || "{count}";
    const labels = {
      locale: page.dataset.contributorsLocale || "zh-Hans",
      added: page.dataset.contributorsAdded || "Added",
      deleted: page.dataset.contributorsDeleted || "Deleted",
      canceledAdded: page.dataset.contributorsCanceledAdded || "Added then removed",
      canceledDeleted: page.dataset.contributorsCanceledDeleted || "Cleaned",
      netAdded: page.dataset.contributorsNetAdded || "Net additions",
      netDeleted: page.dataset.contributorsNetDeleted || "Net deletions",
    };
    const errorText = page.dataset.contributorsError || "Error";
    const emptyText = page.dataset.contributorsEmpty || "";

    fetch("/api/contributors", { signal })
      .then((response) => {
        if (!response.ok) throw new Error(`contributors_${response.status}`);
        return response.json() as Promise<ContributorsResponse>;
      })
      .then((data) => {
        renderGroup(humanGroup, humanState, data.humanContributors || [], commitsTemplate, labels, emptyText);
        renderGroup(botGroup, botState, data.botContributors || [], commitsTemplate, labels, emptyText);
      })
      .catch(() => {
        if (signal.aborted) return;
        humanState.textContent = errorText;
        botState.textContent = errorText;
      });
  });
</script>

<style is:global>
  .lt-contributors-groups { display: grid; gap: 32px; }
  .lt-contributors-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .lt-contributor-card {
    min-width: 0;
    padding: 20px;
    border-radius: var(--lt-radius-card, 28px);
    background: var(--lt-color-surface);
    border: 1px solid var(--lt-color-outline-variant);
  }
  .lt-contributor-heading {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lt-contributor-identity { min-width: 0; }
  .lt-contributor-identity h4 { overflow-wrap: break-word; }
  .lt-contributor-username { font-size: 12px; line-height: 1.5; color: var(--lt-color-outline); overflow-wrap: anywhere; }
  .lt-contributor-commits { display: flex; align-items: center; gap: 6px; margin-top: 2px; }
  .lt-contributor-icon { width: 18px; height: 18px; flex: 0 0 18px; }
  .lt-contributor-avatar {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--lt-color-primary-container);
  }
  .lt-contributor-avatar-fallback {
    display: grid;
    place-items: center;
    color: var(--lt-color-on-primary-container);
    font-weight: 600;
  }
  .lt-contributor-primary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin: 20px 0 16px;
  }
  .lt-contributor-primary dt,
  .lt-contributor-secondary dt { display: flex; align-items: center; gap: 6px; }
  .lt-contributor-primary dt { font-size: 12px; line-height: 1.5; }
  .lt-contributor-primary dd { margin: 4px 0 0; font-size: 20px; line-height: 1.4; font-weight: 600; font-variant-numeric: tabular-nums; }
  .lt-contributor-added { color: var(--lt-color-success); }
  .lt-contributor-deleted { color: var(--lt-color-error); }
  .lt-contributor-secondary { display: grid; gap: 8px; margin: 0; padding-top: 14px; border-top: 1px solid var(--lt-color-outline-variant); }
  .lt-contributor-secondary > div { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .lt-contributor-secondary dd { margin: 0; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) {
    .lt-contributors-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .lt-contributors-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
