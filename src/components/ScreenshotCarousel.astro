---
import { Picture } from "astro:assets";
import phoneSchedule from "../assets/screenshots/phone/schedule.png";
import phoneCampus from "../assets/screenshots/phone/campus.png";
import phoneAi from "../assets/screenshots/phone/ai.png";
import phoneBus from "../assets/screenshots/phone/bus.png";
import phoneWeather from "../assets/screenshots/phone/weather.png";
import phoneWallpaper from "../assets/screenshots/phone/wallpaper.png";
import tabletSchedule from "../assets/screenshots/tablet/schedule.png";
import tabletCampus from "../assets/screenshots/tablet/campus.png";
import tabletAi from "../assets/screenshots/tablet/ai.png";
import tabletBus from "../assets/screenshots/tablet/bus.png";
import tabletWeather from "../assets/screenshots/tablet/weather.png";
import tabletWallpaper from "../assets/screenshots/tablet/wallpaper.png";
import desktopSchedule from "../assets/screenshots/desktop/schedule.png";
import desktopCampus from "../assets/screenshots/desktop/campus.png";
import desktopAi from "../assets/screenshots/desktop/ai.png";
import desktopBus from "../assets/screenshots/desktop/bus.png";
import desktopWeather from "../assets/screenshots/desktop/weather.png";
import desktopWallpaper from "../assets/screenshots/desktop/wallpaper.png";
import { resolveLocale, useTranslations } from "../i18n/ui";

const t = useTranslations(resolveLocale(Astro.currentLocale));

const slides = [
  { name: "schedule", label: t("carousel.slide.timetable"), phone: phoneSchedule, tablet: tabletSchedule, desktop: desktopSchedule },
  { name: "campus", label: t("carousel.slide.campus"), phone: phoneCampus, tablet: tabletCampus, desktop: desktopCampus },
  { name: "ai", label: t("carousel.slide.ai"), phone: phoneAi, tablet: tabletAi, desktop: desktopAi },
  { name: "weather", label: t("carousel.slide.weather"), phone: phoneWeather, tablet: tabletWeather, desktop: desktopWeather },
  { name: "bus", label: t("carousel.slide.bus"), phone: phoneBus, tablet: tabletBus, desktop: desktopBus },
  { name: "home", label: "Home", phone: phoneWallpaper, tablet: tabletWallpaper, desktop: desktopWallpaper },
  { name: "list", label: "My day", phone: phoneWallpaper, tablet: tabletWallpaper, desktop: desktopWallpaper },
  { name: "theme", label: "Appearance", phone: phoneWallpaper, tablet: tabletWallpaper, desktop: desktopWallpaper },
];

/*
 * The strings the *script* needs, carried on data attributes.
 *
 * Not `define:vars`: that inlines the script and takes it out of the bundle,
 * which is exactly the tradeoff the slide-label comment below already rejected.
 * Everything the client says out loud is rendered here as a template with `{name}`
 * placeholders, so the announcement grammar lives in the dictionaries alongside
 * the words — and a translator can reorder `{span}` and `{labels}` freely, which
 * string concatenation in the script never allowed.
 */
const i18n = {
  pause: t("carousel.pause"),
  play: t("carousel.play"),
  announceRange: t("carousel.announce.range"),
  announceSingle: t("carousel.announce.single"),
  announceWithLabels: t("carousel.announce.withLabels"),
  announceBare: t("carousel.announce.bare"),
  separator: t("carousel.announce.separator"),
  phone: t("carousel.form.phone"),
  tablet: t("carousel.form.tablet"),
  desktop: t("carousel.form.desktop"),
  themeAuto: "Auto",
  themeLight: "Light",
  themeDark: "Dark",
};
---

<div
  class="lt-carousel glass relative overflow-hidden rounded-group pb-10"
  role="group"
  aria-roledescription={t("carousel.roleDescription")}
  aria-label={t("carousel.label")}
  data-carousel-root
  data-i18n-pause={i18n.pause}
  data-i18n-play={i18n.play}
  data-i18n-announce-range={i18n.announceRange}
  data-i18n-announce-single={i18n.announceSingle}
  data-i18n-announce-with-labels={i18n.announceWithLabels}
   data-i18n-announce-bare={i18n.announceBare}
   data-i18n-separator={i18n.separator}
   data-i18n-form-phone={i18n.phone}
   data-i18n-form-tablet={i18n.tablet}
   data-i18n-form-desktop={i18n.desktop}
   data-i18n-theme-auto={i18n.themeAuto}
   data-i18n-theme-light={i18n.themeLight}
  data-i18n-theme-dark={i18n.themeDark}
  data-shot-locale={Astro.currentLocale ?? "zh-Hans"}
  >
  <div class="lt-form-toolbar flex items-center justify-center gap-2 px-4 pt-4 pb-3" data-carousel-form-controls>
    <div class="lt-form-switcher flex items-center gap-1 rounded-full lt-inset-raised p-1">
      <button class="lt-form-toggle state-layer rounded-full px-3 py-1.5 text-label-small" type="button" data-form="phone">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 18h4"/></svg>
        <span></span>
      </button>
      <button class="lt-form-toggle state-layer rounded-full px-3 py-1.5 text-label-small" type="button" data-form="tablet">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M10 18h4"/></svg>
        <span></span>
      </button>
      <button class="lt-form-toggle state-layer rounded-full px-3 py-1.5 text-label-small" type="button" data-form="desktop">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="1.5"/><path d="M8 21h8M12 17v4"/></svg>
        <span></span>
      </button>
    </div>
    <div class="lt-theme-switcher flex items-center gap-1 rounded-full lt-inset-raised p-1" data-carousel-theme-controls>
      <button class="lt-theme-toggle state-layer rounded-full px-2.5 py-1 text-label-small" type="button" data-theme="auto"><span></span></button>
      <button class="lt-theme-toggle state-layer rounded-full px-2.5 py-1 text-label-small" type="button" data-theme="light"><span></span></button>
      <button class="lt-theme-toggle state-layer rounded-full px-2.5 py-1 text-label-small" type="button" data-theme="dark"><span></span></button>
    </div>
  </div>

  <div class="lt-carousel-viewport">
    <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
      {slides.map((slide) => (
        <div class="shrink-0 p-1.5">
        <figure class="lt-shot overflow-hidden rounded-nested">
           <Picture
             src={slide.phone}
             data-phone-src={slide.phone.src}
             data-tablet-src={slide.tablet.src}
             data-desktop-src={slide.desktop.src}
             data-shot-name={slide.name}
            /*
             * Empty alt on purpose: the `<figcaption>` below names the figure,
             * and a figure's caption is its accessible name — repeating the same
             * string in `alt` made a screen reader traverse each slide as
             * "Timetable, image" then "Timetable", seven times.
             */
            alt=""
            formats={["avif", "webp"]}
            widths={[360, 720]}
            /*
             * Crop at build time to the ratio the CSS actually shows.
             *
             * The captures are 1024×2284 (ratio 0.448) but the rendered box is
             * `aspect-[9/16]` capped at 500px, so `object-cover` was discarding
             * roughly a sixth of every downloaded image. Astro's service derives
             * srcset heights from the *source* ratio unless both width and height
             * are given — with only `widths`, it emitted 720×1606 and shipped the
             * pixels it knew would be cropped.
             *
             * Naming a 9:16 target makes `getTargetDimensions` return it
             * untouched, so `widths` scales against 0.5625 and sharp crops to
             * cover. It also moves the `src` fallback off the full-size original
             * (a 462 KB PNG for the campus shot) onto the 720 variant.
             *
             * 9/16 rather than the mobile box's own ~0.74: above 1024px the
             * 500px cap does not bind and the slide really is 9:16, so cropping
             * tighter would start cutting the *sides* off the screenshot there.
             * This is the ratio that is lossless at the largest breakpoint.
             */
            width={720}
            height={1280}
            fit="cover"
            position="center"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            quality={72}
            loading="lazy"
            decoding="async"
             class="lt-shot-image w-full h-auto object-cover object-center"
          />
          <figcaption class="lt-shot-caption px-3 py-2 text-center text-label-large text-on-surface">
            {slide.label}
          </figcaption>
        </figure>
        </div>
      ))}
    </div>
  </div>

  <button id="carousel-prev" class="lt-arrow absolute left-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label={t("carousel.prev")}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button id="carousel-next" class="lt-arrow absolute right-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label={t("carousel.next")}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <!--
    `gap-0` is deliberate, not an oversight. Each dot button is a 24×24 CSS px
    hit box (WCAG 2.5.8), so the buttons already supply their own spacing; a
    gap on top would push the row past 200px. The visible marks stay small —
    what changed is that the *pitch* between them had to grow to 24px, because
    the alternative allowance in 2.5.8 (an undersized target whose 24px circle
    intersects no other target's) demands the same centre-to-centre distance.
  -->
  <div class="absolute bottom-3.5 left-1/2 -translate-x-1/2 flex items-center gap-0" data-carousel-controls>
    {slides.map((_, i) => (
      <button
        class="lt-dot"
        type="button"
        data-index={i}
        // Match what update() will compute, so the roving tabindex and
        // aria-current are already right before the module arrives — and stay
        // right if it never does.
        tabindex={i === 0 ? 0 : -1}
        aria-current={i === 0 ? "true" : undefined}
        aria-label={t("carousel.dot", { index: i + 1, label: slides[i].label })}
      ></button>
    ))}
    <!--
      WCAG 2.2.2: auto-advancing content needs a user-reachable pause, and
      hover-only pause fails keyboard and touch users outright. Hidden under
      reduced motion, where autoplay never starts (see script).
    -->
    <button id="carousel-pause" class="lt-pause" type="button" aria-label={i18n.pause} aria-pressed="false">
      <svg data-glyph="pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
      <svg data-glyph="play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.5-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
    </button>
  </div>

  <!--
    Announces slide changes, but only the ones the user caused — see announce()
    in the script. Feeding autoplay into a live region would have a screen
    reader interrupt whatever the user is doing every five seconds, which is
    worse than saying nothing.
  -->
  <p class="sr-only" role="status" aria-live="polite" data-carousel-status></p>
</div>

<style>
  /*
   * The panel is glass, so everything inside it inherits a blurred backdrop —
   * which means the nested surfaces must NOT blur again. A second
   * `backdrop-filter` over an already-blurred root costs a compositor layer and
   * changes nothing visually, so the shots and the arrows take translucency
   * only.
   */
  .lt-shot {
    background-color: var(--lt-glass-subtle);
    box-shadow:
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 10px 28px -16px hsl(215 45% 18% / 0.4);
    transition: box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lt-carousel-viewport {
    position: relative;
    overflow: hidden;
    min-height: 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 7%, black 93%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 7%, black 93%, transparent 100%);
  }

  /* Pointer-gated: hover styles stick after taps on touch devices. */
  @media (hover: hover) {
    .lt-shot:hover {
      box-shadow:
        inset 0 0 0 0.6px var(--lt-glass-edge),
        0 18px 40px -18px hsl(215 55% 18% / 0.52);
    }
  }

  .lt-shot-caption {
    background-color: var(--lt-glass-overlay);
    border-top: 0.6px solid var(--lt-glass-edge);
  }

  [data-carousel-form-controls] {
    z-index: 2;
  }

  .lt-form-toolbar {
    position: relative;
    z-index: 3;
    flex-wrap: nowrap;
  }

  .lt-form-switcher,
  .lt-theme-switcher {
    flex: none;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .lt-form-toolbar {
      flex-direction: column;
      align-items: center;
    }
  }

  .lt-form-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--lt-color-on-surface-variant);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .lt-form-toggle[data-active="true"] {
    color: var(--lt-color-on-primary-container);
    background-color: var(--lt-color-primary-container);
  }

  .lt-theme-toggle {
    color: var(--lt-color-on-surface-variant);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .lt-theme-toggle[data-active="true"] {
    color: var(--lt-color-on-primary-container);
    background-color: var(--lt-color-primary-container);
  }

  #carousel-track {
    --carousel-gap: 0.75rem;
    gap: var(--carousel-gap);
    align-items: flex-start;
    will-change: transform;
    min-height: 0;
    width: max-content;
  }

  #carousel-track > div {
    flex: 0 0 100%;
    min-width: 0;
  }

  .lt-shot-image {
    display: block;
    height: auto;
    aspect-ratio: 1170 / 2532;
  }

  [data-carousel-root][data-form="phone"] #carousel-track > div {
    flex-basis: calc((var(--carousel-width, 100%) - (var(--phone-cols, 1) - 1) * var(--carousel-gap)) / var(--phone-cols, 1));
  }

  [data-carousel-root][data-form="phone"] #carousel-track {
    width: var(--carousel-width, 100%);
  }

  [data-carousel-root][data-form="tablet"] #carousel-track > div {
    flex-basis: min(48vw, 31rem);
  }

  [data-carousel-root][data-form="desktop"] #carousel-track > div {
    flex-basis: min(72vw, 58rem);
  }

  [data-carousel-root][data-form="tablet"] #carousel-track,
  [data-carousel-root][data-form="desktop"] #carousel-track {
    width: max-content;
  }

  @media (min-width: 640px) {
    [data-carousel-root][data-form="phone"] #carousel-track > div {
      flex-basis: 50%;
    }
  }

  @media (min-width: 1024px) {
    [data-carousel-root][data-form="phone"] #carousel-track > div {
      flex-basis: 25%;
    }
  }

  [data-carousel-root][data-form="tablet"] .lt-shot,
  [data-carousel-root][data-form="desktop"] .lt-shot {
    border-radius: var(--lt-radius-card);
  }

  [data-carousel-root][data-form="tablet"] .lt-shot-image {
    aspect-ratio: 1668 / 2388;
  }

  [data-carousel-root][data-form="desktop"] .lt-shot-image {
    aspect-ratio: 2880 / 1800;
  }

  .lt-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--lt-color-on-surface-variant);
    background-color: var(--lt-glass-overlay);
    border: none;
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 6px 18px -8px hsl(215 45% 18% / 0.36);
    /* `scale` is its own property — `transition: transform` never covered it,
     * so the hover/press scaling below used to snap instead of easing. */
    transition:
      color 0.25s ease,
      scale 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }

  @media (hover: hover) {
    /* `-translate-y-1/2` owns the resting transform, so hover scales via the
     * individual `scale` property rather than a competing `transform`. */
    .lt-arrow:hover {
      color: var(--lt-color-primary);
      box-shadow:
        inset 0 1px 0 0 var(--lt-glass-rim),
        inset 0 0 0 0.6px var(--lt-glass-edge),
        0 10px 26px -10px hsl(215 45% 18% / 0.44);
      scale: 1.08;
    }
  }

  .lt-arrow:active {
    scale: 0.95;
  }

  /*
   * A 24×24 transparent hit box, with the visible mark on ::after.
   *
   * The previous version sized the *button* to the dot (6.4px) and grew a
   * ::before to fake a larger hit area. That failed twice over: 12.4px wide is
   * under the 24px floor in WCAG 2.5.8, and animating `width` on a button in a
   * flex row reflowed every sibling dot on each carousel step.
   *
   * The mark is now a fixed 1.15rem × 0.4rem box whose shape comes from
   * `clip-path`. Animating an inset rectangle is compositor-only — the element's
   * box never changes, so there is nothing left to lay out — and the geometry
   * stays exact: the browser clamps `round 999px` to half the *clipped* rect, so
   * the zero inset yields a stadium pill and the 0.375rem side insets
   * ((1.15rem - 0.4rem) / 2) yield a true circle. A `scaleX()` on the same pill
   * would have been composited too, but it stretches the end caps into ellipses
   * and the resting dot reads as a rounded square rather than a circle.
   */
  .lt-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    /* Keep a tap on a dot from being claimed as a scroll gesture first. */
    touch-action: manipulation;
  }

  .lt-dot::after {
    content: "";
    width: 1.15rem;
    height: 0.4rem;
    background-color: var(--lt-color-outline);
    opacity: 0.45;
    clip-path: inset(0 0.375rem 0 0.375rem round 999px);
    /* `background-color` is not transitioned: it is paint work, and a hue snap
     * under a 350ms shape morph on a 6.4px mark is not perceptible. */
    transition:
      clip-path 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .lt-dot[data-active="true"]::after {
    background-color: var(--lt-color-primary);
    opacity: 1;
    clip-path: inset(0 0 0 0 round 999px);
  }

  .lt-pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.35rem;
    padding: 0.4rem;
    color: var(--lt-color-on-surface-variant);
    background-color: var(--lt-glass-overlay);
    border: none;
    border-radius: 999px;
    box-shadow: inset 0 0 0 0.6px var(--lt-glass-edge);
    cursor: pointer;
    transition: color 0.25s ease, background-color 0.25s ease, scale 0.25s ease;
  }

  .lt-pause[data-paused="true"] {
    color: var(--lt-color-on-primary-container);
    background-color: var(--lt-color-primary-container);
    box-shadow: inset 0 0 0 1px var(--lt-color-primary);
  }

  @media (hover: hover) {
    .lt-pause:hover {
      color: var(--lt-color-primary);
    }
  }

  /* Applied for exactly one frame at the autoplay loop point — see advance().
   * Id + class beats the Tailwind `transition-transform` utility in both the
   * layered dev cascade and the flattened build. */
  #carousel-track.lt-cut {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-shot,
    .lt-arrow,
    .lt-dot::after {
      transition: none;
    }

    /* `transition: none` alone would leave the hover/press scale as an instant
     * jump; FriendLinks makes the same point for its dialog buttons. */
    .lt-arrow {
      scale: none;
    }

    /* Manual navigation still works; it just cuts instead of sliding. */
    #carousel-track {
      transition: none;
    }

    /* Autoplay never starts under reduced motion, so there is nothing to pause. */
    .lt-pause {
      display: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";

  onPageSetup((signal) => {
    const track = document.getElementById("carousel-track");
    const prev = document.getElementById("carousel-prev");
    const next = document.getElementById("carousel-next");
    const pauseBtn = document.getElementById("carousel-pause");
    const status = document.querySelector<HTMLElement>("[data-carousel-status]");
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".lt-dot"));
    const formControls = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-carousel-form-controls] [data-form]"),
    );
    const themeControls = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-carousel-theme-controls] [data-theme]"),
    );
    if (!track || !prev || !next) return;

    const total = dots.length;
    const container = track.parentElement;
    const root = track.closest<HTMLElement>("[data-carousel-root]");
    const controls = document.querySelector<HTMLElement>("[data-carousel-controls]");
    /*
     * Slide names read back out of the rendered figcaptions rather than passed
     * down from the frontmatter: a `<script>` is its own module, and getting the
     * list here would mean `define:vars`, which inlines the script and takes it
     * out of the bundle. The caption is already the source of truth for what a
     * slide is called, so the announcement cannot drift from it.
     */
    const labels = Array.from(track.children).map(
      (child) => child.querySelector("figcaption")?.textContent?.trim() ?? "",
    );

    /*
     * The strings this script speaks, read back off the root element.
     *
     * Same reasoning as `labels` above: a `<script>` is its own module, and
     * `define:vars` would inline it and drop it out of the bundle. The templates
     * are rendered into `data-i18n-*` by the frontmatter, so the announcement
     * grammar is translated along with the words instead of being baked into
     * concatenation here.
     */
    const dataset = root?.dataset ?? {};
    const copy = {
      pause: dataset.i18nPause ?? "",
      play: dataset.i18nPlay ?? "",
      announceRange: dataset.i18nAnnounceRange ?? "",
      announceSingle: dataset.i18nAnnounceSingle ?? "",
      announceWithLabels: dataset.i18nAnnounceWithLabels ?? "",
      announceBare: dataset.i18nAnnounceBare ?? "",
      separator: dataset.i18nSeparator ?? "",
      forms: {
        phone: dataset.i18nFormPhone ?? "Phone",
        tablet: dataset.i18nFormTablet ?? "Tablet",
        desktop: dataset.i18nFormDesktop ?? "Desktop",
      },
      themes: {
        auto: dataset.i18nThemeAuto ?? "Auto",
        light: dataset.i18nThemeLight ?? "Light",
        dark: dataset.i18nThemeDark ?? "Dark",
      },
    };

    let selectedTheme = "auto";
    let selectedForm = "phone";
    themeControls.forEach((button) => {
      const theme = button.dataset.theme ?? "auto";
      const label = button.querySelector("span");
      if (label) label.textContent = copy.themes[theme as keyof typeof copy.themes] ?? theme;
      button.setAttribute("aria-pressed", "false");
      button.addEventListener("click", () => {
        selectedTheme = theme;
        applyTheme();
      }, { signal });
    });

    function applyTheme() {
      root?.setAttribute("data-carousel-theme", selectedTheme);
      themeControls.forEach((button) => {
        const active = button.dataset.theme === selectedTheme;
        button.setAttribute("aria-pressed", String(active));
        button.dataset.active = String(active);
      });
      applyThemeImages();
    }

    function effectiveTheme() {
      if (selectedTheme !== "auto") return selectedTheme;
      return document.documentElement.classList.contains("dark") ? "dark" : "light";
    }

    function applyThemeImages() {
      const theme = effectiveTheme();
      const locale = root?.dataset.shotLocale ?? "zh-Hans";
      track.querySelectorAll<HTMLImageElement>("img[data-shot-name]").forEach((image) => {
        const name = image.dataset.shotName;
        if (!name) return;
        const source = `/screenshots/${locale}/${theme}/${selectedForm}/${name}.webp`;
        image.parentElement?.querySelectorAll("source").forEach((candidate) => {
          candidate.removeAttribute("srcset");
        });
        image.src = source;
        image.removeAttribute("srcset");
      });
    }
    applyTheme();

    const themeObserver = new MutationObserver(() => {
      if (selectedTheme === "auto") applyThemeImages();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    signal.addEventListener("abort", () => themeObserver.disconnect());

    let formLocked = false;
    formControls.forEach((button) => {
      const form = button.dataset.form ?? "phone";
      const label = button.querySelector("span");
      if (label) label.textContent = copy.forms[form as keyof typeof copy.forms] ?? form;
      button.setAttribute("aria-pressed", "false");
      button.addEventListener("click", () => {
        selectedForm = form;
        formLocked = true;
        applyForm();
      }, { signal });
    });

    function formForViewport() {
      if (window.innerWidth >= 1024) return "desktop";
      if (window.innerWidth >= 640) return "tablet";
      return "phone";
    }

    function applyForm() {
      const form = selectedForm;
      root?.setAttribute("data-form", form);
      track.querySelectorAll<HTMLImageElement>("img[data-phone-src]").forEach((image) => {
        const source = image.dataset[`${form}Src`] ?? image.dataset.phoneSrc;
        if (!source || image.src.endsWith(source)) return;
        // Astro's <Picture> emits <source> siblings for its initial srcset.
        // Once the user chooses a form factor, let the explicit image URL own
        // the selection; leaving those siblings active would make the browser
        // immediately pick the old phone candidate again on the next layout.
        image.parentElement?.querySelectorAll("source").forEach((candidate) => {
          candidate.removeAttribute("srcset");
        });
        image.src = source;
        image.removeAttribute("srcset");
        // The server-rendered phone Picture carries width/height attributes.
        // Leaving those dimensions on the swapped tablet/desktop source makes
        // the first desktop layout reserve a portrait-sized image box.
        image.removeAttribute("width");
        image.removeAttribute("height");
        image.loading = form === "phone" ? "lazy" : "eager";
      });
      applyThemeImages();
      formControls.forEach((button) => {
        const active = button.dataset.form === form;
        button.setAttribute("aria-pressed", String(active));
        button.dataset.active = String(active);
      });
    }

    selectedForm = formForViewport();
    applyForm();

    const trackResizeObserver = typeof ResizeObserver === "function"
      ? new ResizeObserver(() => update())
      : null;
    trackResizeObserver?.observe(track);
    signal.addEventListener("abort", () => trackResizeObserver?.disconnect());

    /**
     * `{name}` substitution.
     *
     * `String.prototype.replaceAll` is Chrome 85 and the bundle's floor is 66, so
     * this is a global regex instead. Unknown placeholders are left alone rather
     * than blanked, so a typo in a dictionary shows up in the announcement
     * instead of silently deleting part of the sentence.
     */
    function fill(template: string, vars: Record<string, string | number>): string {
      return template.replace(/\{([a-zA-Z][a-zA-Z0-9]*)\}/g, (match, name: string) =>
        Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : match,
      );
    }
    // Live read, not a snapshot: an OS reduced-motion flip mid-session has to
    // stop (or restart) autoplay — same contract as the hero rotator and the
    // dialog close timing.
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let resizeTimer = 0;
    let autoplay = 0;

    /*
     * Autoplay runs only when every gate is open. Each input (hover, focus,
     * visibility, viewport intersection, the pause button) flips its own flag
     * and then asks for a (re)start, so re-entering from any side can never
     * resume over a pause the user asked for.
     */
    let hovered = false;
    let focused = false;
    let userPaused = false;
    let inView = false;

    function getCols() {
      if (selectedForm !== "phone") return 1;
      if (window.innerWidth < 640) return 1;
      if (window.innerWidth < 1024) return 2;
      return 4;
    }

    function update() {
      const cols = getCols();
      if (container && root) {
        root.style.setProperty("--carousel-width", `${container.clientWidth}px`);
        root.style.setProperty("--phone-cols", String(cols));
      }
      const max = Math.max(0, total - cols);
      if (current > max) current = max;
      const activeSlide = track.children[current] as HTMLElement | undefined;
      const viewportWidth = container?.clientWidth ?? 0;
      const slideWidth = activeSlide?.getBoundingClientRect().width ?? 0;
      const target = selectedForm === "phone"
        ? (activeSlide?.offsetLeft ?? 0)
        : (activeSlide?.offsetLeft ?? 0) - (viewportWidth - slideWidth) / 2;
      const maxOffset = Math.max(0, track.scrollWidth - viewportWidth);
      track.style.transform = `translateX(-${Math.min(maxOffset, Math.max(0, target))}px)`;
      dots.forEach((dot, i) => {
        const active = i >= current && i < current + cols;
        dot.dataset.active = String(active);
        if (i === current) {
          dot.setAttribute("aria-current", "true");
          /*
           * Roving tabindex: the seven dots are one control, not seven tab
           * stops. Without this a keyboard user crossing the carousel pays ten
           * Tab presses (two arrows, seven dots, the pause button) to get past
           * a widget whose arrows already do the same job. Only the dot that
           * `aria-current` marks is reachable by Tab; the arrows below move
           * within the group, which is the standard composite-widget contract.
           */
          dot.tabIndex = 0;
        } else {
          dot.removeAttribute("aria-current");
          dot.tabIndex = -1;
        }
      });

      // The slide after the visible window is the next one autoplay will show;
      // its `loading="lazy"` image may not have been near the viewport yet,
      // which used to slide in as a white frame. Promote it to eager.
      const visibleEnd = Math.min(current + cols + 1, total);
      track.querySelectorAll<HTMLImageElement>("img[data-phone-src]").forEach((image, index) => {
        if (index >= current && index < visibleEnd && image.loading === "lazy") {
          image.loading = "eager";
        }
      });
    }

    function advance() {
      const max = Math.max(0, total - getCols());
      if (current >= max) {
        // Loop point: cut, do not rewind. Sliding back through every panel in
        // 500ms reads as a fast-forward accident; suppressing the transition
        // for one (forced) frame restarts the cycle in place instead.
        current = 0;
        track.classList.add("lt-cut");
        update();
        void track.offsetWidth; // flush the jump with the transition off
        track.classList.remove("lt-cut");
      } else {
        current += 1;
        update();
      }
    }

    function startAutoplay() {
      stopAutoplay();
      if (motionQuery.matches || userPaused || hovered || focused || !inView || document.hidden) return;
      autoplay = window.setInterval(advance, 5000);
    }

    function stopAutoplay() {
      window.clearInterval(autoplay);
      autoplay = 0;
    }

    function setPaused(paused: boolean) {
      userPaused = paused;
      if (paused) stopAutoplay();
      else startAutoplay();
      if (pauseBtn) {
        pauseBtn.setAttribute("aria-label", paused ? copy.play : copy.pause);
        pauseBtn.setAttribute("aria-pressed", String(paused));
        pauseBtn.dataset.paused = String(paused);
        const play = pauseBtn.querySelector<SVGElement>('[data-glyph="play"]');
        const pause = pauseBtn.querySelector<SVGElement>('[data-glyph="pause"]');
        if (play) play.hidden = !paused;
        if (pause) pause.hidden = paused;
      }
    }

    /*
     * Speak only what the user asked for. Autoplay deliberately does NOT call
     * this: a polite live region updated every five seconds interrupts whatever
     * else a screen reader user is doing, indefinitely, which is the classic way
     * an "accessible" carousel becomes unusable. The autoplay is already
     * pauseable and stops on focus, so a user who wants to inspect a slide can.
     *
     * `cols` slides are visible at once above 640px, so the announcement covers
     * the window rather than claiming a single slide is showing when four are.
     */
    function announce() {
      if (!status) return;
      const cols = getCols();
      const shown = labels.slice(current, current + cols).filter(Boolean);
      const from = current + 1;
      const to = Math.min(current + cols, total);
      const span = to > from
        ? fill(copy.announceRange, { from, to })
        : fill(copy.announceSingle, { from });
      status.textContent =
        shown.length > 0
          ? fill(copy.announceWithLabels, {
              span,
              total,
              labels: shown.join(copy.separator),
            })
          : fill(copy.announceBare, { span, total });
    }

    // A manual control should also restart the 5s clock, otherwise the next
    // auto-advance can land a beat after the user's own click.
    function manual(go: () => void) {
      go();
      announce();
      startAutoplay();
    }

    /*
     * Arrow keys move within the dot group (the roving-tabindex half of the
     * composite-widget contract) and Home/End jump to the ends. Scoped to the
     * controls row rather than the whole carousel, so the arrow buttons and the
     * pause button keep their normal Space/Enter behaviour and page-level arrow
     * scrolling is not hijacked from anywhere else.
     */
    function focusDot(index: number) {
      const clamped = Math.min(Math.max(0, index), Math.max(0, total - getCols()));
      manual(() => {
        current = clamped;
        update();
      });
      dots[clamped]?.focus();
    }

    controls?.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.classList.contains("lt-dot")) return;

      switch (event.key) {
        case "ArrowLeft":
        case "ArrowUp":
          event.preventDefault();
          focusDot(current - 1);
          break;
        case "ArrowRight":
        case "ArrowDown":
          event.preventDefault();
          focusDot(current + 1);
          break;
        case "Home":
          event.preventDefault();
          focusDot(0);
          break;
        case "End":
          event.preventDefault();
          focusDot(total - 1);
          break;
        default:
          break;
      }
    }, { signal });

    prev.addEventListener("click", () => manual(() => { current = Math.max(0, current - 1); update(); }), { signal });
    next.addEventListener("click", () => manual(() => {
      const max = Math.max(0, total - getCols());
      current = Math.min(current + 1, max);
      update();
    }), { signal });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => manual(() => {
        current = Math.min(parseInt(dot.dataset.index ?? "0"), Math.max(0, total - getCols()));
        update();
      }), { signal });
    });
    pauseBtn?.addEventListener("click", () => setPaused(!userPaused), { signal });

    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (!formLocked) {
          selectedForm = formForViewport();
          applyForm();
        }
        update();
      }, 100);
    }, { signal });

    // Pointer-gated hover: on touch, `pointerenter` also fires ahead of a tap,
    // which used to freeze autoplay until the user tapped somewhere else.
    container?.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      hovered = true;
      stopAutoplay();
    }, { signal });
    container?.addEventListener("pointerleave", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      hovered = false;
      startAutoplay();
    }, { signal });

    // Keyboard users get the same pause hover provides (WCAG 2.2.2).
    container?.addEventListener("focusin", () => { focused = true; stopAutoplay(); }, { signal });
    container?.addEventListener("focusout", () => { focused = false; startAutoplay(); }, { signal });

    // A background tab would otherwise keep advancing (and transitioning the
    // track) for nobody — same treatment the hero rotator gets.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    }, { signal });

    // Guarded for engines whose MediaQueryList is not an EventTarget; there
    // the live read inside startAutoplay still applies on every (re)start.
    if (typeof motionQuery.addEventListener === "function") {
      motionQuery.addEventListener("change", () => {
        if (motionQuery.matches) stopAutoplay();
        else startAutoplay();
      }, { signal });
    }

    // Scrolled past the carousel, there is nothing to animate. Also what makes
    // the `lazy` images safe: a slide only auto-advances while on screen.
    if (!("IntersectionObserver" in window)) {
      inView = true;
      startAutoplay();
    } else {
      const viewObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting;
            if (inView) startAutoplay();
            else stopAutoplay();
          }
        },
        { threshold: 0 },
      );
      if (container) viewObserver.observe(container);
      signal.addEventListener("abort", () => viewObserver.disconnect());
    }

    update();

    signal.addEventListener("abort", () => {
      stopAutoplay();
      window.clearTimeout(resizeTimer);
    });
  });
</script>
