---
import { Picture } from "astro:assets";
import scheduleShot from "../assets/screenshots/schedule.png";
import campusShot from "../assets/screenshots/campus.png";
import aiAssistantShot from "../assets/screenshots/ai-assistant.png";
import weatherDetailShot from "../assets/screenshots/weather-detail.png";
import weatherAqiShot from "../assets/screenshots/weather-aqi.png";
import busShot from "../assets/screenshots/bus.png";
import wallpaperShot from "../assets/screenshots/wallpaper.png";

const slides = [
  { label: "课程表", src: scheduleShot },
  { label: "校园应用", src: campusShot },
  { label: "AI 助手", src: aiAssistantShot },
  { label: "天气详情", src: weatherDetailShot },
  { label: "空气质量", src: weatherAqiShot },
  { label: "校车", src: busShot },
  { label: "壁纸中心", src: wallpaperShot },
];
---

<div class="lt-carousel glass relative overflow-hidden rounded-group pb-10">
  <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
    {slides.map((slide) => (
      <div class="shrink-0 w-full sm:w-1/2 lg:w-1/4 p-1.5">
        <figure class="lt-shot overflow-hidden rounded-nested">
          <Picture
            src={slide.src}
            alt={slide.label}
            formats={["avif", "webp"]}
            widths={[360, 720]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            quality={72}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover object-center aspect-[9/16] max-h-[500px]"
          />
          <figcaption class="lt-shot-caption px-3 py-2 text-center text-label-large text-on-surface">
            {slide.label}
          </figcaption>
        </figure>
      </div>
    ))}
  </div>

  <button id="carousel-prev" class="lt-arrow absolute left-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label="上一张">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button id="carousel-next" class="lt-arrow absolute right-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label="下一张">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <div class="absolute bottom-3.5 left-1/2 -translate-x-1/2 flex gap-1.5">
    {slides.map((_, i) => (
      <button class="lt-dot" data-index={i} aria-label={`第 ${i + 1} 张截图`}></button>
    ))}
  </div>
</div>

<style>
  /*
   * The panel is glass, so everything inside it inherits a blurred backdrop —
   * which means the nested surfaces must NOT blur again. A second
   * `backdrop-filter` over an already-blurred root costs a compositor layer and
   * changes nothing visually, so the shots and the arrows take translucency
   * only.
   */
  .lt-shot {
    background-color: var(--lt-glass-subtle);
    box-shadow:
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 10px 28px -16px hsl(215 45% 18% / 0.4);
    transition: box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lt-shot:hover {
    box-shadow:
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 18px 40px -18px hsl(215 55% 18% / 0.52);
  }

  .lt-shot-caption {
    background-color: var(--lt-glass-overlay);
    border-top: 0.6px solid var(--lt-glass-edge);
  }

  .lt-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--lt-color-on-surface-variant);
    background-color: var(--lt-glass-overlay);
    border: none;
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 6px 18px -8px hsl(215 45% 18% / 0.36);
    transition:
      color 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }

  .lt-arrow:hover {
    color: var(--lt-color-primary);
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 10px 26px -10px hsl(215 45% 18% / 0.44);
  }

  /* `-translate-y-1/2` owns the resting transform, so hover scales via the
   * individual `scale` property rather than a competing `transform`. */
  .lt-arrow:hover {
    scale: 1.08;
  }

  .lt-arrow:active {
    scale: 0.95;
  }

  .lt-dot {
    width: 0.4rem;
    height: 0.4rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background-color: var(--lt-color-outline);
    opacity: 0.45;
    cursor: pointer;
    transition:
      width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      background-color 0.35s ease;
  }

  .lt-dot[data-active="true"] {
    width: 1.15rem;
    opacity: 1;
    background-color: var(--lt-color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-shot,
    .lt-arrow,
    .lt-dot {
      transition: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";

  onPageSetup((signal) => {
    const track = document.getElementById("carousel-track");
    const prev = document.getElementById("carousel-prev");
    const next = document.getElementById("carousel-next");
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".lt-dot"));
    if (!track || !prev || !next) return;

    const total = dots.length;
    const container = track.parentElement;
    let current = 0;
    let resizeTimer = 0;
    let autoplay = 0;

    function getCols() {
      if (window.innerWidth < 640) return 1;
      if (window.innerWidth < 1024) return 2;
      return 4;
    }

    function update() {
      const cols = getCols();
      const max = Math.max(0, total - cols);
      if (current > max) current = max;
      const pct = 100 / cols;
      track.style.transform = `translateX(-${current * pct}%)`;
      dots.forEach((dot, i) => {
        dot.dataset.active = String(i >= current && i < current + cols);
      });
    }

    function advance() {
      const max = Math.max(0, total - getCols());
      current = current >= max ? 0 : current + 1;
      update();
    }

    function startAutoplay() {
      stopAutoplay();
      autoplay = window.setInterval(advance, 5000);
    }

    function stopAutoplay() {
      window.clearInterval(autoplay);
      autoplay = 0;
    }

    prev.addEventListener("click", () => { current = Math.max(0, current - 1); update(); }, { signal });
    next.addEventListener("click", () => {
      const max = Math.max(0, total - getCols());
      current = Math.min(current + 1, max);
      update();
    }, { signal });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        current = Math.min(parseInt(dot.dataset.index ?? "0"), Math.max(0, total - getCols()));
        update();
      }, { signal });
    });

    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(update, 100);
    }, { signal });

    container?.addEventListener("mouseenter", stopAutoplay, { signal });
    container?.addEventListener("mouseleave", startAutoplay, { signal });

    startAutoplay();
    update();

    signal.addEventListener("abort", () => {
      stopAutoplay();
      window.clearTimeout(resizeTimer);
    });
  });
</script>
