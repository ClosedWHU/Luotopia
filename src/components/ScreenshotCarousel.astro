---
import { Picture } from "astro:assets";
import scheduleShot from "../assets/screenshots/schedule.png";
import campusShot from "../assets/screenshots/campus.png";
import aiAssistantShot from "../assets/screenshots/ai-assistant.png";
import weatherDetailShot from "../assets/screenshots/weather-detail.png";
import weatherAqiShot from "../assets/screenshots/weather-aqi.png";
import busShot from "../assets/screenshots/bus.png";
import wallpaperShot from "../assets/screenshots/wallpaper.png";

const slides = [
  { label: "课程表", src: scheduleShot },
  { label: "校园应用", src: campusShot },
  { label: "AI 助手", src: aiAssistantShot },
  { label: "天气详情", src: weatherDetailShot },
  { label: "空气质量", src: weatherAqiShot },
  { label: "校车", src: busShot },
  { label: "壁纸中心", src: wallpaperShot },
];
---

<div
  class="lt-carousel glass relative overflow-hidden rounded-group pb-10"
  role="group"
  aria-roledescription="轮播"
  aria-label="应用界面截图"
  data-carousel-root
>
  <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
    {slides.map((slide) => (
      <div class="shrink-0 w-full sm:w-1/2 lg:w-1/4 p-1.5">
        <figure class="lt-shot overflow-hidden rounded-nested">
          <Picture
            src={slide.src}
            alt={slide.label}
            formats={["avif", "webp"]}
            widths={[360, 720]}
            /*
             * Crop at build time to the ratio the CSS actually shows.
             *
             * The captures are 1024×2284 (ratio 0.448) but the rendered box is
             * `aspect-[9/16]` capped at 500px, so `object-cover` was discarding
             * roughly a sixth of every downloaded image. Astro's service derives
             * srcset heights from the *source* ratio unless both width and height
             * are given — with only `widths`, it emitted 720×1606 and shipped the
             * pixels it knew would be cropped.
             *
             * Naming a 9:16 target makes `getTargetDimensions` return it
             * untouched, so `widths` scales against 0.5625 and sharp crops to
             * cover. It also moves the `src` fallback off the full-size original
             * (a 462 KB PNG for the campus shot) onto the 720 variant.
             *
             * 9/16 rather than the mobile box's own ~0.74: above 1024px the
             * 500px cap does not bind and the slide really is 9:16, so cropping
             * tighter would start cutting the *sides* off the screenshot there.
             * This is the ratio that is lossless at the largest breakpoint.
             */
            width={720}
            height={1280}
            fit="cover"
            position="center"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            quality={72}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover object-center aspect-[9/16] max-h-[500px]"
          />
          <figcaption class="lt-shot-caption px-3 py-2 text-center text-label-large text-on-surface">
            {slide.label}
          </figcaption>
        </figure>
      </div>
    ))}
  </div>

  <button id="carousel-prev" class="lt-arrow absolute left-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label="上一张">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button id="carousel-next" class="lt-arrow absolute right-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full cursor-pointer" aria-label="下一张">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <!--
    `gap-0` is deliberate, not an oversight. Each dot button is a 24×24 CSS px
    hit box (WCAG 2.5.8), so the buttons already supply their own spacing; a
    gap on top would push the row past 200px. The visible marks stay small —
    what changed is that the *pitch* between them had to grow to 24px, because
    the alternative allowance in 2.5.8 (an undersized target whose 24px circle
    intersects no other target's) demands the same centre-to-centre distance.
  -->
  <div class="absolute bottom-3.5 left-1/2 -translate-x-1/2 flex items-center gap-0" data-carousel-controls>
    {slides.map((_, i) => (
      <button
        class="lt-dot"
        type="button"
        data-index={i}
        // Match what update() will compute, so the roving tabindex and
        // aria-current are already right before the module arrives — and stay
        // right if it never does.
        tabindex={i === 0 ? 0 : -1}
        aria-current={i === 0 ? "true" : undefined}
        aria-label={`第 ${i + 1} 张截图：${slides[i].label}`}
      ></button>
    ))}
    <!--
      WCAG 2.2.2: auto-advancing content needs a user-reachable pause, and
      hover-only pause fails keyboard and touch users outright. Hidden under
      reduced motion, where autoplay never starts (see script).
    -->
    <button id="carousel-pause" class="lt-pause" type="button" aria-label="暂停自动轮播">
      <svg data-glyph="pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
      <svg data-glyph="play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.5-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
    </button>
  </div>

  <!--
    Announces slide changes, but only the ones the user caused — see announce()
    in the script. Feeding autoplay into a live region would have a screen
    reader interrupt whatever the user is doing every five seconds, which is
    worse than saying nothing.
  -->
  <p class="sr-only" role="status" aria-live="polite" data-carousel-status></p>
</div>

<style>
  /*
   * The panel is glass, so everything inside it inherits a blurred backdrop —
   * which means the nested surfaces must NOT blur again. A second
   * `backdrop-filter` over an already-blurred root costs a compositor layer and
   * changes nothing visually, so the shots and the arrows take translucency
   * only.
   */
  .lt-shot {
    background-color: var(--lt-glass-subtle);
    box-shadow:
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 10px 28px -16px hsl(215 45% 18% / 0.4);
    transition: box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Pointer-gated: hover styles stick after taps on touch devices. */
  @media (hover: hover) {
    .lt-shot:hover {
      box-shadow:
        inset 0 0 0 0.6px var(--lt-glass-edge),
        0 18px 40px -18px hsl(215 55% 18% / 0.52);
    }
  }

  .lt-shot-caption {
    background-color: var(--lt-glass-overlay);
    border-top: 0.6px solid var(--lt-glass-edge);
  }

  .lt-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--lt-color-on-surface-variant);
    background-color: var(--lt-glass-overlay);
    border: none;
    box-shadow:
      inset 0 1px 0 0 var(--lt-glass-rim),
      inset 0 0 0 0.6px var(--lt-glass-edge),
      0 6px 18px -8px hsl(215 45% 18% / 0.36);
    /* `scale` is its own property — `transition: transform` never covered it,
     * so the hover/press scaling below used to snap instead of easing. */
    transition:
      color 0.25s ease,
      scale 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }

  @media (hover: hover) {
    /* `-translate-y-1/2` owns the resting transform, so hover scales via the
     * individual `scale` property rather than a competing `transform`. */
    .lt-arrow:hover {
      color: var(--lt-color-primary);
      box-shadow:
        inset 0 1px 0 0 var(--lt-glass-rim),
        inset 0 0 0 0.6px var(--lt-glass-edge),
        0 10px 26px -10px hsl(215 45% 18% / 0.44);
      scale: 1.08;
    }
  }

  .lt-arrow:active {
    scale: 0.95;
  }

  /*
   * A 24×24 transparent hit box, with the visible mark on ::after.
   *
   * The previous version sized the *button* to the dot (6.4px) and grew a
   * ::before to fake a larger hit area. That failed twice over: 12.4px wide is
   * under the 24px floor in WCAG 2.5.8, and animating `width` on a button in a
   * flex row reflowed every sibling dot on each carousel step.
   *
   * The mark is now a fixed 1.15rem × 0.4rem box whose shape comes from
   * `clip-path`. Animating an inset rectangle is compositor-only — the element's
   * box never changes, so there is nothing left to lay out — and the geometry
   * stays exact: the browser clamps `round 999px` to half the *clipped* rect, so
   * the zero inset yields a stadium pill and the 0.375rem side insets
   * ((1.15rem - 0.4rem) / 2) yield a true circle. A `scaleX()` on the same pill
   * would have been composited too, but it stretches the end caps into ellipses
   * and the resting dot reads as a rounded square rather than a circle.
   */
  .lt-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    /* Keep a tap on a dot from being claimed as a scroll gesture first. */
    touch-action: manipulation;
  }

  .lt-dot::after {
    content: "";
    width: 1.15rem;
    height: 0.4rem;
    background-color: var(--lt-color-outline);
    opacity: 0.45;
    clip-path: inset(0 0.375rem 0 0.375rem round 999px);
    /* `background-color` is not transitioned: it is paint work, and a hue snap
     * under a 350ms shape morph on a 6.4px mark is not perceptible. */
    transition:
      clip-path 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .lt-dot[data-active="true"]::after {
    background-color: var(--lt-color-primary);
    opacity: 1;
    clip-path: inset(0 0 0 0 round 999px);
  }

  .lt-pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.35rem;
    padding: 0.4rem;
    color: var(--lt-color-on-surface-variant);
    background-color: var(--lt-glass-overlay);
    border: none;
    border-radius: 999px;
    box-shadow: inset 0 0 0 0.6px var(--lt-glass-edge);
    cursor: pointer;
    transition: color 0.25s ease;
  }

  @media (hover: hover) {
    .lt-pause:hover {
      color: var(--lt-color-primary);
    }
  }

  /* Applied for exactly one frame at the autoplay loop point — see advance().
   * Id + class beats the Tailwind `transition-transform` utility in both the
   * layered dev cascade and the flattened build. */
  #carousel-track.lt-cut {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-shot,
    .lt-arrow,
    .lt-dot::after {
      transition: none;
    }

    /* Manual navigation still works; it just cuts instead of sliding. */
    #carousel-track {
      transition: none;
    }

    /* Autoplay never starts under reduced motion, so there is nothing to pause. */
    .lt-pause {
      display: none;
    }
  }
</style>

<script>
  import { onPageSetup } from "../scripts/page-lifecycle";

  onPageSetup((signal) => {
    const track = document.getElementById("carousel-track");
    const prev = document.getElementById("carousel-prev");
    const next = document.getElementById("carousel-next");
    const pauseBtn = document.getElementById("carousel-pause");
    const status = document.querySelector<HTMLElement>("[data-carousel-status]");
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".lt-dot"));
    if (!track || !prev || !next) return;

    const total = dots.length;
    const container = track.parentElement;
    const controls = document.querySelector<HTMLElement>("[data-carousel-controls]");
    /*
     * Slide names read back out of the rendered figcaptions rather than passed
     * down from the frontmatter: a `<script>` is its own module, and getting the
     * list here would mean `define:vars`, which inlines the script and takes it
     * out of the bundle. The caption is already the source of truth for what a
     * slide is called, so the announcement cannot drift from it.
     */
    const labels = Array.from(track.children).map(
      (child) => child.querySelector("figcaption")?.textContent?.trim() ?? "",
    );
    // Live read, not a snapshot: an OS reduced-motion flip mid-session has to
    // stop (or restart) autoplay — same contract as the hero rotator and the
    // dialog close timing.
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let resizeTimer = 0;
    let autoplay = 0;

    /*
     * Autoplay runs only when every gate is open. Each input (hover, focus,
     * visibility, viewport intersection, the pause button) flips its own flag
     * and then asks for a (re)start, so re-entering from any side can never
     * resume over a pause the user asked for.
     */
    let hovered = false;
    let focused = false;
    let userPaused = false;
    let inView = false;

    function getCols() {
      if (window.innerWidth < 640) return 1;
      if (window.innerWidth < 1024) return 2;
      return 4;
    }

    function update() {
      const cols = getCols();
      const max = Math.max(0, total - cols);
      if (current > max) current = max;
      const pct = 100 / cols;
      track.style.transform = `translateX(-${current * pct}%)`;
      dots.forEach((dot, i) => {
        const active = i >= current && i < current + cols;
        dot.dataset.active = String(active);
        if (i === current) {
          dot.setAttribute("aria-current", "true");
          /*
           * Roving tabindex: the seven dots are one control, not seven tab
           * stops. Without this a keyboard user crossing the carousel pays ten
           * Tab presses (two arrows, seven dots, the pause button) to get past
           * a widget whose arrows already do the same job. Only the dot that
           * `aria-current` marks is reachable by Tab; the arrows below move
           * within the group, which is the standard composite-widget contract.
           */
          dot.tabIndex = 0;
        } else {
          dot.removeAttribute("aria-current");
          dot.tabIndex = -1;
        }
      });

      // The slide after the visible window is the next one autoplay will show;
      // its `loading="lazy"` image may not have been near the viewport yet,
      // which used to slide in as a white frame. Promote it to eager.
      const upcoming = track.children[Math.min(current + cols, total - 1)]?.querySelector("img");
      if (upcoming instanceof HTMLImageElement && upcoming.loading === "lazy") {
        upcoming.loading = "eager";
      }
    }

    function advance() {
      const max = Math.max(0, total - getCols());
      if (current >= max) {
        // Loop point: cut, do not rewind. Sliding back through every panel in
        // 500ms reads as a fast-forward accident; suppressing the transition
        // for one (forced) frame restarts the cycle in place instead.
        current = 0;
        track.classList.add("lt-cut");
        update();
        void track.offsetWidth; // flush the jump with the transition off
        track.classList.remove("lt-cut");
      } else {
        current += 1;
        update();
      }
    }

    function startAutoplay() {
      stopAutoplay();
      if (motionQuery.matches || userPaused || hovered || focused || !inView || document.hidden) return;
      autoplay = window.setInterval(advance, 5000);
    }

    function stopAutoplay() {
      window.clearInterval(autoplay);
      autoplay = 0;
    }

    function setPaused(paused: boolean) {
      userPaused = paused;
      if (paused) stopAutoplay();
      else startAutoplay();
      if (pauseBtn) {
        pauseBtn.setAttribute("aria-label", paused ? "继续自动轮播" : "暂停自动轮播");
        const play = pauseBtn.querySelector<SVGElement>('[data-glyph="play"]');
        const pause = pauseBtn.querySelector<SVGElement>('[data-glyph="pause"]');
        if (play) play.hidden = !paused;
        if (pause) pause.hidden = paused;
      }
    }

    /*
     * Speak only what the user asked for. Autoplay deliberately does NOT call
     * this: a polite live region updated every five seconds interrupts whatever
     * else a screen reader user is doing, indefinitely, which is the classic way
     * an "accessible" carousel becomes unusable. The autoplay is already
     * pauseable and stops on focus, so a user who wants to inspect a slide can.
     *
     * `cols` slides are visible at once above 640px, so the announcement covers
     * the window rather than claiming a single slide is showing when four are.
     */
    function announce() {
      if (!status) return;
      const cols = getCols();
      const shown = labels.slice(current, current + cols).filter(Boolean);
      const from = current + 1;
      const to = Math.min(current + cols, total);
      const span = to > from ? `第 ${from} 到 ${to} 张` : `第 ${from} 张`;
      status.textContent = shown.length > 0 ? `${span}，共 ${total} 张：${shown.join("、")}` : `${span}，共 ${total} 张`;
    }

    // A manual control should also restart the 5s clock, otherwise the next
    // auto-advance can land a beat after the user's own click.
    function manual(go: () => void) {
      go();
      announce();
      startAutoplay();
    }

    /*
     * Arrow keys move within the dot group (the roving-tabindex half of the
     * composite-widget contract) and Home/End jump to the ends. Scoped to the
     * controls row rather than the whole carousel, so the arrow buttons and the
     * pause button keep their normal Space/Enter behaviour and page-level arrow
     * scrolling is not hijacked from anywhere else.
     */
    function focusDot(index: number) {
      const clamped = Math.min(Math.max(0, index), Math.max(0, total - getCols()));
      manual(() => {
        current = clamped;
        update();
      });
      dots[clamped]?.focus();
    }

    controls?.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.classList.contains("lt-dot")) return;

      switch (event.key) {
        case "ArrowLeft":
        case "ArrowUp":
          event.preventDefault();
          focusDot(current - 1);
          break;
        case "ArrowRight":
        case "ArrowDown":
          event.preventDefault();
          focusDot(current + 1);
          break;
        case "Home":
          event.preventDefault();
          focusDot(0);
          break;
        case "End":
          event.preventDefault();
          focusDot(total - 1);
          break;
        default:
          break;
      }
    }, { signal });

    prev.addEventListener("click", () => manual(() => { current = Math.max(0, current - 1); update(); }), { signal });
    next.addEventListener("click", () => manual(() => {
      const max = Math.max(0, total - getCols());
      current = Math.min(current + 1, max);
      update();
    }), { signal });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => manual(() => {
        current = Math.min(parseInt(dot.dataset.index ?? "0"), Math.max(0, total - getCols()));
        update();
      }), { signal });
    });
    pauseBtn?.addEventListener("click", () => setPaused(!userPaused), { signal });

    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(update, 100);
    }, { signal });

    // Pointer-gated hover: on touch, `pointerenter` also fires ahead of a tap,
    // which used to freeze autoplay until the user tapped somewhere else.
    container?.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      hovered = true;
      stopAutoplay();
    }, { signal });
    container?.addEventListener("pointerleave", (e) => {
      if ((e as PointerEvent).pointerType !== "mouse") return;
      hovered = false;
      startAutoplay();
    }, { signal });

    // Keyboard users get the same pause hover provides (WCAG 2.2.2).
    container?.addEventListener("focusin", () => { focused = true; stopAutoplay(); }, { signal });
    container?.addEventListener("focusout", () => { focused = false; startAutoplay(); }, { signal });

    // A background tab would otherwise keep advancing (and transitioning the
    // track) for nobody — same treatment the hero rotator gets.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    }, { signal });

    // Guarded for engines whose MediaQueryList is not an EventTarget; there
    // the live read inside startAutoplay still applies on every (re)start.
    if (typeof motionQuery.addEventListener === "function") {
      motionQuery.addEventListener("change", () => {
        if (motionQuery.matches) stopAutoplay();
        else startAutoplay();
      }, { signal });
    }

    // Scrolled past the carousel, there is nothing to animate. Also what makes
    // the `lazy` images safe: a slide only auto-advances while on screen.
    if (!("IntersectionObserver" in window)) {
      inView = true;
      startAutoplay();
    } else {
      const viewObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting;
            if (inView) startAutoplay();
            else stopAutoplay();
          }
        },
        { threshold: 0 },
      );
      if (container) viewObserver.observe(container);
      signal.addEventListener("abort", () => viewObserver.disconnect());
    }

    update();

    signal.addEventListener("abort", () => {
      stopAutoplay();
      window.clearTimeout(resizeTimer);
    });
  });
</script>
