---
  /*
   * MiSans supplies CJK; Plus Jakarta Sans supplies Latin and sits ahead of it
   * in --font-sans. Both are self-hosted and imported as modules so Vite emits
   * hashed font assets and the MiSans weight-remap plugin can run.
   *
   * All of them land in the one shared sheet no matter what: Astro bundles CSS
   * by import graph, not by render tree, so a per-locale conditional component
   * cannot move a family into a locale-only stylesheet. The lever that works
   * inside a shared sheet is `pruneFontSubsets` knowing which locales can reach
   * each family — see tools/vite/font-plugins.mjs.
   */
  import { ClientRouter } from "astro:transitions";
  import "@fontsource-variable/plus-jakarta-sans/wght.css";
  import "misans/lib/Normal/MiSans-Regular.min.css";
  import "misans/lib/Normal/MiSans-Medium.min.css";
  import "@fontsource/noto-sans-tc/400.css";
  import "@fontsource/noto-sans-tc/500.css";
  import "@fontsource/noto-sans-jp/400.css";
  import "@fontsource/noto-sans-jp/500.css";
  import "@fontsource/noto-sans-kr/400.css";
  import "@fontsource/noto-sans-kr/500.css";
  import "../styles/global.css";
  import Navbar from "../components/Navbar.astro";
  import Footer from "../components/Footer.astro";
  import AuroraBackground from "../components/AuroraBackground.astro";
  import plusJakartaSansLatin from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2";
  import {
    hreflangAlternates,
    localeMeta,
    resolveLocale,
    useTranslations,
  } from "../i18n/ui";

  export interface Props {
    title: string;
    description?: string;
    /** Drop the Navbar/Footer chrome — for utility pages like the app-launch
     *  landing, where site navigation would compete with the single CTA. */
    bare?: boolean;
    /** Emit `<meta name="robots" content="noindex">` — for pages that are
     *  launch/redirect utilities rather than content. */
    noindex?: boolean;
  }

  const { title, description, bare = false, noindex = false } = Astro.props;

  /*
   * `Astro.currentLocale` is the only locale input: Astro sets it from the route
   * (`/en/features` → `en`, `/features` → the default), so nothing has to be
   * threaded down from the page and a page cannot get it wrong. `resolveLocale`
   * folds anything unexpected back onto the default rather than throwing.
   */
  const locale = resolveLocale(Astro.currentLocale);
  const meta = localeMeta(locale);
  const t = useTranslations(locale);
  /*
   * No alternate-language cluster on a `noindex` page. Crawlers ignore `hreflang`
   * there, and `/open` and `/404` would otherwise each emit eleven `<link>` tags
   * describing a cluster nobody is allowed to index. Suppressing on every locale
   * keeps the cluster symmetric — an asymmetric one is worse than an absent one.
   */
  const alternates = noindex ? [] : hreflangAlternates(Astro.url.pathname);
  const resolvedDescription = description ?? t("meta.default.description");
  const resolvedOgDescription = description ?? t("meta.default.ogDescription");
---

<!doctype html>
<html lang={meta.hreflang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <ClientRouter fallback="swap" />
    <meta name="description" content={resolvedDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content="/img/app-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      /*
       * The alternate-language cluster. Emitted for every locale that really has
       * this page plus `x-default`; see `hreflangAlternates` for why claiming a
       * locale that 404s is worse than claiming none.
       */
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    <!-- SVG follows OS color scheme: transparent plate in light, white plate in dark. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={plusJakartaSansLatin}
      crossorigin
    />
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      if (params.get("kiosk") === "1") {
        document.documentElement.dataset.kiosk = "true";
      }
    </script>
    <style is:global>
      html[data-kiosk="true"] body > nav,
      html[data-kiosk="true"] body > footer {
        display: none;
      }
    </style>
    <script is:inline>
      // Theme resolution.
      //
      // `?theme=dark|light` wins outright: in-app WebViews cannot be relied on
      // to report the host app's appearance. Android WebView answers
      // `prefers-color-scheme: light` unless the app opts into algorithmic
      // darkening, and WKWebView/WebView2 follow their own host settings, so
      // the app passes its effective brightness explicitly instead.
      //
      // localStorage can throw (restricted WebView storage, private mode),
      // which used to kill this script before the media query was consulted.
      (function () {
        const requested = new URLSearchParams(window.location.search).get("theme");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        const dark =
          requested === "dark" || requested === "light"
            ? requested === "dark"
            : stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <script is:inline>
      // Reveal failsafe. Scroll reveals are driven by an external module
      // script; `.lt-reveal` content starts at opacity 0 in the stylesheet.
      // When that module never arrives — flaky networks, blocked or failed
      // subresources in embedded WebViews — the page would strand its own
      // headings invisible forever. If the module has not claimed ownership
      // by the deadline, show everything immediately.
      //
      // The deadline is only 2.5s for kernels that *could* run the module.
      // Below the bundle's floor — ES modules are Chrome 61, and
      // page-lifecycle needs AbortController (66) — no network condition
      // will ever deliver it, so waiting the full grace period just shows
      // old-WebView users (the app's legal pages run in exactly those) a
      // blank page for 2.5 seconds. ES5 only: this script is the last line
      // of defense on engines where nothing else runs.
      var ltModulesCanRun =
        "noModule" in document.createElement("script") &&
        typeof AbortController === "function";
      window.__ltRevealsFallback = setTimeout(function () {
        if (window.__ltRevealsOwned) return;
        document.querySelectorAll(".lt-reveal, .lt-reveal-lift").forEach(function (el) {
          el.dataset.revealed = "true";
        });
      }, ltModulesCanRun ? 2500 : 300);
    </script>
    <noscript>
      <!-- The inline failsafe above still needs JS. With scripting off entirely,
           `.lt-reveal` content would stay at opacity 0 forever, so reveal it
           unconditionally. The `html` prefix outranks the base rules regardless
           of stylesheet order. `.lt-reveal-lift` needs no help: it only offsets,
           never hides. -->
      <style>
        html .lt-reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
    <script is:inline>
      // Drop legacy Service Workers / caches from the previous site on this domain
      (function () {
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (reg) {
              reg.unregister();
            });
          });
        }
        if ("caches" in window) {
          caches.keys().then(function (keys) {
            keys.forEach(function (key) {
              caches.delete(key);
            });
          });
        }
      })();
    </script>
    <title>{title} | Luotopia</title>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <AuroraBackground />
    <!--
      First focusable element in the document, so one Tab press reaches it.
      Without this a keyboard user repeats the whole navbar — brand, every nav
      link, the theme toggle, the download CTA — on every single page.

      Not rendered on `bare` pages: those drop the navbar, so the page *is* the
      single CTA and there is no chrome to skip past.
    -->
    {!bare && <a href="#lt-main" class="lt-skip text-label-large">{t("a11y.skipToContent")}</a>}
    {!bare && <Navbar />}
    <!--
      `tabindex="-1"` is what makes the skip link actually move focus rather
      than just scroll: an element that is not focusable cannot receive it, and
      several browsers then leave focus on the link. The matching
      `#lt-main:focus` rule in global.css suppresses the outline, so the
      programmatic focus does not draw a ring around the entire page.
    -->
    <main id="lt-main" class="flex-1 relative z-10" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>

<script>
  import Lenis from "lenis";
  import { onPageSetup } from "../scripts/page-lifecycle";

  type BeforeSwapEvent = Event & { newDocument?: Document };

  /*
   * Site-wide client runtime.
   *
   * Smooth scroll is not decoration here: with a page-fixed aurora behind
   * glass, native jumpy scrolling makes the blur strobe against the field.
   * Lenis interpolates instead, so the refraction reads as depth. The instance
   * is exposed for modal code that must freeze the page — `body { overflow:
   * hidden }` no longer does anything once Lenis owns the scroll position.
   *
   * Under Client Router the same bundled script is not re-executed on every
   * navigation, so Lenis is created once and deliberately survives swaps. The
   * router restores scroll natively; Lenis only has to resynchronize.
   */
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let lenis: Lenis | undefined;
  if (!reduceMotion) {
    /*
     * `lerp` mode, not `duration`. Duration+easing runs every wheel tick as a
     * full timed animation that the next tick retargets — at 1.1s with an
     * expo-out tail (the last 2% of the distance took over half a second) the
     * page kept gliding long after the input stopped, which read as scrolling
     * through syrup. Lerp instead follows the input exponentially per frame:
     * it converges within ~20 frames of the wheel stopping, so the page stays
     * smooth but tracks the hand.
     *
     * `touchMultiplier` was dropped along with the old config: it only scales
     * the deltas Lenis *emits*, and with `syncTouch` off (the default) touch
     * scrolling is native, so it never had an effect.
     *
     * The manual reduced-motion gate stays even though Lenis 1.3.x has
     * `respectReducedMotion` (default true): that only forces lerp to 1, which
     * still keeps scrolling on the main thread. Not mounting at all hands
     * reduced-motion users the compositor-driven native scroll instead.
     */
    lenis = new Lenis({
      lerp: 0.11,
      autoRaf: true,
      anchors: true,
      stopInertiaOnNavigate: true,
    });
  }
  (window as unknown as { ltLenis?: Lenis }).ltLenis = lenis;

  function preserveRootState(event: Event) {
    const nextRoot = (event as BeforeSwapEvent).newDocument?.documentElement;
    if (!nextRoot) return;

    // Astro replaces <html> attributes from the fetched document. The theme and
    // kiosk states are client-only, so copy them across before the swap rather
    // than letting the new server-rendered root flash back to light/default.
    nextRoot.classList.toggle("dark", document.documentElement.classList.contains("dark"));
    const kiosk = document.documentElement.dataset.kiosk;
    if (kiosk) nextRoot.dataset.kiosk = kiosk;
    else nextRoot.removeAttribute("data-kiosk");
  }

  /* Scroll reveal. Unobserve after firing — a reveal that can retrigger on
   * every scroll-up is a fidget toy, not a transition.
   *
   * The negative bottom root margin makes elements animate just after they
   * enter rather than exactly at the edge, but it also carves 8% off the bottom
   * of the root. On a page short enough to fit the viewport with no scroll, an
   * element sitting in that band would never intersect and would stay at
   * opacity 0 forever — invisible content. So the inset is only applied when
   * the document can actually scroll.
   */
  let revealObserver: IntersectionObserver | undefined;

  function teardownReveals() {
    revealObserver?.disconnect();
    revealObserver = undefined;
  }

  function initReveals() {
    teardownReveals();

    // Claim ownership from the inline failsafe (see <head>): from here on the
    // IntersectionObserver decides when content appears.
    (window as unknown as { __ltRevealsOwned?: boolean }).__ltRevealsOwned = true;
    clearTimeout(
      (window as unknown as { __ltRevealsFallback?: number }).__ltRevealsFallback,
    );

    const revealables = document.querySelectorAll<HTMLElement>(".lt-reveal, .lt-reveal-lift");
    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealables.forEach((el) => (el.dataset.revealed = "true"));
      return;
    }

    const canScroll = document.documentElement.scrollHeight > window.innerHeight + 16;
    revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.revealed = "true";
          revealObserver?.unobserve(entry.target);
        }
      },
      { rootMargin: canScroll ? "0px 0px -8% 0px" : "0px", threshold: 0 },
    );

    revealables.forEach((el) => {
      if (el.dataset.revealed === "true") return;
      revealObserver?.observe(el);
    });
  }

  document.addEventListener("astro:before-swap", (event) => {
    preserveRootState(event);
  });

  document.addEventListener("astro:after-swap", () => {
    lenis?.resize();
    lenis?.start();
  });

  /*
   * The scene light.
   *
   * One pointer, every glass surface: each card is told where the light falls in
   * its own local percentages and which way its lit edge faces, so a cursor
   * sitting between two cards lights the near edge of both and each glint lands
   * where the cursor actually is. The aurora behind them already drifts on its
   * own; this is the half that answers the pointer.
   *
   * It used to be one `pointermove` listener per card, gated on `.lt-lift`,
   * which lit only the card under the cursor and left everything else — the two
   * big install/package panels on /download, every changelog card — permanently
   * at the resting corner. Hence "the background moves but the cards are lit
   * from a fixed lamp".
   *
   * Two things worth not "fixing" later:
   *
   * - The local coordinates are deliberately **not** clamped to 0-100%. A
   *   cursor 800px left of a card resolves to something like -260%, which puts
   *   the 480px glint entirely outside the box: distance falloff falls out of
   *   the geometry. Clamping to the box would pin the glint to the near edge and
   *   light every card on the page at full strength, and modulating the colour
   *   instead would need `color-mix()` (111+) to keep the theme tokens.
   * - Values are percentages and degrees, never px. All three properties are
   *   registered in global.css (`<length-percentage>` / `<angle>`) so they
   *   interpolate, and a length cannot tween into a percentage — mixing units
   *   silently downgrades the transition to the discrete snap @property was
   *   added to remove.
   */
  onPageSetup((signal) => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* Beyond this distance from a card's nearest edge the glint is outside the
     * box anyway and the edge wash is the only term left, so the card goes back
     * to its resting light instead of carrying a stale direction. Measured from
     * the edge rather than the centre: a panel spanning the viewport is "near"
     * wherever the cursor is along it. */
    const REACH = 1200;
    /* Keeps the percentages finite on a small card the cursor is far from. The
     * value is well past where the glint has left the box. */
    const CLAMP = 1000;

    let surfaces: HTMLElement[] = [];
    let frame = 0;
    let scanFrame = 0;
    let pointerX = 0;
    let pointerY = 0;

    const scan = () => {
      surfaces = Array.from(document.querySelectorAll<HTMLElement>(".glass"));
    };

    const unlight = (surface: HTMLElement) => {
      surface.style.removeProperty("--lt-light-x");
      surface.style.removeProperty("--lt-light-y");
      surface.style.removeProperty("--lt-light-angle");
    };

    const rest = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      surfaces.forEach(unlight);
    };

    const paint = () => {
      frame = 0;
      if (!surfaces.length) return;
      const clamp = (value: number) => Math.max(-CLAMP, Math.min(CLAMP, value));
      /* Every rect first, then every write. Interleaving them would invalidate
       * style on the first write and force a reflow on the second read — twenty
       * cards is twenty reflows a frame instead of one. */
      const rects = surfaces.map((surface) => surface.getBoundingClientRect());
      for (let i = 0; i < surfaces.length; i++) {
        const rect = rects[i];
        const surface = surfaces[i];
        if (!rect.width || !rect.height) continue;
        const dx = pointerX - (rect.left + rect.width / 2);
        const dy = pointerY - (rect.top + rect.height / 2);
        const nearest = Math.max(
          Math.abs(dx) - rect.width / 2,
          Math.abs(dy) - rect.height / 2,
          0,
        );
        if (nearest > REACH) {
          unlight(surface);
          continue;
        }
        const x = clamp(((pointerX - rect.left) / rect.width) * 100);
        const y = clamp(((pointerY - rect.top) / rect.height) * 100);
        /* 0deg is up and turns clockwise, and a gradient's bright start is the
         * side *opposite* its angle — so point away from the cursor to light the
         * edge facing it. `atan2(dx, -dy)` is the CSS convention (y down on
         * screen, y up in the angle space); the half turn is the flip. */
        const angle = ((Math.atan2(dx, -dy) * 180) / Math.PI + 540) % 360;
        surface.style.setProperty("--lt-light-x", `${x.toFixed(2)}%`);
        surface.style.setProperty("--lt-light-y", `${y.toFixed(2)}%`);
        surface.style.setProperty("--lt-light-angle", `${angle.toFixed(1)}deg`);
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(paint);
    };

    const onMove = (event: PointerEvent) => {
      if (!fine.matches || motion.matches || event.pointerType === "touch") return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      schedule();
    };

    /* The pointer leaving the window: `pointerout` with no `relatedTarget` is
     * the reliable spelling, since `pointerleave` does not bubble and its target
     * is whatever element the cursor happened to be over. */
    const onOut = (event: PointerEvent) => {
      if (event.relatedTarget || event.pointerType === "touch") return;
      rest();
    };

    scan();
    document.addEventListener("pointermove", onMove, { signal, passive: true });
    document.addEventListener("pointerout", onOut, { signal, passive: true });
    /* Repaint while the page scrolls: the light is anchored to a point on the
     * page, so a card sliding under a stationary cursor has to have its local
     * coordinates recomputed or the glint rides along with the card. */
    window.addEventListener("scroll", schedule, { signal, passive: true });
    window.addEventListener("resize", schedule, { signal, passive: true });
    window.addEventListener("blur", rest, { signal });
    motion.addEventListener("change", rest, { signal });
    fine.addEventListener("change", rest, { signal });

    /* The changelog's release cards are built at runtime, and a NodeList taken
     * at setup never sees them. Re-scan when the tree changes, coalesced to one
     * pass per frame — the notes inject a lot of HTML in one go. */
    let observer: MutationObserver | undefined;
    if ("MutationObserver" in window) {
      observer = new MutationObserver(() => {
        if (scanFrame) return;
        scanFrame = requestAnimationFrame(() => {
          scanFrame = 0;
          scan();
          schedule();
        });
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }

    return () => {
      cancelAnimationFrame(frame);
      cancelAnimationFrame(scanFrame);
      frame = 0;
      scanFrame = 0;
      observer?.disconnect();
      observer = undefined;
      surfaces.forEach(unlight);
      surfaces = [];
    };
  });

  onPageSetup(() => {
    lenis?.resize();
    initReveals();
    return teardownReveals;
  });
</script>
