{
  "name": "luotopia-homepage",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:aasa": "node tools/verify-aasa.mjs",
    "hot-update:init-key": "node tools/generate-hot-update-manifest.mjs --init-key",
    "hot-update:generate": "node tools/generate-hot-update-manifest.mjs",
    "hot-update:verify": "node tools/generate-hot-update-manifest.mjs --verify",
    "scales:generate": "node tools/generate-scale-manifest.mjs",
    "scales:check": "node tools/generate-scale-manifest.mjs --check",
    "scales:mmpi2": "node tools/build-mmpi2-scale.cjs",
    "scales:mmpi2:short": "node tools/build-mmpi2-scale.cjs --short 370",
    "prebuild": "npm run check:aasa && npm run hot-update:generate && npm run scales:generate"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.5",
    "@paper-design/shaders": "^0.0.81",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "lenis": "^1.3.26",
    "misans": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "postcss": "^8.5.28"
  },
  "overrides": {
    "devalue": "^5.9.4"
  }
}
