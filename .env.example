# Local / Cloudflare Pages secrets for App Store Connect (optional)
# Enable: APPSTORE_CONNECT=1
# Do not commit real values. Set the same keys in Cloudflare Pages → Settings → Environment variables (Secrets).

APPSTORE_CONNECT=0
APPSTORE_CONNECT_KEY_ID=R4CW927W99
APPSTORE_CONNECT_ISSUER_ID=
# PEM with literal \n newlines (or paste multi-line in CF dashboard)
APPSTORE_CONNECT_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=sb.whu.luotopia
APPSTORE_COUNTRY=cn

# Ed25519 PKCS#8 private key in base64. Generate locally with:
# npm run hot-update:init-key
HOT_UPDATE_ED25519_PRIVATE_KEY=

# /status — UptimeRobot (required for the status page, optional otherwise)
# A Read-Only API key is enough: https://dashboard.uptimerobot.com/integrations
# For `astro dev` these live in .dev.vars (see .dev.vars.example); for
# production set them in Cloudflare Pages → Settings → Environment variables.
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_API_URL=https://api.uptimerobot.com/v2/
# Days of history to request (1-180, default 90). The page's 30/90 switch
# slices this one snapshot client-side, so it does not multiply API calls.
STATUS_COUNT_DAYS=90
# Publish each monitor's URL on the page (default 1)
STATUS_SHOW_LINKS=1
# Zone the day columns are cut in (default Asia/Shanghai)
STATUS_TIME_ZONE=Asia/Shanghai
# Seconds the derived snapshot stays fresh at the edge (default 300)
STATUS_CACHE_TTL=300
